Q.last_time_updated = Q.time;
if (Q.week) Q.last_week_updated = Q.week;
!}
on-display: {!
window.deckDescription = '山札――山札をクリックしてカードを引く。';
window.handDescription = '手札――カードをクリックして使用する。';
window.pinnedCardsDescription = '固定カード――カードをクリックして使用する。';
const japanesePersonNames = {
    'Hindenburg': 'ヒンデンブルク', 'Braun': 'ブラウン', 'Marx': 'マルクス',
    'Schumacher': 'シューマッハー', 'Wels': 'ヴェルス', 'Grzesinski': 'グジェジンスキ',
    'Juchacz': 'ユーハチ', 'Rosenfeld': 'ローゼンフェルト', 'Thälmann': 'テールマン',
    'Münzenberg': 'ミュンツェンベルク', 'Hitler': 'ヒトラー', 'Göring': 'ゲーリング',
    'Frick': 'フリック', 'Eckener': 'エッケナー', 'Gessler': 'ゲスラー',
    'Heuss': 'ホイス', 'Luther': 'ルター', 'Jarres': 'ヤレス',
    'Adenauer': 'アデナウアー', 'Brüning': 'ブリューニング', 'Stegerwald': 'シュテーガーヴァルト',
    'Westarp': 'ヴェスタルプ', 'Lettow-Vorbeck': 'レットウ＝フォルベック', 'Seldte': 'ゼルテ',
    'Hergt': 'ヘルクト', 'Seeckt': 'ゼークト', 'Hammerstein': 'ハンマーシュタイン',
    'Mann': 'マン', 'Ossietzky': 'オシエツキー', 'Einstein': 'アインシュタイン',
    'Papen': 'パーペン', 'Schleicher': 'シュライヒャー', 'Goerdeler': 'ゲルデラー',
    'Bredow': 'ブレドウ', 'Treviranus': 'トレヴィラヌス', 'Strasser': 'シュトラッサー'
};
document.querySelectorAll('#qualities span').forEach(function (element) {
    const translatedName = japanesePersonNames[element.textContent.trim()];
    if (translatedName) element.textContent = translatedName;
});
if (!document.getElementById('news_tab')) {
    var button = document.createElement('button');
    button.style.backgroundColor = '#dddddd';
    button.className = 'tab_button';
    button.id = 'news_tab';
    button.textContent = '右翼ニュースを見る';
    button.onclick = function () {
        toggleNews();
    };
    var contentDiv = document.getElementById('content');
    contentDiv.appendChild(button);
    const elements = document.querySelectorAll('.dnvp');
    let hasTextContent = false;
    elements.forEach(function (element) {
        if (element.textContent.trim() !== '') {
            hasTextContent = true;
        }
    });
    if (hasTextContent) {
        button.style.backgroundColor = 'rgba(255, 0, 0, 0.5)'; // New color
    } else {
        button.style.backgroundColor = '#dddddd'; // Original color
    }
    document.querySelectorAll('p').forEach(p => {
        if (!p.textContent.trim()) {
            p.remove();
        }
    });
}

const scrollableBox = document.querySelector('div.scrollable-box');

if (scrollableBox && !document.getElementById('ok') && Q.stimulation) {
  const video = document.createElement('video');
  video.id = 'ok';
  video.autoplay = true;
  video.muted = true;
  video.loop = true;
  video.style.width = '100%';

  const source = document.createElement('source');
  source.src = 'img/lol.mp4';
  source.type = 'video/mp4';

  video.appendChild(source);

  const randomStart = Math.random() * 3198;
  video.currentTime = randomStart;

  scrollableBox.parentNode.insertBefore(video, scrollableBox);
}

const boxes = document.querySelectorAll('.scrollable-box');
if (boxes.length >= 2) {
    boxes[1].remove();
}
!}
max-cards: 4

#ここにメインデッキが表示される。デッキをクリックするとカードを手札に引き、カードをクリックするとそのカードを使用する。

{!<div class="scrollable-box">!}

{!<p class="both">!}[? if year = 1928 and month = 1: ドイツ民主主義にとって明るい時代だ。闘争の期間を経て、インフレはようやく制御下にあり、経済は着実に拡大している。外交面では、西側諸国と<span style="color: #750e0e;">ソビエト連邦</span>との間で合意に達し、真の平和が現実のものとなる可能性がある。<br><br> 今、<span style="color: #c00000;">社会民主主義</span>の課題は、次の選挙の準備だ。ウィルヘルム・マルクスの<span style="color: #000000;">ブルジョワ</span>―<span style="color: #3E88B3;">右派</span>政権は不人気であり、我々は利益を得る立場にある。次の政府は<span style="color: #c00000;">社会主義</span>多数派になるかもしれない。?]{!</p>!}

{!<p class="both">!}[? if year = 1928 and month = 2 : 現行の<span style="color: #000000;">ブルジョワ</span>―<span style="color: #3E88B3;">右派</span>政権は崩壊した。次の選挙は今年の5月に予定されている。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1928 and month = 3 : <span style="color: #b8996f;">中産階級帝国党</span>のような特殊利益政党—一般に<span style="color: #b8996f;">経済党</span>（<span style="color: #b8996f;">**WP**</span>）と呼ばれる—や<span style="color: #7FCEB1;">キリスト教国家農民党</span>（<span style="color: #7FCEB1;">**CNBLP**</span>）は、既存の政党が彼らの利益を無視しているという認識から、国会でかなりの足場を築くと予想される。これは、前政府の一員であった<span style="color: #3E88B3;">**DNVP**</span>に悪影響を及ぼしている。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 4 : <span style="color: #C0A054;">人民党</span>（<span style="color: #C0A054;">**DVP**</span>）の右翼産業勢力が、党指導者で外務大臣のグスタフ・シュトレーゼマンが党内の問題をおろそかにしたため、党内でかなりの影響力を得ている。<span style="color: #C0A054;">**DVP**</span>との大連立の見通しは、特にシュトレーゼマンの健康状態の悪化に伴い、ますます困難になっている。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 4 : 隣国の<span style="color: #002654;">フランス</span>は議会選挙を行い、<span style="color: #FFC0C0;">左派カルテル</span>の敗北と、右翼内閣の継続という結果になった。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 5 : <span style="color: #C8102E;">イギリス</span>の女性の投票年齢が30歳から21歳に引き下げられた。また一つ、また一つだ。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1928 and month = 6 : 前回選挙での不振を受け、<span style="color: #3E88B3;">**DNVP**</span>内部で一連の派閥争いが起きている。党の有力な「<span style="color: #6D5298;">キリスト教社会</span>」派のメンバーであるヴァルター・ランバッハが、その結果を王制復古論が非現実的であることに起因すると批判し、党が保守的な<span style="color: #000000;">共</span><span style="color: #DD0000;">和</span><span style="color: #FFCC00;">派</span>に開かれるべきだと主張している。[? if in_right_coalition or in_right_coalition_prussia : さらに、彼らが根本的に反対する体制下での政権参加が、党内の急進右派の要素との亀裂を生んでいる。?] [? if pro_republic >= 65 or ((pro_republic >= 57 and in_right_coalition and in_right_coalition_prussia) or (pro_republic >= 59 and in_right_coalition) or (pro_republic >= 62 and in_right_coalition_prussia)): 彼の物議を醸す見解は、驚くことに党内で一定の支持を得ている。?] アルフレッド・フーゲンベルクと党右派の同盟者たちは、今月の党大会で党を掌握するため、ランバッハに対する王党派の怒りを利用しようとしている。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 6 : 自由党派の支持率の低迷は、指導部にドイツにはもはや二つの自由党派を維持する贅沢はないと確信させた。しかし、合併の見通しは、左派の<span style="color: #D3C24D;">**[+ ddp_name +]**</span>と右派の<span style="color: #C0A054;">**DVP**</span>によって阻止されており、彼らは自らの利益を妥協することに強く反対している。それにもかかわらず、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>と<span style="color: #C0A054;">**DVP**</span>の間の議会グループの結成はありそうだ。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1928 and month = 7 : <span style="color: #3E88B3;">**DNVP**</span>の穏健な指導者であるクノ・フォン・ヴェスタープは、フーゲンベルクとその同盟者たちとの対立を受け、党首を辞任した。ヴェスタープは、ランバッハの見解に反対しつつも、多くの王党派の激怒を招きながらも、党の左派からの起こりうる離脱を防ぐために彼を党から追放しなかった。[? if pro_republic < 65 and not ((pro_republic >= 57 and in_right_coalition and in_right_coalition_prussia) and not (pro_republic >= 59 and in_right_coalition) and not (pro_republic >= 62 and in_right_coalition_prussia)): これを受け、ヴェスタープは会長職を辞任し、ランバッハはフーゲンベルクの同盟者たちからの執拗な攻撃により党から追放される事態となった。?][? if pro_republic >= 65 or ((pro_republic >= 57 and in_right_coalition and in_right_coalition_prussia) or (pro_republic >= 59 and in_right_coalition) or (pro_republic >= 62 and in_right_coalition_prussia)): これを受け、ヴェスタープはフーゲンベルクの同盟者たちからの執拗な攻撃により会長職を辞任したが、ランバッハは<span style="color: #3E88B3;">**DNVP**</span>の左派によって追放を免れた。?] 一方、フーゲンベルクと汎ドイツ同盟の同盟者たちは、地元の党組織内でかなりの支持を集めている。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 7 and (liberal_vote >= 12.5 and peoples_party_support < 2) or (in_right_coalition or in_weimar_coalition) and next_election_time - time >= 3: シュトレーゼマンと、コッホ＝ヴェーザーの下での<span style="color: #D3C24D;">**[+ ddp_name +]**</span>による、両党間の関係強化の努力は、両党の過激派から発せられる強い反対により失敗した。シュトレーゼマンは自党に幻滅し、それを自由な価値観の場ではなく、産業界の利益のための乗り物と見なしている。<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の左派は、合併は労働者階級の利益を考慮に入れなければならないと主張するが、これは産業界の利益から激しく反対されている。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and flavour_5_trigger and flavour_5_trigger_time == time: 前回選挙の結果が、二つの自由党派間の協力を促し、両党からなる議会派閥の結成に至った。これは、自由票の減少に伴い、議会での影響力を増したいという両党の過激派から渋々受け入れられている。<br><br>新しい自由協会が両党からの資金援助を得て勢いを増しており、州および地方支部を開設し、政策綱領を起草することが期待されている。これは新しい自由党の設立の前触れのように見えるが、両党がこれに同意するかは定かではない。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and n_elections == 1 and next_election_time - time = 2: 前回選挙直後の新選挙を求める我々の呼びかけは、自由党派をさらなる衰退に直面しないよう、より接近させた。新しい自由協会が出現し、両党の努力を調整しており、新しい自由党の設立の前触れのように見えるが、両党が完全に同意するかは定かではない。<br><br>自由派議会派閥の考えは両党からかなりの支持を得ており、選挙後には単一のブロックとして交渉する可能性が高い。?]{!</p>!}

{!<p class="other">!}[? if lvp_merger_timer == 4: 自由統一への探求は進展し、自由協会の影響力が、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>と<span style="color: #C0A054;">**DVP**</span>の支部において地方レベルで増大している。自由の牙城であるバーデン＝ヴュルテンベルクでは、全国指導部からの正式な承認なしに、すでに両党間の合併が進んでいる。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 8 : ヴィルヘルム・マルクス、[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]の指導者、元首相、および大統領候補は、前回の選挙での党の不振を受け辞任した。新しい指導者は今月12月に選出される予定だ。<br><br> <span style="color: #750e0e;">ソビエト連邦</span>は、自国を急速に工業化するための初の「五カ年計画」を発表した。<br><br> アムステルダムの夏季オリンピックで2位に入賞した！?] {!</p>!}

{!<p class="dnvp">!}[? if year = 1928 and month = 8 and pro_republic_7 < 65 and not (pro_republic_7 >= 57 and in_right_coalition and in_right_coalition_prussia) and not ((pro_republic_7 >= 59 and in_right_coalition) and not (pro_republic_7 >= 62 and in_right_coalition_prussia)): ランバッハは、キリスト教労働運動やホワイトカラー組織からの圧力により、<span style="color: #3E88B3;">**DNVP**</span>およびその国会代表団に復帰した。[? if in_right_coalition or in_right_coalition_prussia = 1:<br><br>フーゲンベルクが党内での影響力を高めようとする試みは、彼が現在の[? if in_right_coalition_prussia and in_right_coalition:プロイセンおよび連邦の?][? if in_right_coalition_prussia and not in_right_coalition:プロイセン?][? if in_right_coalition and not in_right_coalition_prussia:連邦?]連立を崩壊させた場合、議会多数派にとって唯一実行可能な代替案は我々が率いる政府になるという現実によって複雑化している。?] ?]{!</p>!}

{!<p class="other">!}[? if lvp_merger_timer == 3: シュトレーゼマンや、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>のコッホ＝ヴェーザーを含む高官たちが、過去数週間にわたり、両党の合併の可能性について非公式な会合を開いている。一方、多くのリベラルな青年組織が、統一の中道党を育成するという目的で、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>と<span style="color: #C0A054;">**DVP**</span>の協力を促進するために設立された。?]{!</p>!}

{!<p class="both">!}[? if year = 1928 and month = 9 : 最近の選挙で<span style="color: #7A3C00;">**NSDAP**</span>が不振に終わった後、プロイセンにおけるアドルフ・ヒトラーの公の場での演説禁止令が解除された。?] {!</p>!}

{!<p class="both">!}[? if year = 1928 and month = 9 and spd_in_government = 0 : ブルジョワ政府は、ドイツの再軍備の一環として、新型戦巡洋艦の建造を承認した。我々は、戦艦ではなく子供のための食料を主張する野党として、ある程度の支持を得た。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 9 : カトリック労働組合会長[? if prussia_leader == "Stegerwald":で、プロイセン州首相でもある?]アダム・シュテーガーヴァルトは、ヴィルヘルム・マルクスの後継を争う最有力候補である。特定利益集団に依存するのではなく、宗派を超えた幅広い「人民ブロック」を提唱しているが、我が党との協力には懐疑的である。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 9 : <span style="color: #3E88B3;">**DNVP**</span>の選挙での敗北により、<span style="color: #3E88B3;">**鉄兜団**</span>内では反<span style="color: #000000;">共</span><span style="color: #DD0000;">和</span><span style="color: #FFCC00;">制</span>感情が高まった。ブランデンブルク支部の指導者は「フュルステンヴァルデ憎悪宣言」を発表し、現体制に対する妥協なき憎悪と、<span style="color: #000000;">共</span><span style="color: #DD0000;">和</span><span style="color: #FFCC00;">制</span>との闘争の開始を宣言した。これを受け、シュトレーゼマンは選挙で選ばれた<span style="color: #C0A054;">**DVP**</span>の公職者全員に対し、この退役軍人組織での役職を辞任するよう命じた。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 9 : アルバニア大統領は、同国を立憲君主制と宣言し、自らをゾグ1世として戴冠した。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 9 : <span style="color: #D70926;">スウェーデン社会民主党</span>は、最近の総選挙で敗北した。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1928 and month = 9 : ウェスタープが再選を辞退したことで、<span style="color: #3E88B3;">**DNVP**</span>内の穏健な反フーゲンベルク派は候補者を失った。フーゲンベルク自身も党首職において曖昧な態度を示しており、一種の三頭政治に関心を示している。?]{!</p>!}

{!<p class="other">!}[? if lvp_merger_timer == 2: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>の左翼、両党の合併に断固として反対する勢力は、党から追いやられるか、統一への道を開けるために脇に追いやられている。しかし、<span style="color: #C0A054;">**DVP**</span>の右翼は党と交渉において大きな影響力を持っており、シュトレーゼマンはこの問題を解決するために緊急党大会を招集するよう求める。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 10 and in_grand_coalition and (foreign_minister_party = "DVP" or foreign_minister_party = "LVP") and lvp_timer_trigger == 0: シュトレーゼマンは、労働組合出身のオットー・ティールが主導する<span style="color: #C0A054;">**DVP**</span>の大規模な内部改革を計画している。彼は、社会のあらゆる層を引きつけるために党を拡大するという点で、ランバッハと強い類似点を示す。しかし、シュトレーゼマンの健康状態は悪化しており、彼の外交政策の仕事が、党の右派が連立を崩壊させる可能性よりも優先されている。その間、彼らは力をつけ続けるだろう。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 10 and not in_grand_coalition or not (foreign_minister_party = "DVP" or foreign_minister_party = "LVP") and lvp_timer_trigger == 0: シュトレーゼマンは、労働組合出身のオットー・ティールが主導する<span style="color: #C0A054;">**DVP**</span>の大規模な内部改革を計画している。彼は、社会のあらゆる層を引きつけるために党を拡大するという点で、ランバッハと強い類似点を示す。シュトレーゼマンの健康状態は悪化しているものの、彼はついに党の内部問題に焦点を当て始めた。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 10 : フーゴー・エッケナーが飛行船の初の大陸間飛行を成功させた！<i>グラーフ・ツェッペリン</i>はドイツを出発し、ニュージャージーに上陸し、これまでに記録された最長ノンストップ飛行を達成し、空中で111時間以上飛んだ。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 11 and not prussia_leader == "Stegerwald": シュテーガーヴァルトは、[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]の指導権争いにおいて強い立場にあるものの、労働との繋がりや公務員の昇給案への反対から、党の中産階級から大きな抵抗に直面している。12月に党大会の新しい候補者が現れた。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 11 and prussia_leader == "Stegerwald": シュテーガーヴァルトの[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]の指導権争いにおける立場は、労働との繋がりや公務員の昇給案への反対から、党の中産階級からの大きな抵抗により衰退している。12月に党大会の新しい候補者が現れ、三つ巴の争いとなっている。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 11 and not (in_grand_coalition == 0 or ((in_grand_coalition == 1 and in_grand_coalition_prussia == 1 and coalition_dissent < 1 and (foreign_minister_party = "DVP" or foreign_minister_party = "LVP")) or (in_grand_coalition == 1 and in_grand_coalition_prussia == 1 and coalition_dissent < 2 and (foreign_minister_party != "DVP" and foreign_minister_party != "LVP")))) and not lvp_formed and lvp_timer_trigger == 0: シュトレマンは、プロイセン政府を巻き込んだ紛争を受け、我々の政府が崩壊するリスクを冒さないために、<span style="color: #C0A054;">**DVP**</span>の右派と対決するという計画を延期した。[? if z_party_name != "CVP": <span style="color: #000000;">中央</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]政党だ。これは安定にとって良い知らせだが、<span style="color: #C0A054;">**DVP**</span>の右翼は後々我々にさらなる問題を抱えさせるだろう。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 11 and (in_grand_coalition == 0 or ((in_grand_coalition == 1 and in_grand_coalition_prussia == 1 and coalition_dissent < 1 and (foreign_minister_party = "DVP" or foreign_minister_party = "LVP")) or (in_grand_coalition == 1 and in_grand_coalition_prussia == 1 and coalition_dissent < 2 and (foreign_minister_party != "DVP" and foreign_minister_party != "LVP")))) and not lvp_formed and lvp_timer_trigger == 0: シュトレーゼマンとその左翼の同盟者たちが<span style="color: #C0A054;">**DVP**</span> 党の中間層や労働者層に発言権を与えるための内部改革を議論するため、党大会を招集した。言うまでもなく、右翼の産業資本家たちはこの計画に激しく反対し、次回の党大会で騒ぎを起こすだろう。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 11 : ハーバート・フーヴァーは、<span style="color: #E81B23;">共和党</span>の候補として、<span style="color: #00AEF3;">民主党</span>のアル・スミスを破り、<span style="color: #B31942;">アメリカ</span><span style="color: #0A3161;">合衆国</span>大統領選挙で地滑り的勝利を収めた。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 11 : <i>蒸気船ウィリー</i>という名前の漫画がリリースされ、音声をフィーチャーした初の試みとなった。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 12 and (in_center_right_coalition or in_right_coalition) and not lvp_formed and lvp_timer_trigger == 0: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>が与党連立に加わったことで、最近右に傾いた二つの自由主義政党間の協力が増した。彼らは国会で<span style="color: #C0A054;">**DVP**</span>と共通の議会派閥を形成し、党指導者たちはさらなる協力の取り組みについて協議している。?]{!</p>!}

{!<p class="other">!}[? if year = 1928 and month = 12 : <span style="color: #000099;">**KMT**</span>の中国国民党が中国を再統一し、軍閥時代に終止符を打った。しかし、日本は依然としてこの地域における帝国主義的な勢力である。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 1 and z_leader == "Stegerwald": [? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]でのシュテーガーヴァルトの委員長選出は、党の中産階級およびカトリック系有権者からの大規模な離脱を引き起こした。かつて停滞していた党は、もはや共通の信仰の結束力によってまとめられているのではなく、<span class="tooltip-text" title="good mod">ダイナミック</span>な勢力へと変貌している。シュテーガーヴァルトは、教会間の友好的な関係を築くというビジョンを推し進め、[? if dnvp_ideology == "Moderate":カトリック以外の州に支部を開設する<span style="color: #3E88B3;">**DNVP**</span>?][? if dnvp_ideology == "Radical":開かれた?]でプロテスタントの労働指導者と友好的な関係を築いているが、この過程は長く困難なものとなるだろう。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 1 and reichswehr_minister_party != "SPD": 国防省は、内閣、国会、様々な政党、そしておそらく最も重要な大統領府と、国防軍が対応するための戦略を調整し実施する責任を持つ、省務室という新しい役職を創設した。最近昇進したクルト・フォン・シュライヒャー将軍が、ヴィルヘルム・グローナーによってこの役職に任命された。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 1: レオン・トロツキーは、<span style="color: #750e0e;">ソビエト連邦</span>で、<span style="color: #8B0000;">スターリン</span>との権力闘争に敗れた後、追放された。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 1: ユーゴスラヴィア国王アレクサンダル1世は、国内の政治的混乱を口実に<span style="color: #808080;">王政独裁</span>を樹立した。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 1: 書籍<i>西部戦線異状なし</i>が物議を醸してリリースされた。この小説は、世界大戦におけるドイツ兵の経験を描いており、彼らが愛国心やナショナリズムの思想に徐々に幻滅していく様子を描いている。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 3 and lvp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>の元労働指導者や左翼分子、さらにはオットー・ティールのような一部の<span style="color: #C0A054;">**DVP**</span>の左翼分子でさえ、「社会共和主義サークル」を設立した。この派閥は、党の綱領を現在の産階級中心の焦点から、労働者の利益も主張する方向へシフトさせることを目指している。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 3 and not lvp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、ブルジョワ政党全体にヴァイマル体制への悲観論と幻滅の雰囲気が広がり、その左翼や労働部門のメンバーを<span style="color: #c00000;">社会主義者</span>へと流出させ続けている。かつてヴァイマル民主主義の最も強力な擁護者の一人であったが、今や着実に無関係化し、ナショナリズムへと沈んでいく。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 4: デンマークの<span style="color: #C82518;">社会民主党</span>が、最近の<i>国民議会</i>選挙で勝利し、<span style="color: #733280;">社会自由党</span>と連立を組んだ。トーバルド・スタウニングが首相に復帰し、広範な福祉国家を推進し続けるだろう。我々も着想を得られるのではないか？?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1929 and month = 5 and in_right_coalition = 0 or in_center_right_coalition = 0 :<span style="color: #3E88B3;">**DNVP**</span>と多数の右翼組織が、住民投票の実施を準備してきた。[? if dnvp_ideology == "Radical":&nbsp;は、フーゲンベルクの祝福を得て?] <span style="color: #000000;">ヴァ</span><span style="color: #DD0000;">イマ</span><span style="color: #FFCC00;">ル</span> 憲法を、大統領が国会の同意なしに首相を指名できるようにし、国会で反逆罪で告発された議員の免責を解除させることで改正すること。この住民投票の範囲は限定的だが、右派にとっての集結点を作り出すことを意図している[? if dnf_formed = 1:&nbsp;、フーゲンベルクの不参加にもかかわらず?]. [? if dnf_formed = 1:代わりに、フーゲンベルクと<span style="color: #003755;">**DNF**</span>は、外交政策に関する住民投票の開始を計画しているが、署名数のしきい値に達する可能性は低い。?] ?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 5 and not lvp_formed: 多くの青年グループが、産業界の利益に対抗し、ブルジョワ政党の合併を主張するために、<span style="color: #C0A054;">**DVP**</span>を中心に結成されている。これは、[? if z_party_name != "CVP": <span style="color: #000000;">中央</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]に対抗するためだ。シュトレーゼマンはまた、ここ数ヶ月にわたり、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>のコッホ＝ヴェーザーと秘密裏の会談を行っている。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 5 and lvp_formed: <span style="color: #FFCC00;">**LVP**</span>は、その旗の下で中産階級の若者を結集させることに成功し、複数の青年グループが「若き自由主義者」に合流した。この青年派は、より広範な党よりも目立って左派であり、<span style="color: #FFCC00;">**LVP**</span>をより進歩的な見通しへと導く政策を推進するだろう。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 5 : 英国総選挙は<span style="color: #f0456a;">労働党</span>に圧勝をもたらし、100議席以上を獲得した。それにもかかわらず、過半数には届かず、<span style="color: #FFD700;">自由党</span>を決定的な存在とする少数与党で政権を担うことになる。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 5 :<span style="color: #D70926;">ベルギー労働党</span>が最近の総選挙で最多得票を得たが、現職の<span style="color: #FFD700;">カトリック</span>-<span style="color: #3C40D2;">自由主義</span>連合は続いている。?]{!</p>!}

{!<p class="both">!}[? if year = 1929 and month = 6 : 外相[+ foreign_minister +]がパリで数か月にわたり審議を重ねた末、連合国はヤング計画として知られる一連の提案を策定した。これは賠償支払額を減らし、ドイツに一層大きな財政上の自主権を認めるものだ。<span style="color: #002654;">フランス</span>もまた、1930年6月にラインラントから早期撤兵することへ同意した。[? if in_right_coalition = 1 or in_center_right_coalition = 1: ヤング計画をめぐる交渉は、計画に反対して賠償を「国家的奴隷状態」の一形態だと主張する<span style="color: #3E88B3;">**DNVP**</span>との間に、連立を揺るがす大きな対立を生んでいる。この連立は長くは続かないだろう。?][? if in_right_coalition = 0 and in_center_right_coalition = 0: これは国にとって前向きな進展に見えるが、右派はこの計画に強く反対運動を展開している[? if kpd_leader == "Thälmann":。何らかの理由で、<span style="color: #700000;">**KPD**</span>も同様である?]。?] ?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 6: バチカン市国は、ベニート・ムッソリーニと聖座との合意により設立され、世界で最も新しい国となった。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1929 and month = 6 and dnvp_ideology = "Radical" : <span style="color: #7A3C00;">**NSDAP**</span>が国民投票に反対したため、フーゲンベルクは<span style="color: #000000;">ヴァ</span><span style="color: #DD0000;">イマ</span><span style="color: #FFCC00;">ル</span>憲法改正を目的とする国民投票計画を中止し、多くの[? if dnvp_leader == "Hugenberg": <span style="color: #3E88B3;">**DNVP**</span>党員を失望させた。?][? if dnvp_leader == "Triumvirate": ヴェスタープを含む多くの党員を失望させた。?] ヤング案に反対する国民投票運動が始まり、<span style="color: #3E88B3;">**DNVP**</span>が[? if not lvp_formed: <span style="color: #C0A054;">**DVP**</span>?][? if lvp_formed: <span style="color: #FFCC00;">**LVP**</span>?]や<span style="color: #A2D8E0;">**BVP**</span>との関係改善で得た成果は放棄された。 ?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1929 and month = 7 and dnvp_ideology = "Radical" : <span style="color: #7A3C00;">**NSDAP**</span>は、右翼によるヒトラーの<span style="color: #7A3C00;">**NSDAP**</span>の歴史的扱いに対抗する形で、ヤング計画に反対する住民投票の計画において重要な役割を与えられている。ヒュゲンベルクは、一見小さな党を「国民戦線」に留めるために譲歩をすることで特に友好的であった。この取り組みに対する目立った産業界の支援の欠如が、ヒュゲンベルクに多額の私的資金を使うことを強いている。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1929 and month = 7 and dnf_formed = 1 and not was_in_center_right_coalition : <span style="color: #003755;">**DNF**</span> は、<span style="color: #7A3C00;">**NSDAP**</span> と密接に連携し、ヤング計画に対する住民投票を組織している。<span style="color: #3E88B3;">**DNVP**</span> は、統一右派のための住民投票で <span style="color: #003755;">**DNF**</span> と協力するか、それとも <span style="color: #000000;">ヴァ</span><span style="color: #DD0000;">イマ</span><span style="color: #FFCC00;">ル</span> 憲法に関する独自の計画された住民投票を投じるかという内部闘争にある。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1929 and month = 7 and dnf_formed = 1 and was_in_center_right_coalition : <span style="color: #003755;">**DNF**</span>は、<span style="color: #7A3C00;">**NSDAP**</span>と密接に連携して、ヤング計画に反対する住民投票を組織している。<span style="color: #3E88B3;">**DNVP**</span>は、統一右翼のための住民投票で<span style="color: #003755;">**DNF**</span>と協力するか、それともブルジョワ政党との関係を維持するかという内部闘争にある。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1929 and month = 8 and dnf_formed = 1 and was_in_center_right_coalition and pro_republic < 70: <span style="color: #7A3C00;">**NSDAP**</span>は、右翼によるヒトラーの<span style="color: #7A3C00;">**NSDAP**</span>の歴史的扱いに対抗する形で、ヤング計画に反対する住民投票の計画において重要な役割を与えられている。これには、ヒンデンブルク大統領を含む署名責任者の投獄を求める条項の組み込みが含まれる。これにより、<span style="color: #3E88B3;">**DNVP**</span>を自らのイニシアチブを支持させるために、その条項が削除された。なぜなら、彼らの支持がなければ、屈辱的な敗北に過ぎないからだ。<span style="color: #3E88B3;">**DNVP**</span>内部の不満は、ヒュゲンベルクとナチとの協力という決定により高まっている。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1929 and month = 8 and dnf_formed = 1 and was_in_center_right_coalition and pro_republic >= 70 : <span style="color: #7A3C00;">**NSDAP**</span>は、右派によるヒトラーの<span style="color: #7A3C00;">**NSDAP**</span>に対する歴史的扱いへの対抗策として、ヤング案反対の住民投票計画において重要な役割を与えられている。これには、ヒンデンブルク大統領を含む署名責任者の投獄を求める段落の組み込みが含まれる。この段落が削除されたとしても、<span style="color: #3E88B3;">**DNVP**</span>は、<span style="color: #7A3C00;">極</span><span style="color: #003755;">右</span>と共同で住民投票を支持するというコミットメントをまだしていない。<span style="color: #3E88B3;">**DNVP**</span>内部の不満は、「国家奴隷制」に反対して右派と協力しないという決定によって高まっている。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1929 and month = 8 and dnf_formed = 1 and pro_republic >= 70 and not was_in_center_right_coalition : <span style="color: #7A3C00;">**NSDAP**</span>は、右翼によるヒトラーの<span style="color: #7A3C00;">**NSDAP**</span>の歴史的扱いに対抗する形で、ヤング計画に反対する住民投票の計画において重要な役割を与えられている。これには、ヒンデンブルク大統領を含む署名責任者の投獄を求める条項の組み込みが含まれる。条項が削除されたにもかかわらず、<span style="color: #3E88B3;">**DNVP**</span>は独自の住民投票を強行している。右翼と「国家奴隷制」に反対して協力しないという決定により、<span style="color: #3E88B3;">**DNVP**</span>内部の不満が高まっている。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 8 and stolper_program_adopted and not lvp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>は党大会を開催し、著名な経済学者グスタフ・シュトルパーが党の社会的・経済的焦点を産業労働者階級から苦境にある中産階級の支援へと再定義した「シュトルパー計画」を発表した以外に目立ったことはなかった。党の左派や労働組合からの反対にもかかわらず、これは彼らの公式経済プログラムとなり、草の根層やドイツの中産階級の間で新たな熱狂を巻き起こした。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 8 and not stolper_program_adopted and not lvp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>は党大会を開催し、著名な経済学者グスタフ・シュトルパーが党の社会的・経済的焦点を産業労働者階級から苦境にある中産階級の支援へと再定義した「シュトルパー計画」を発表した以外に目立ったことはなかった。しかし、党の左派からの反対により、草の根層からの大きな熱狂にもかかわらず、この計画は静かに棚上げされた。?]{!</p>!}

{!<p class="other">!}[? if lvp_merger_1_timer == 4: シュトレーゼマンの<span style="color: #D3C24D;">**[+ ddp_name +]**</span>との秘密交渉は実を結び、両党は政策面で合意に達した。最近採択されたシュトルパー計画と、産業部門を牽制しつつ<span style="color: #C0A054;">**DVP**</span>を真の人民党へと変貌させたことは、両自由党間のより大きな協力への道を大きく容易にした。今後数ヶ月間にわたり、より大規模な交渉が続くだろう。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 8 : ヒューゴ・エッケナーが飛行船で世界一周を成し遂げた！この旅は、同じ発着地点から出発し、約21日間で33,234キロメートルを移動した。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1929 and month = 8 and dnf_formed = 1 and pro_republic < 70 and not was_in_center_right_coalition: <span style="color: #7A3C00;">**NSDAP**</span>は、右翼によるヒトラーの<span style="color: #7A3C00;">**NSDAP**</span>の歴史的扱いに対抗する形で、ヤング計画に反対する住民投票の計画において重要な役割を与えられている。これには、ヒンデンブルク大統領を含む署名責任者の投獄を求める条項の組み込みが含まれる。これにより、<span style="color: #3E88B3;">**DNVP**</span>を自らのイニシアチブを支持させるために、その条項が削除された。なぜなら、彼らの支持がなければ、屈辱的な敗北に過ぎないからだ。<span style="color: #3E88B3;">**DNVP**</span>内部の不満は、以前の計画を放棄するという決定により高まっている。?]{!</p>!}

{!<p class="both">!}[? if year = 1929 and month = 9 and dnf_formed = 1 and pro_republic_8 >= 70 and not was_in_center_right_coalition and not lvp_formed: <span style="color: #3E88B3;">**DNVP**</span> は、<span style="color: #C0A054;">**DVP**</span> と <span style="color: #A2D8E0;">**BVP**</span> のブルジョワ政党の支持を得て、<span style="color: #000000;">ヴァ</span><span style="color: #DD0000;">イマ</span><span style="color: #FFCC00;">ル</span> 憲法改革のための住民投票を支持している。 [? if dvp_relation >= 40 and dvp_ideology_9 != "Right" : しかし、彼らとの友好的な関係が、彼らが我々に敵対することを抑えている。 ?] <span style="color: #7A3C00;">極</span><span style="color: #003755;">右</span> 政党は独自の住民投票に固執しており、関与しないだろう。 ?]{!</p>!}

{!<p class="both">!}[? if year = 1929 and month = 9 and dnf_formed = 1 and pro_republic_8 >= 70 and not was_in_center_right_coalition and lvp_formed: <span style="color: #3E88B3;">**DNVP**</span>は、ブルジョワ諸党、右派の<span style="color: #FFCC00;">**LVP**</span>、そして[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]から、<span style="color: #000000;">ヴァ</span><span style="color: #DD0000;">イマ</span><span style="color: #FFCC00;">ル</span>憲法改正国民投票への支持を得られなかった。支持に同意したのは<span style="color: #A2D8E0;">**BVP**</span>だけである。<span style="color: #7A3C00;">極</span><span style="color: #003755;">右</span>諸党は独自の国民投票を進めており、これには加わらない。 ?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1929 and month = 9 and dnvp_leader = "Hugenberg": 「自由法」の最終段落、すなわち住民投票の議題には、非常に物議を醸す「投獄」条項が含まれており、ヤング・プランに署名した責任者、ひいては大統領ヒンデンブルクでさえ、高電圧罪で起訴され投獄されることを要求している。これは<span style="color: #3E88B3;">**DNVP**</span>と<span style="color: #3E88B3;">**鉄兜団**</span>内で大きな不満を引き起こしたが、いつものように融通の利かないフーゲンベルクは、<span style="color: #7A3C00;">**NSDAP**</span>がこの条項の維持を条件に支持したため、これを維持することに固執している。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1929 and month = 9 and dnvp_leader = "Triumvirate": 「自由法」の最終段落、すなわち住民投票の議題には、非常に物議を醸す「投獄」条項が含まれており、ヤング・プランに署名した責任者、ひいては大統領ヒンデンブルクでさえ、高電圧罪で起訴され投獄されることを要求している。いつものように融通の利かないフーゲンベルクは、<span style="color: #7A3C00;">**NSDAP**</span>がこの条項の維持を条件に支持したため、これを維持することに固執している。この条項は明らかにフーゲンベルクに対する大きな批判を巻き起こし、ヴェスタープは抗議して与党の三頭政治から辞任した。?]{!</p>!}

{!<p class="both">!}[? if year = 1929 and month = 9 and spd_in_government and not lvp_formed: <span style="color: #C0A054;">**DVP**</span>の右派は、我々の政府に失望を表明し、ヤング・プランの条件を満たすための大規模な財政改革を要求している。これには、失業が上昇し続けるため破綻寸前の失業保険制度の削減が含まれる。<span style="color: #C0A054;">**DVP**</span>は、雇用主の拠出金増額よりも給付金の削減を主張し、シュトレスマーンは党内で妥協点を見つけることがますます困難になっている。?]{!</p>!}

{!<p class="other">!}[? if lvp_merger_1_timer == 3: この後退にもかかわらず、<span style="color: #C0A054;">**DVP**</span>の党構造改革は、彼らの産業資本家たちの要求をはるかに脅威の少ないものにした。[? if not stresemann_dead:シュトレスマーン?][? if stresemann_dead:、キュルティウス?]、そして<span style="color: #D3C24D;">**[+ ddp_name +]**</span>のコッホ＝ヴェーザーを含む他の高官たちは、統一を促進するために、それぞれの党から最も急進的なメンバーを除去することに合意した。一方、以前は衰退していた自由協会は、様々な青年グループと協力し、政策綱領の起草と地方支部を結成し始めた。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 9: ダウ工業平均株価は381.17ドルでピークを迎え、黄金の20年代は続く！?]{!</p>!}

{!<p class="both">!}[? if year = 1929 and month = 10: ヤング案に対する発議は、住民投票となるための署名収集を終えた。有権者の[+ young_plan_signatures +]%が署名し、[? if young_plan_signatures >= 10 : [? if young_plan_signatures < 11 : &nbsp;はかろうじて?] 10%の最低要件を超えた。一方、?][? if young_plan_signatures < 10 : [? if young_plan_signatures > 9 :&nbsp;はかろうじて?] 10%の最低要件に満たなかった。これは右派政党内に確かにいくつかの議論を巻き起こすだろう。?] ?]{!</p>!}

{!<p class="both">!}[? if year = 1929 and month = 10 and pro_republic_8 >= 70 and not was_in_center_right_coalition and dnf_formed = 1: 憲法改正の住民投票の署名収集が完了し、有権者の[+ weimar_ref_signatures +]%の署名を集めた。住民投票は年末に実施される予定で、有権者の50%が賛成票を投じる必要がある。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 10 and not lvp_formed: 小さな民族主義の準軍事組織であるヤング・ジャーマン・オーダーは、新たな政治組織<i>人民国家帝国協会</i>（<span style="color: #D3D3A9;">**VNR**</span>）を設立し、「偉大な国家再生の党」が形成する結晶点となることを目指している。コッホ＝ヴェーザーやエルンスト・レマーのような幻滅した<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の政治家たちは、この新党と協力し、ドイツの中産階級を新たな「国家党」に統合することに関心を示している。しかし、これは<span style="color: #C0A054;">**DVP**</span>と<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の合併に関する進行中の、あるいは将来の議論を複雑にしている。?]{!</p>!}

{!<p class="other">!}[? if lvp_merger_1_timer == 2: シュトレーゼマンの早すぎる死により、<span style="color: #FFCC00;">統一自由党</span>をめぐる協議は複雑化した。オットー・ティールやユリウス・クルティウスら<span style="color: #C0A054;">**DVP**</span>左派の盟友は協議を続けられるが、シュトレーゼマンを失ったことで右派が強大化し、最終的に統一を阻む可能性がある。それでも自由主義の牙城バーデン＝ヴュルテンベルクでは、全国指導部の正式な承認がないまま両党の合併がすでに進んでいる。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 10: <span style="color: #f0456a;">労働党</span>がオーストラリアで政権を握った。?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 10 : <span style="color: #D70926;">チェコスロバキア社会民主党</span>が最近の総選挙で最も多くの票を獲得し、より改革派の<span style="color: #FAC469;">チェコスロバキア（国民）社会主義党</span>もそれに続いた。<span style="color: #A00500;">共産党</span>や他の右派政党は後退を経験した。?]{!</p>!}

{!<p class="other">!}[? if lvp_merger_1_timer == 1 and vnr_formed: <span style="color: #FFCC00;">統一自由党</span>への反対は、<span style="color: #C0A054;">**DVP**</span>の右派に留まらない。コッホ＝ヴェーザー自身を含む<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の全派閥の多くの政治家が、<span style="color: #D3D3A9;">**VNR**</span>との代替的な合併に関心を示している。[? if lvp_trigger_2_time == time + 1:しかし、コッホ＝ヴェーザーと党のビジネス部門は、党内の懐疑論者たちを信用失墜させ、統一を進めるだろう。?] ?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 11 and z_leader == "Stegerwald" and dnvp_ideology == "Radical": [? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]はシュテーガーヴァルトのもと、最近の改革によって、本来なら特殊利益政党を支持したはずの不満を抱く多数の<span style="color: #3E88B3;">**DNVP**</span>有権者・党員を[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]へ引き寄せている。どうやら[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]が右派の政党となり、<span style="color: #3E88B3;">**DNVP**</span>に取って代わるようだ。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1929 and month = 12 : オーストリアの憲法は、大統領に議会を解散する権限を含む権限を付与し、国民による直接大統領選挙を導入するよう改正された。これにより、オーストリアは我々のものと大差ない半大統領制の政府へと変貌した。この改正は、より権威主義的で中央集権的な政府を求める<span style="color: #000000;">キリスト教社会党</span>との妥協の結果であり、彼らは改正を可決するために<span style="color: #C8102E;">オーストリア社会民主党</span>の承認を必要とした。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1929 and month = 12 and csvd_formed = 1 and stegerwald_path = 0: <span style="color: #6D5298;">キリスト教社会派</span>は<span style="color: #3E88B3;">**DNVP**</span>内の派閥であったが、CVDと合同して独自の政党、<span style="color: #8ED8E4;">キリスト教社会人民奉仕党</span>（<span style="color: #8ED8E4;">**CSVD**</span>）を結成した。主な支持基盤はプロテスタント労働者で、ほかのブルジョワ政党との協力を拒んでいる。意外にも<span style="color: #7A3C00;">ナチ</span>には強硬で、その「キリスト教に反する過度な<span style="color: #005EB8;">ユダヤ人</span>憎悪」を非難している。 ?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1929 and month = 12 and dnvp_historical_1929: の <span style="color: #3E88B3;">**DNVP**</span> 分離主義者たちは、<span style="color: #7FCEB1;">キリスト教国家農民・農民党</span>（<span style="color: #7FCEB1;">**CNBLP**</span>）と手を組み、国会にキリスト教国家連合という新たな議会派閥を設立した。この協力は、反フーゲンベルク右派の団結に向けた一歩を示唆しているように見えるが、<span style="color: #7FCEB1;">**CNBLP**</span> は、この同盟は単に両グループの議会上の弱さによって動機づけられた一時的な措置にすぎないと主張している。右派の反対勢力のさらなる統一に対する主な障壁は、各党が独自のイデオロギー的および職業的アイデンティティを維持するという決意である。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1930 and month = 1 and dnvp_historical_1929 and not (other_votes < 11 or peoples_party or weimar_coalition >= 50 or pro_republic < 40): 数ヶ月前に<span style="color: #3E88B3;">**DNVP**</span>から分裂した「若き保守派」派閥は、正式に「人民保守協会」を設立した。これは、他の<span style="color: #3E88B3;">**DNVP**</span>の不満分子たちとの悲惨な会合に続き、保守勢力の緩やかな連合さえ形成できなかったためである。この協会はまだ正式な政党ではないが、次期選挙で共同リストを提出することを期待して、<span style="color: #8ED8E4;">CSVD</span>と<span style="color: #7FCEB1;">**CNBLP**</span>を単一のブロックに統合することを目指している。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1930 and month = 1 and dnvp_historical_1929 and (peoples_party or weimar_coalition >= 50 or stegerwald_path or (z_leader == "Joos" and dvp_reform)): 数か月前に<span style="color: #3E88B3;">**DNVP**</span>から分裂した「青年保守派」は、正式に<span style="color: #0087DC;">保守人民党</span>（<span style="color: #0087DC;">**KVP**</span>）を結成した。最大の後援者の一人は、ヒンデンブルク大統領の側近で軍人でもあるクルト・フォン・シュライヒャー将軍である。彼らがシュライヒャーから資金を受け入れた理由は、 [? if stegerwald_path and z_leader == "Stegerwald": 独立への懸念があるにもかかわらず、ドイツ産業からの条件付きの支援が途絶えたためだ。?][? if (z_leader == "Joos" and dvp_reform) or z_leader == "Kaiser": 独立への懸念があるにもかかわらず、ドイツ産業からの条件付きの支援が途絶えたためだ。?][? if (weimar_coalition >= 50 or peoples_party) and not stegerwald_path and not (z_leader == "Joos" and dvp_reform): 独立への懸念があるにもかかわらず、我々の人気に対抗したいという切迫感からだ。?] その資金は無視するには大きすぎた。他の<span style="color: #3E88B3;">**DNVP**</span>の分裂グループ間の内部の異論を沈黙させ、保守勢力を単一の勢力にまとめ上げた。?]{!</p>!}

{!<p class="both">!}[? if flavour_4_trigger and flavour_4_trigger_time == time: ヒンデンブルク大統領は、現在の<span style="color: #c00000;">社会主義</span>政府に幻滅しており、我々の参加なしに、同盟パートナーのいずれかとの秘密交渉を通じて別の政府を見つけようとしているという噂がある。もし危機が発生すれば、それは間違いなく我々を政府から解任するための口実として使われるだろう。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 1 and pro_republic < 65 and ddp_ideology != "Left" and z_ideology == "Right" and not lvp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>が、他のブルジョワ政党と共に、地方レベルで我々との連立を捨て、代わりに<i>市民ブロック</i>を形成する傾向が強まっている。自由主義政党は、ヴュルテンベルク州で[? if z_party_name != "CVP": <span style="color: #000000;">中央</span>?][? if z_party_name == "CVP":の<span style="color: #000000;">**CVP**</span>?]-<span style="color: #3E88B3;">**DNVP**</span>連立に参加した。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 1 : スペインの独裁者ミゲル・プリモ・デ・リベラが辞任した。スペイン国民は、特に経済不況の発生後、独裁政権にうんざりした。アルフォンソ13世国王は後任の独裁者を任命したが、この脆い王国では共和派が人々の間でかなりの支持を得ている。?]{!</p>!}

{!<p class="both">!}[? if year = 1930 and month = 2: かつてブラウンの州首相への任命を妨害したことで知られるカトリック保守派のフランツ・フォン・パーペンが、カースとブリューニングによって空いた州議会の議席に選出された。党の右翼に位置するパーペンは、前回の選挙でヨーゼフ・ヘスと[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]の左派から議席を拒否されたにもかかわらず、引退から復帰した。控えめに言っても、これは共和国を通じての[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]との長年の協力にとって良い兆候ではない。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 2 and dvp_leader = "Scholz" and in_grand_coalition and not lvp_formed: <span style="color: #C0A054;">**DVP**</span>は、我々との協力と我々の政府連立の将来に関する重要な問題を議論するために党大会を開いた。大会の間、彼らは大連立を声高に支持し、ショルツは態度を変え、ブルジョワ政党との協力に対する以前の反対を撤回した。我々は彼らの発言の真実性を疑う。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 2 and dvp_leader != "Scholz" and in_grand_coalition and not lvp_formed: <span style="color: #C0A054;">**DVP**</span>は、我々との協力と我々の政府連立の将来に関する重要な問題を議論するために党大会を開いた。大会の間、彼らは大連立を声高に支持し、特にブルジョワ政党間の協力促進に焦点を当ててきた。もしかすると、<span style="color: #C0A054;">**DVP**</span>がついに正気に戻ったのかもしれない。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 2 and dvp_leader = "Scholz" and not in_grand_coalition and not lvp_formed: <span style="color: #C0A054;">**DVP**</span>は、我々との協力の将来とブルジョワ統一の問題に関する重要な問題を議論するために党大会を開いた。大会の間、彼らは我々との将来の連立を排除した。しかし、ショルツはハンス・ルーターと彼らの産業資本家たちの圧力の結果、ブルジョワ政党との協力に対する以前の反対を撤回した。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 2 and dvp_leader != "Scholz" and not in_grand_coalition and not lvp_formed: <span style="color: #C0A054;">**DVP**</span>は、我々との協力の将来とブルジョワ統一の問題に関する重要な問題を議論するために党大会を開いた。大会の間、彼らは特にブルジョワ政党間の協力促進に焦点を当て、我々との良好な関係を再確認した。?]{!</p>!}

{!<p class="both">!}[? if year = 1930 and month = 3 and dvp_leader != "Luther" and lvp_leader != "Luther": ライヒ銀行総裁のヒャルマール・シャヒトが職を辞した。元首相であり<span style="color: #C0A054;">**DVP**</span>のメンバーであるハンス・ルーターがその職を与えられた。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 3 and not lvp_formed:ますます多くの<span style="color: #D3C24D;">**[+ ddp_name +]**</span>左翼が、その平和主義的で<span style="color: #c00000;">社会主義者</span>のイメージを脱ぎ捨て、裕福な実業家支援層をなだめ、ますます右派化するドイツ有権者にアピールするという名目のもとで、党から周縁化されるか追いやられている。かつて<span style="color: #D3C24D;">**[+ ddp_name +]**</span>左派の長老であったアントン・エルケルンツは、その左派的な見解がますます場違いになったため、昨年遅く退陣を余儀なくされた。<span style="color: #D3C24D;">[+ ddp_name +]</span>に残った左翼勢力は、現在「社会共和主義サークル」として構成され、党の右傾化に概ね同調している。それにもかかわらず、彼らは依然として<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の財界部門が克服すべき障害となっている。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1930 and month = 4 and csvd_formed = 1 and stegerwald_path = 0:の<span style="color: #8ED8E4;">**CSVD**</span>の初会が開催され、党指導部は自由主義と個人主義を非難し、反フーゲンベルクの右派による協調を「ドイツ労働者階級の犠牲の上に既存の階級線を硬化させる以上の陰謀に過ぎない」と非難した。さらに、彼らは他の特殊利益団体を「ドイツの政治生活の構造を腐敗させ、キリスト教信仰の精神に敵対する唯物論的エゴイズムの現れ」だと考えている。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 6 and dnvp_ideology == "Radical" and not lvp_formed: ブリューニング内閣の結成は、主要なブルジョワ政党の閣僚からなるものであり、[? if dvp_leader == "Scholz": ショルツにとって、1930年の党大会で表明されたブルジョワ統一の誓いを実行する独自の機会となった?][? if dvp_leader != "Scholz": ブリューニングの下で様々なブルジョワ政党を団結させる主導権を握る<span style="color: #C0A054;">**DVP**</span>。?] 交渉は、<span style="color: #C0A054;">**DVP**</span>によって開始され、<span style="color: #D3C24D;"> から [+ ddp_name +] **</span>**、そして<span style="color: #3E88B3;">**DNVP**</span>の元左翼の政党を含んでいる。現在の主な焦点は、将来の選挙における選挙休戦の可能性である。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 6 and dnvp_ideology == "Moderate" and not lvp_formed: 主要ブルジョワ諸党の閣僚からなるブリューニング内閣の成立は、[? if dvp_leader == "Scholz": ショルツにとって、1930年党大会で掲げたブルジョワ統一の誓約を実行する?][? if dvp_leader != "Scholz": <span style="color: #C0A054;">**DVP**</span>にとって、ブリューニングのもとでブルジョワ諸党の統一を主導する?]絶好の機会となった。<span style="color: #C0A054;">**DVP**</span>が始めた協議には、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>から衰退する右翼の職能政党までが参加している。現在の主題は、将来の選挙に備えた選挙休戦の可能性である。 ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 6 and dnvp_ideology == "Radical" and lvp_formed:のブリューニング内閣の樹立は、主要なブルジョワ政党の閣僚からなるものであり、小規模なブルジョワ政党がブリューニングの背後で統一を追求する独自の機会を提供した。穏健な右派と職業政党を統一しようと、[+ lvp_leader +]が<span style="color: #FFCC00;">**LVP**</span>から協議を開始した。主な焦点は現在、将来の選挙における選挙休戦の可能性にある。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 6 and dnvp_ideology == "Moderate" and lvp_formed:のブリューニング内閣の樹立は、主要なブルジョワ政党の閣僚からなるものであり、小規模なブルジョワ政党がブリューニングの背後で統一を追求する独自の機会を提供した。穏健な右派と職業政党がブリューニングを支持する中で、[+ lvp_leader +]が<span style="color: #FFCC00;">**LVP**</span>から協議を開始した。主な焦点は現在、将来の選挙における選挙休戦の可能性にある。?]{!</p>!}

{!<p class="both">!}[? if bruning_event_timer = 5 and dnvp_ideology == "Radical" and not kvp_formed:ブリューニング首相は、不人気な消費税増税を含むドイツ財政の抜本的な改革を導入し、これを農業救済と結びつけた。これは明らかに、さもなければ否決されていたであろう新たな税の課税を確保するための策略である。フーゲンベルクは党にこの法案に反対するよう命じたが、ヴェスタープとその穏健派グループはこれに従わず、ブリューニング政権を支持し続けている。?]{!</p>!}

{!<p class="both">!}[? if bruning_event_timer = 5 and dnvp_ideology == "Radical" and kvp_formed:ブリューニング首相は、不人気な消費税増税を含むドイツ財政の抜本的な改革を導入し、これを農業救済と結びつけた。これは明らかに、さもなければ否決されていたであろう新たな税の課税を確保するための策略である。フーゲンベルクは党にこの法案に反対するよう命じ、右派連合による過半数の望みを潰した。?]{!</p>!}

{!<p class="other">!}[? if bruning_event_timer = 5 and ddp_ideology != "Right" and not lvp_formed: <span style="color: #D3C24D;">の左翼である[+ ddp_name +]**</span>**は、ブリューニング内閣に入る決定について協議されなかったため、不信任投票の際には支持を留保すると脅す。しかし、ヘルマン・ディートリッヒの党員の間での人気と影響力が最終的に国会代表団を説得し、彼の内閣の地位を支持させ、不信任投票でブリューニングを支持させた。?]{!</p>!}

{!<p class="dnvp">!}[? if bruning_event_timer = 5 and dnvp_ideology == "Radical" and young_plan_signatures >= 10 and dnvp_bruning: <span style="color: #7A3C00;">**NSDAP**</span>は、フーゲンベルクの右派連合がヤング・プランの国民投票に反対するキャンペーンのために結成されたが、フーゲンベルクが新しいブリューニング内閣を支持すると決めたため、国民投票委員会から撤退した。ヒトラーは和解する用意があり、フーゲンベルクにブリューニングから離脱するための14日間を与えたが、<span style="color: #7A3C00;">**NSDAP**</span>の左翼の指導者グレゴール・シュトラッサーは、党規を破り、いずれにせよ参加を撤回した。これはヒトラーを苛立たせた。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 5 and (dvp_leader == "Scholz" or dvp_leader == "Dingeldey") and bourgeois_negotiations_election_soon and not lvp_formed: ブルジョワ政党間の公式協議は、ブリューニングの政策を支持する共同宣言と選挙休戦をもたらした。公式協議は現在、ブリューニング政権を支持する提案された議会連合へと移行した。[+ dvp_leader +]の主な目的は、国会における反<span style="color: #c00000;">社会主義</span>勢力を強化し、ブリューニング内閣の経済政策に決定的な影響を及ぼすことである。予想通り、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、<span style="color: #c00000;">**SPD**</span>との協力を拒まない唯一の政党であり、この提案に対して強い抵抗を示した。[? if dstp_formed:さらに、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の設立と、そこが<span style="color: #C0A054;">**DVP**</span>のメンバーを誘い出そうとしたことは、両党の関係を著しく悪化させた。?] ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 5 and (dvp_leader != "Scholz" and dvp_leader != "Dingeldey") and bourgeois_negotiations_election_soon and not lvp_formed: ブルジョワ諸党の正式協議は、ブリューニングの政策を支持する共同声明と選挙休戦をもたらした。協議は今や、ブリューニング政権を支える議会連合の構想へ移っている。その狙いは、国会における反<span style="color: #c00000;">社会主義</span>勢力を強化し、ブリューニング内閣の経済政策に決定的な影響力を及ぼすことにある。しかし交渉では、<span style="color: #C0A054;">**DVP**</span>、とりわけ<span style="color: #D3C24D;">**[+ ddp_name +]**</span>が、<span style="color: #c00000;">**SPD**</span>との協力に全面反対していない唯一の政党であり、我々への姿勢をめぐって<span style="color: #b8996f;">**WP**</span>および<span style="color: #7FCEB1;">**CNBLP**</span>と衝突した。 [? if dstp_formed: しかし、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の結成と、彼らが<span style="color: #C0A054;">**DVP**</span>のメンバーを引き抜こうとする試みは、両党の関係を著しく悪化させ、さもなければ有望であった交渉を頓挫させた。 ?] ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 5 and bourgeois_negotiations_election_soon and lvp_formed: ブルジョワ政党間の公式協議は、ブリューニングの政策を支持する共同宣言と選挙休戦をもたらした。公式協議は現在、ブリューニング政権を支持する提案された議会連合へと移行した。右派の主な目的は、国会における反<span style="color: #c00000;">社会主義</span>勢力を強化し、ブリューニング内閣の経済政策に影響を及ぼすことである。予想通り、<span style="color: #FFCC00;">**LVP**</span>は、<span style="color: #c00000;">**SPD**</span>との協力を完全に拒まない唯一の政党であり、この提案に対して強い抵抗を示し、この議会連合に含まれないかもしれない。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 5 and (dvp_leader == "Scholz" or dvp_leader == "Dingeldey") and not bourgeois_negotiations_election_soon and not lvp_formed: ブルジョワ政党間の公式協議は、選挙戦略からブリューニング政権を支持する提案された議会連合へと移行した。[+ dvp_leader +]の主な目的は、国会における反<span style="color: #c00000;">社会主義</span>勢力を強化し、ブリューニング内閣の経済政策に決定的な影響を及ぼすことである。予想通り、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、<span style="color: #c00000;">**SPD**</span>との協力を拒まない唯一の政党であり、この提案に対して強い抵抗を示した。[? if dstp_formed:さらに、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の設立と、そこが<span style="color: #C0A054;">**DVP**</span>のメンバーを誘い出そうとしたことは、両党の関係を著しく悪化させた。?] ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 5 and (dvp_leader != "Scholz" and dvp_leader != "Dingeldey") and not bourgeois_negotiations_election_soon and not lvp_formed: ブルジョワ諸党の正式協議は、選挙戦略からブリューニング政権を支える議会連合の構想へ移った。その狙いは、国会における反<span style="color: #c00000;">社会主義</span>勢力を強化し、ブリューニング内閣の経済政策に決定的な影響力を及ぼすことにある。しかし交渉では、<span style="color: #C0A054;">**DVP**</span>、とりわけ<span style="color: #D3C24D;">**[+ ddp_name +]**</span>が、<span style="color: #c00000;">**SPD**</span>との協力に全面反対していない唯一の政党であり、我々への姿勢をめぐって<span style="color: #b8996f;">**WP**</span>および<span style="color: #7FCEB1;">**CNBLP**</span>と衝突した。 [? if dstp_formed: しかし、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の結成と、彼らが<span style="color: #C0A054;">**DVP**</span>のメンバーを引き抜こうとする試みは、両党の関係を著しく悪化させ、さもなければ有望であった交渉を頓挫させた。 ?] ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 5 and not bourgeois_negotiations_election_soon and lvp_formed: ブルジョワ政党間の公式協議は、選挙戦略からブリューニング政権を支持する提案された議会連合へと移行した。右派の主な目的は、国会における反<span style="color: #c00000;">社会主義</span>勢力を強化し、ブリューニング内閣の経済政策に影響を及ぼすことである。予想通り、<span style="color: #FFCC00;">**LVP**</span>は、<span style="color: #c00000;">**SPD**</span>との協力を完全に拒まない唯一の政党であり、この提案に対して強い抵抗を示し、この議会連合に含まれないかもしれない。?]{!</p>!}

{!<p class="other">!}[? if bruning_event_timer = 4 and in_weimar_coalition_prussia or in_social_catholic_coalition_prussia or in_grand_coalition_prussia or in_popular_front_prussia: ブリューニングは、プロイセンの[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]も解散するよう圧力をかけている。幸いなことに、我々のオットー・ブラウンとプロイセンの[? if z_party_name != "CVP": <span style="color: #000000;">中央</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]'の指導者ジョゼフ・ヘスは、ブリューニングの要求に抵抗するほどの影響力を持っている。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 4 and (dvp_leader == "Scholz" or dvp_leader == "Dingeldey") and bourgeois_negotiations_election_soon and not lvp_formed and not dstp_formed: [+ dvp_leader +]と他のブルジョワ政党の指導者たちは、議会連立の形成に関する<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の曖昧な態度にうんざりし、決定的な答えを出すよう最後に圧力をかけた。党指導部とコッホ＝ヴェーザー自身は、議会統治の存続を確実にするために「何か」をしなければならないと考えているが、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>内の社会共和派や他の左派からの扇動が、彼らが新しく包括的なブルジョワの中間政党の創設を完全に支持することを困難にしている。それにもかかわらず、選挙が近づくにつれて、交渉が崩壊しているという体裁を避けるための<span style="color: #D3C24D;">**[+ ddp_name +]**</span>内の絶望感が、彼らを粘着させる原動力となっている。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 4 and (dvp_leader != "Scholz" and dvp_leader != "Dingeldey") and bourgeois_negotiations_election_soon and not lvp_formed and not dstp_formed: 提案された議会連立が<span style="color: #c00000;">**SPD**</span>と協力する姿勢、およびそれが掲げる実際の政策について行き詰まりが生じている。自由党指導部とコッホ＝ヴェーザー自身は、議会統治の存続を確実にするために「何か」をしなければならないと考えているが、両党の左派からの扇動が、彼らが新しく包括的なブルジョワの中間政党の創設を完全に支持することを不可能にしている。それにもかかわらず、選挙が近づくにつれて、交渉が崩壊しているという体裁を避けるための<span style="color: #D3C24D;">**[+ ddp_name +]**</span>内の絶望感が、彼らを粘着させる原動力となっている。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 4 and bourgeois_negotiations_election_soon and lvp_formed: <span style="color: #FFCC00;">**LVP**</span>はブルジョワ諸党の議会同盟に向けた交渉から撤退し、合意を目指すのは、政治的に<span style="color: #FFCC00;">**LVP**</span>と<span style="color: #3E88B3;">**DNVP**</span>の間に位置する諸党となった。来る選挙に向け、結束している体裁だけでも整えたいブルジョワ諸党の切迫感と裕福な支援者の後押しを受け、<span style="color: #7FCEB1;">**CNBLP**</span>と<span style="color: #b8996f;">**WP**</span>は議会会派を統合することができた。そこには<span style="color: #007A00;">ドイツ農民党</span>などの小政党[? if dnvp_ideology == "Radical":や、さらに[? if not kvp_formed:<span style="color: #3E88B3;">**DNVP**</span>からの離党勢力?][? if kvp_formed:<span style="color: #0087DC;">**KVP**</span>?]?]も加わった。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 4 and not lvp_formed and dstp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>が関わる合意が見込めないため、彼らは交渉から撤退し、以前の行動により他のブルジョワ政党から敵意を向けられている。それにもかかわらず、[+ dvp_leader +]と残りのブルジョワ政党は、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>なしで交渉を継続しようとしている。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 4 and (dvp_leader == "Scholz" or dvp_leader == "Dingeldey") and (ddp_ideology != "Right" or ddp_ideology == "Right" and ddp_relation >= 45) and not lvp_formed and not dstp_formed: [+ dvp_leader +]と他のブルジョワ政党の指導者たちは、議会連立の形成に関する<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の曖昧な態度にうんざりし、決定的な答えを出すよう最後に圧力をかけた。党指導部とコッホ＝ヴェーザー自身は、議会統治の存続を確実にするために「何か」をしなければならないと考えているが、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>内の社会共和派や他の左派からの扇動が、彼らが新しく包括的なブルジョワの中間政党の創設を完全に支持することを不可能にしている。その結果、妥協案が採択され、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の社会共和的な性格が維持されることが強調され、交渉はさらに複雑化した。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 4 and (dvp_leader == "Scholz" or dvp_leader == "Dingeldey") and ddp_ideology == "Right" and ddp_relation < 45 and not bourgeois_negotiations_election_soon and not lvp_formed and not dstp_formed: [+ dvp_leader +]と他のブルジョワ政党の指導者たちは、議会連立の形成に関する<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の曖昧な態度にうんざりし、決定的な答えを出すよう最後に圧力をかけた。党指導部とコッホ＝ヴェーザー自身は、議会統治の存続を確実にするために「何か」をしなければならないと考えているが、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>内の社会共和派や他の左派からの扇動が、彼らが新しく包括的なブルジョワの中間政党の創設を完全に支持することを困難にしている。それにもかかわらず、コッホ＝ヴェーザーと<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の右派は、提案を推し進め、交渉を継続する。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 4 and (dvp_leader != "Scholz" and dvp_leader != "Dingeldey") and not bourgeois_negotiations_election_soon and not lvp_formed and not dstp_formed: 提案された議会連立が<span style="color: #c00000;">**SPD**</span>と協力する姿勢、およびそれが掲げる実際の政策について行き詰まりが生じている。自由党指導部とコッホ＝ヴェーザー自身は、議会統治の存続を確実にするために「何か」をしなければならないと考えているが、両党の左派からの扇動が、彼らが新しく包括的なブルジョワの中間政党の創設を完全に支持することを不可能にしている。<span style="color: #D3C24D;">**[+ ddp_name +]**</span>では、妥協案が採択され、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の社会共和的な性格が維持されることが強調され、交渉はさらに複雑化した。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 4 and bourgeois_cooperation < 5 and not bourgeois_negotiations_election_soon and lvp_formed: <span style="color: #FFCC00;">**LVP**</span>は、ブルジョワ諸党の議会同盟に関する交渉から撤退した。これにより、いかなる合意も、<span style="color: #FFCC00;">**LVP**</span>と<span style="color: #3E88B3;">**DNVP**</span>の各ブルジョワ諸党の間で行われることになる。自らの専門的およびイデオロギー的アイデンティティを維持したいという強い願望を持つ党が、包括的な合意をすることは考えにくい。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 4 and bourgeois_cooperation >= 5 and not bourgeois_negotiations_election_soon and lvp_formed: <span style="color: #FFCC00;">**LVP**</span>は、ブルジョワ諸党の議会同盟に関する交渉から撤退した。これにより、いかなる合意も、<span style="color: #FFCC00;">**LVP**</span>と<span style="color: #3E88B3;">**DNVP**</span>の各ブルジョワ諸党の間で行われることになる。驚くべきことに、<span style="color: #7FCEB1;">**CNBLP**</span>と<span style="color: #b8996f;">**WP**</span>は、<span style="color: #007A00;">ドイツ農民党</span>[? if dnvp_ideology == "Radical":&nbsp;や、さらには[? if not kvp_formed:から分派した<span style="color: #3E88B3;">**DNVP**</span>?][? if kvp_formed:の<span style="color: #0087DC;">**KVP**</span>?]?]の分派者たちを加えて、議会グループを統合することができた。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 3 and bourgeois_parliament_trigger and not lvp_formed: ブルジョワ諸党間の交渉はついに突破口を開いた。産業資本家のさらなる奨励がなければ、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>、<span style="color: #C0A054;">**DVP**</span>、<span style="color: #b8996f;">**WP**</span>、そして<span style="color: #7FCEB1;">**CNBLP**</span>からなる議会同盟を結びつけることはできなかった。これに<span style="color: #007A00;">ドイツ農民党</span>[? if dnvp_ideology == "Radical":&nbsp;、さらには[? if not kvp_formed:から分派した<span style="color: #3E88B3;">**DNVP**</span>?][? if kvp_formed:の<span style="color: #0087DC;">**KVP**</span>?]?]が加わった。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 3 and bourgeois_parliament_trigger_1 and not lvp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、先月の出来事を受けて交渉から排除された。その後、ブルジョワ諸党はついに突破口を開いた。産業資本家のさらなる奨励がなければ、<span style="color: #C0A054;">**DVP**</span>、<span style="color: #b8996f;">**WP**</span>、そして<span style="color: #7FCEB1;">**CNBLP**</span>からなる議会同盟を結びつけることはできなかった。これに<span style="color: #007A00;">ドイツ農民党</span>[? if dnvp_ideology == "Radical":&nbsp;、さらには[? if not kvp_formed:から分派した<span style="color: #3E88B3;">**DNVP**</span>?][? if kvp_formed:の<span style="color: #0087DC;">**KVP**</span>?]の分派者たちまで加わった。?] ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 3 and bourgeois_parliament_trigger_2 and not lvp_formed: ブルジョワ諸党間の交渉は決着した。<span style="color: #D3C24D;">**[+ ddp_name +]**</span>と<span style="color: #C0A054;">**DVP**</span>が、他のブルジョワ諸党との同盟よりも、自分たちだけで議会同盟を結ぶことを選択した。これはブルジョワ統一にとって前進ではあるが、非<span style="color: #3E88B3;">**DNVP**</span>右派とのさらなる協力を閉ざすものである。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 3 and bourgeois_parliament_trigger_3 and not lvp_formed: ブルジョワ諸党間の交渉は決着した。自由主義党が合意に達するために大きな譲歩をした。主要な産業資本家から提供された条件付き資金によるさらなる奨励が、議会グループの創設を可能にしたが、次の選挙後に参加した党がそれを更新する可能性は低い。議会グループは、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>、<span style="color: #C0A054;">**DVP**</span>、<span style="color: #b8996f;">**WP**</span>、そして<span style="color: #7FCEB1;">**CNBLP**</span>から構成される。これに<span style="color: #007A00;">ドイツ農民党</span>[? if dnvp_ideology == "Radical":&nbsp;、さらには[? if not kvp_formed:から分派した<span style="color: #3E88B3;">**DNVP**</span>?][? if kvp_formed:の<span style="color: #0087DC;">**KVP**</span>?]の分派者たちまで加わった。?] ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 3 and bourgeois_parliament_trigger_4 and not lvp_formed: [+ dvp_leader +]は、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>を除いたブルジョワ諸党からなる議会同盟を無事に結成した。ドイツ産業界の信頼を損なう全体的な混乱にもかかわらず、ブルジョワ統一は、<span style="color: #7FCEB1;">**CNBLP**</span>と<span style="color: #b8996f;">**WP**</span>の旧勢力が乗り越えるには大きすぎた。議会派閥は、<span style="color: #C0A054;">**DVP**</span>、<span style="color: #b8996f;">**WP**</span>、そして<span style="color: #7FCEB1;">**CNBLP**</span>から構成される。これに<span style="color: #007A00;">ドイツ農民党</span>[? if dnvp_ideology == "Radical":&nbsp;、さらには[? if not kvp_formed:<span style="color: #3E88B3;">**DNVP**</span>からの分派?][? if kvp_formed:<span style="color: #0087DC;">**KVP**</span>?]まで?]が加わった。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 3 and bourgeois_parliament_trigger_event and kvp_formed: ブルジョワ議会派グループへの<span style="color: #0087DC;">**KVP**</span>の組み入れは、独自のアイデンティティを維持したいと考えている党内で論争を巻き起こした。[? if not schleicher_kvp and bourgeois_cooperation < 5: これにより、党指導部は、まず自党の基盤を固めることに集中する方が良いと主張し、議会派グループに参加するという決定を撤回せざるを得なくなった。?][? if bourgeois_cooperation >= 5 and not schleicher_kvp: それにもかかわらず、ブルジョワ統一の勢いは大きく、この提案が内部で否決されることは難しい。?][? if schleicher_kvp: しかし、シュライヒャーは党内での大きな影響力を用いて、この提案を強行させた。?]?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 2 and bourgeois_parliament and not bourgeois_parliament_trigger_event and kvp_formed: ブルジョワ議会派グループへの<span style="color: #0087DC;">**KVP**</span>の組み入れは、独自のアイデンティティを維持したいと考えている党内で論争を巻き起こした。[? if not schleicher_kvp and bourgeois_cooperation < 8: これにより、党指導部は、まず自党の基盤を固めることに集中する方が良いと主張し、議会派グループに参加するという決定を撤回せざるを得なくなった。?][? if bourgeois_cooperation >= 8 and not schleicher_kvp: それにもかかわらず、ブルジョワ統一の勢いは大きく、この提案が内部で否決されることは難しい。?][? if schleicher_kvp: しかし、シュライヒャーは党内での大きな影響力を用いて、この提案を強行させた。?]?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 3 and bourgeois_negotiations_fail and not lvp_formed: ブルジョワ諸党間の交渉はついに結論に達し、議会同盟は<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の懐疑論者と<span style="color: #7FCEB1;">**CNBLP**</span>によって破綻した。主要な資金提供者がより緊密な協力関係を継続的な支援の条件としたにもかかわらず、ブルジョワ協力は単なる夢物語に過ぎないようだ。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 3 and bourgeois_negotiations_fail_dstp and not lvp_formed: ブルジョワ諸党間の交渉はついに結論に達し、議会同盟は主に<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の不安定な行動によって破綻し、これは右翼の全ての政党を疎外した。主要な資金提供者がより緊密な協力関係を継続的な支援の条件としたにもかかわらず、ブルジョワ協力は単なる夢物語に過ぎないようだ。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 3 and bourgeois_negotiations_fail_liberal and not lvp_formed: ブルジョワ政党間の交渉はついに結論を出した。自由党内の懐疑派と、<span style="color: #c00000;">に対する激しい反社会主義</span>が、<span style="color: #7FCEB1;">**CNBLP**</span>および<span style="color: #b8996f;">**WP**</span>において失敗した。主要な資金提供者たちが、より緊密な協力に継続的な支援を条件にしているにもかかわらず、広範なブルジョワの統一は依然として達成不可能であるようだ。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_timer == 3 and bourgeois_negotiations_fail and lvp_formed: ブルジョワ諸党間の交渉はついに結論に達し、議会同盟は<span style="color: #FFCC00;">**LVP**</span>の左派と、<span style="color: #7FCEB1;">**CNBLP**</span>および<span style="color: #b8996f;">**WP**</span>の旧体制派によって破綻した。主要な資金提供者がより緊密な協力関係を継続的な支援の条件としたにもかかわらず、ブルジョワ協力は単なる夢物語に過ぎないようだ。?]{!</p>!}

{!<p class="other">!}[? if lvp_merger_2_timer == 4 and not lvp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>と<span style="color: #C0A054;">**DVP**</span>の和解的な関係、ならびに過去の自由主義的な協力の事例は、<span style="color: #FFCC00;">統一された自由主義政党</span>の可能性を生んだ。[? if dvp_leader == "Scholz" or dvp_leader == "Dingeldey": しかし、<span style="color: #C0A054;">**DVP**</span>の指導部は、潜在的な合併にとって最大の障害となる可能性が高い。?][? if ddp_leader == "Lemmer": <span style="color: #D3C24D;">**[+ ddp_name +]**</span>の指導部は、さらなる協力に対して[? if dvp_leader == "Scholz" or dvp_leader == "Dingeldey":&nbsp;と同様に懐疑的である?]。?] 今後数ヶ月にわたって公式な会談が行われ、熱意を測り、両党が合意する政策基盤を築くことになるだろう。?]{!</p>!}

{!<p class="both">!}[? if bruning_event_timer = 3 and dvp_ideology != "Right" and not lvp_formed: ブリューニング内閣の財務大臣であり、メンバーでもあるパウル・モルデンハウアーは、すべての政府職員の給与に3%の課税を提案した後、厳しい精査にさらされている。 [? if dvp_exist: <span style="color: #C0A054;">**DVP**</span>?][? if not dvp_exist: <span style="color: #3E88B3;">**DNVP**</span>?] その提案は、彼の党の企業部門や公務員部門から大きな反発を招き、その部門は現在、 [? if dvp_exist: <span style="color: #C0A054;">**DVP**</span>?][? if not dvp_exist: <span style="color: #3E88B3;">**DNVP**</span>に大きく依存している。それにもかかわらず、彼はブリューニングの助言に従い、自党の行動を否定し、かなりの論争を巻き起こしている。 ?] 議会での支持に大きく依存している。それにもかかわらず、彼はブリューニングの助言に従い、自党の行動を否定し、かなりの論争を巻き起こした。?]{!</p>!}

{!<p class="both">!}[? if bruning_event_timer = 3 and dvp_ideology == "Right" and not lvp_formed: ブリューニング内閣の財務大臣であり、メンバーでもあるパウル・モルデンハウアーは、すべての政府職員の給与に3%の課税を提案した後、厳しい精査にさらされている。 [? if dvp_exist: <span style="color: #C0A054;">**DVP**</span>?][? if not dvp_exist: <span style="color: #3E88B3;">**DNVP**</span>?] 議員が、全政府職員の給与に3%の課税を提案したことを受け辞任した。この提案は、彼の党の財界および公務員部門から大きな反発を招き、その部門は彼らの選挙支援に大きく依存している。この件は、彼らの政府職員に対する地位を著しく傷つけ、ブリューニング政権への継続的な支持に疑問を投げかけた。 [? if dvp_exist: <span style="color: #C0A054;">**DVP**</span>?][? if not dvp_exist: <span style="color: #3E88B3;">**DNVP**</span>に大きく依存している。それにもかかわらず、彼はブリューニングの助言に従い、自党の行動を否定し、かなりの論争を巻き起こしている。 ?] ?]{!</p>!}

{!<p class="both">!}[? if bruning_event_timer = 3 and lvp_ideology != "Right" and lvp_formed: ブルーニング内閣の財務大臣であり、<span style="color: #FFCC00;">**LVP**</span>のメンバーであるポール・モルデンハウアーは、全政府職員の給与に3%の課税を提案した件で、厳しい精査に直面している。この提案は、同党の企業部門および公務員部門から大きな反発を招き、この部門は<span style="color: #FFCC00;">**LVP**</span>の選挙支援に頼っている。それにもかかわらず、彼はブルーニングの助言に従い、自党の行動を否定し、かなりの論争を巻き起こした。?]{!</p>!}

{!<p class="both">!}[? if bruning_event_timer = 3 and lvp_ideology == "Right" and lvp_formed: ブルーニング内閣の財務大臣であり、<span style="color: #FFCC00;">**LVP**</span>のメンバーであるポール・モルデンハウアーは、全政府職員の給与に3%の課税を提案した件で辞任した。この提案は、同党の企業部門および公務員部門から大きな反発を招き、この部門は<span style="color: #FFCC00;">**LVP**</span>の選挙支援に頼っている。この件は、政府職員からの彼らの地位を著しく傷つけ、彼らを<span style="color: #7A3C00;">**NSDAP**</span>へと向かわせるだろう。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 6: <span style="color: #B31942;">連合</span> <span style="color: #0A3161;">諸国</span> ヘルベルト・フーヴァー大統領がスムート・ホーリー関税法を法律として署名し、関税率を大幅に引き上げ、他国からの報復関税を招いた。この政策が進行中の恐慌を解決するのに役立つとは考えにくく、世界をさらに深く沈めるだけかもしれない。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 6 and not lvp_formed: ザクセン州議会では、自由党への支持が著しく低下している。[? if not lvp_formed and vnr_r_saxony >= 1.4: この選挙はまた、<span style="color: #D3D3A9;">**VNR**</span>が投票用紙に登場した最初の場合であり、投票の[+ vnr_saxony_elections_vote +]%を獲得し、<span style="color: #D3C24D;">[+ ddp_name +]</span>での注目を集めた。?] この結果は、自由派とブルジョワ層の統一に対する絶望感を高め、彼らの得票率の低下に対する解決策とされた。?]{!</p>!}

{!<p class="other">!}[? if lvp_merger_2_timer == 3 and not lvp_formed: <span style="color: #FFCC00;">統一自由党</span>に向けて進展があった。以前は衰退していた「自由協会」が復活し、著名な実業家たちから資金提供を受けている。彼らは、統一自由党が<span style="color: #c00000;">社会主義</span>と勢いづく<span style="color: #7A3C00;">ナチス</span>に対抗するために必要だと見なしている。さらに、自由主義の牙城であるバーデン＝ヴュルテンベルクでは、全国指導部からの正式な承認なしに、両党の合併がすでに進行している。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_0_trigger and flavour_0_trigger_time == time: 地方票が複数の政党に分散したことは、フーゲンベルクが<span style="color: #3E88B3;">**DNVP**</span>を率いた直接的な結果であり、<span style="color: #7A3C00;">**NSDAP**</span>がこの不満を持つ層の支持を集める隙を生んだ。?]{!</p>!}

{!<p class="both">!}[? if flavour_1_trigger and flavour_1_trigger_time == time: アドルフ・ヒトラーの<span style="color: #7A3C00;">**NSDAP**</span>は、選挙を前にして深刻な勢いを増している。彼のカリスマ性には、以前の政治的同情心に関わらず、あらゆる階級の人々を引きつける何かがある。党内では、彼らをブルジョワ右派というよりも真剣な脅威と見なすべきかという議論になっている。?]{!</p>!}

{!<p class="other">!}[? if lvp_merger_2_timer == 2 and not lvp_formed: 穏健派同士の交渉が驚くほど実りある結果を生んだため、<span style="color: #FFCC00;">統一された自由党</span>がますます可能性が高まっている。しかし、この成功にもかかわらず、常に、<span style="color: #C0A054;">**DVP**</span>の右派と<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の左派は、自由党の統一にとって巨大な障害であり続けている。両党の指導者は、この意見の相違を完全に解決するために緊急党大会を招集したが、両党の得票率の低下は、党員を統一へと傾かせる大きな要因であり、少数派の意見が優勢になる可能性は低い。?]{!</p>!}

{!<p class="both">!}[? if year = 1930 and month = 8: ラインラントの最後の<span style="color: #002654;">フランス</span>と<span style="color: #FFD500;">ベルギー</span>軍隊は、ヤング計画に従って撤退した。これは共和国にとって前向きな展開だが、国防軍内の保守エリートやヒンデンブルクの側近たちは、我々の政府制度を<span style="color: #808080;">権威主義的</span>で<span style="color: #7A3C00;">軍国主義的</span>なものに置き換える外部からの制約から解放された。?]

{!<p class="other">!}[? if flavour_7_trigger and flavour_7_trigger_time == time: 長年、かつて影響力を持っていた<span style="color: #D3C24D;">**DDP**</span>の労働指導者アントン・エルケルンツが<span style="color: #c00000;">**SPD**</span>に寝返った！しかし、党内での彼の影響力の限界と、左翼の多くの人々による<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の結成への強い熱意が、より広範な離脱を防いでいる。彼らのプラウトクラシーに対する共通の憎しみが、この合併への支持を煽っているのだろうか？?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_elections_1930_timer == 2 and bourgeois_negotiations_1930_done and (dnvp_split_2 or kvp_formed) and (dvp_leader == "Scholz" or dvp_leader == "Dingeldey") and not liberal_parliament and not lvp_formed: ウェスタープがフーゲンベルクの<span style="color: #3E88B3;">**DNVP**</span>から離脱した後、[+ dvp_leader +]は彼と彼の穏健派グループとのより緊密な関係構築に強い関心を示した。新選挙の招集は、[? if dvp_leader == "Scholz": ショルツ?][? if dvp_leader != "Scholz": <span style="color: #C0A054;">**DVP**</span> ?] 紳士的な統一を交渉するさらなる機会を与えた。しかし、今回は、単に議会グループの形成だけでなく、国家を支持する全勢力の統合を求める、はるかに野心的な試みである。ウェスタープ自身は他の党との合併にさほど関心がないものの、紳士的な統一を達成することを条件とした産業界からの資金提供があるため、参加する用意がある。 ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_aftermath_timer == 2 and not liberal_parliament and not lvp_formed: [? if dnvp_split_2 or kvp_formed: ウェスタープがフーゲンベルクの<span style="color: #3E88B3;">**DNVP**</span>から離脱した後、[+ dvp_leader +]は彼と彼の穏健派グループとのより緊密な関係構築に強い関心を示した。 ?] ブルジョワ諸党による議会会派の結成交渉が実を結び、諸党の統一運動に弾みがついた。主要な実業家からも、体制を支える勢力が何らかの形で結集することを条件に、より多くの資金を得られるようになった。[+ dvp_leader +]は、新たな選挙が行われる場合にブルジョワ諸党が共同候補者名簿を組むよう求め、次の交渉を開始した。 ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_elections_1930_timer == 2 and bourgeois_negotiations_1930_done and (dnvp_split_2 or kvp_formed) and liberal_parliament and not lvp_formed: ウェスタープがヒュゲンベルクの<span style="color: #3E88B3;">**DNVP**</span>から分裂した後、[+ dvp_leader +]は彼と穏健なドイツ右派との協力に関心を示した。新選挙の招集は、<span style="color: #C0A054;">**DVP**</span>に、ブルジョワ統一を交渉するさらなる機会を与えた。しかし、今回は、単なる議会グループの結成ではなく、国家を支持する全勢力の統合を求める、はるかに野心的な試みである。ウェスタープ自身は他の政党と合併することにさほど関心がないが、ブルジョワの統一達成にかかっている条件付きの産業資金のため、参加する意思がある。<span style="color: #C0A054;">**DVP**</span>の裏切りは彼らの心に今も残っており、ドイツ右派の多くの人々は、この試みにおいて[+ dvp_leader +]と協力することに消極的である。?]{!</p>!}

{!<p class="dnvp">!}[? if bourgeois_negotiations_1930_aftermath_timer == 2 and liberal_parliament and not lvp_formed and (dnvp_split_2 or kvp_formed): 自由主義者が議会グループの統合に成功した後、大企業は、議会グループを他のブルジョワ政党に拡大するか、あるいはブルジョワ右派の他の政党に独自の独立した議会派閥を形成するよう奨励するよう、圧力を強めた。現在可能なのは後者のみのようで、自由主義政党と保守右派の間に生じた敵意がそうさせている。[? if (dnvp_split_2 or kvp_formed): <span style="color: #0087DC;">**KVP**</span>?][? if not (dnvp_split_2 or kvp_formed): <span style="color: #0087DC;">人民保守協会</span>?]のトレヴィラヌスによって、<span style="color: #7FCEB1;">**CNBLP**</span>と<span style="color: #b8996f;">**WP**</span>を特徴とする新たな交渉が開始された。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_elections_1930_timer == 2 and bourgeois_negotiations_1930_done and not (dnvp_split_2 or kvp_formed) and (dvp_leader == "Scholz" or dvp_leader == "Dingeldey") and not liberal_parliament and not lvp_formed: 新選挙の招集は、[? if dvp_leader == "Scholz": ショルツ?][? if dvp_leader != "Scholz": <span style="color: #C0A054;">**DVP**</span> ?] ブルジョワジーの団結を交渉するまた一つの機会だ。しかし、今回はずっと野心的な試みだ。単に議会グループを形成するだけでなく、国家を支持する全ての勢力の統合を求めるものだ。前回の交渉の失敗は、各党の口に悪い味を残しており、ドイツ右派の多くの者は、この試みにおいて[+ dvp_leader +]と協力することに消極的だ。 ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_elections_1930_timer == 2 and bourgeois_negotiations_1930_done and not (dnvp_split_2 or kvp_formed) and liberal_parliament and not lvp_formed: 新選挙の招集は、<span style="color: #C0A054;">**DVP**</span>に、ブルジョワ統一を交渉するさらなる機会を与えた。しかし、今回は、単なる議会グループの結成ではなく、国家を支持する全勢力の統合を求める、はるかに野心的な試みである。<span style="color: #C0A054;">**DVP**</span>の裏切りは彼らの心に今も残っており、ドイツ右派の多くの人々は、この試みにおいて[+ dvp_leader +]と協力することに消極的である。?]{!</p>!}

{!<p class="dnvp">!}[? if bourgeois_negotiations_elections_1930_timer == 2 and bourgeois_negotiations_1930_done and (dnvp_split_2 or kvp_formed) and bourgeois_parliament and lvp_formed: ウェスタープがフーゲンベルクの<span style="color: #3E88B3;">**DNVP**</span>から離脱した後、主要な実業家や政治家であるトレヴィラヌスらは、<span style="color: #0087DC;">**KVP**</span>とより右派の政党との関係を深めるようロビー活動を行った。彼らはこの点に関して、その党をブルジョワ議会グループの一員に説得することには成功したが、他の右派政党との統一を検討させることには至っていない。新選挙の呼びかけは、この問題に関する新たな一連の交渉を引き起こした。関与する政党は、<span style="color: #b8996f;">**WP**</span>、<span style="color: #7FCEB1;">**CNBLP**</span>、そして<span style="color: #0087DC;">**KVP**</span>である。?]{!</p>!}

{!<p class="dnvp">!}[? if bourgeois_negotiations_elections_1930_timer == 2 and bourgeois_negotiations_1930_done and (dnvp_split_2 or kvp_formed) and not bourgeois_parliament and lvp_formed: ブルーニングを支持するブルジョワ議会グループの樹立に向けた交渉の失敗を受け、新選挙の呼びかけはブルジョワ統一を交渉する新たな機会を提示した。大企業や実業家たちは、ブルジョワ統一に向けて努力する政党のみに資金を提供するという大きな努力を行い、これにより、しぶらしい<span style="color: #7FCEB1;">**CNBLP**</span>と<span style="color: #b8996f;">**WP**</span>が、<span style="color: #0087DC;">**KVP**</span>と共に交渉の席に着くことになった。?]{!</p>!}

{!<p class="dnvp">!}[? if bourgeois_negotiations_elections_1930_timer == 2 and bourgeois_negotiations_1930_done and csvd_formed and not lvp_formed: <span style="color: #8ED8E4;">**CSVD**</span>の指導部は、自らの候補者名簿で選挙に臨むことに圧倒的に賛成票を投じ、アイデンティティを危うくすることを恐れて、他の政党とのいかなる合意も明確に拒否した。同じ理由から、<span style="color: #7FCEB1;">**CNBLP**</span>と<span style="color: #b8996f;">**WP**</span>もまた、[+ dvp_leader +]による交渉提案を退けた。さらに、[? if liberal_cooperation < 5 and not liberal_parliament:。さらに、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、この提案を、そのような根本的な問題に関する十分な合意を欠いた時期尚早な取り組みだと批判した。?][? if liberal_cooperation >= 5 or liberal_parliament:さらに、<span style="color: #C0A054;">**DVP**</span>がより左派の<span style="color: #D3C24D;">**[+ ddp_name +]**</span>と近接していることは、穏健な右派の層を疎外した。?] ?]{!</p>!}

{!<p class="dnvp">!}[? if bourgeois_negotiations_elections_1930_timer == 2 and bourgeois_negotiations_1930_done and not csvd_formed and dnvp_historical_1929 and lvp_formed: <span style="color: #7FCEB1;">**CNBLP**</span>と<span style="color: #b8996f;">**WP**</span>は、職業政党がよりイデオロギー的な<span style="color: #0087DC;">**KVP**</span>と統合されたことに冷淡な反応を示した。これは、かつての<span style="color: #3E88B3;">**DNVP**</span>のメンバーで、フーゲンベルク以前の<span style="color: #3E88B3;">**DNVP**</span>のような政党を提唱するマルティン・シエレのような人物が、職業政党のしぶらしい旧勢力を説得することが求められている。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_elections_1930_timer == 1 and bourgeois_merger_trigger_scholz and not liberal_parliament: 驚くべきことに、[+ dvp_leader +]は、<span style="color: #c00000;">社会主義</span>への共通の恐れ、過去の協力事例、あるいは裕福な献金者から提供される現金の山によって、ブルジョワ政党をまとめ上げることに成功した。多数のブルジョワ政党が共通の選挙リストに合意した。その結果、[? if kvp_cnblp_sister: <span style="color: #385A38;">**農村同盟**</span>?][? if not kvp_cnblp_sister: <span style="color: #7FCEB1;">**CNBLP**</span>?] と<span style="color: #007A00;">ドイツ農民党</span>の候補者が農村リストで優勢な政党となり、より都市部の[? if kvp_formed or dnvp_split_2: <span style="color: #0087DC;">**KVP**</span>、?] <span style="color: #b8996f;">**WP**</span>[? if bourgeois_list_ddp:、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>?] と<span style="color: #C0A054;">、**DVP**、</span>が都市部の投票用紙で主要な政党となるだろう。全国リストの議席は各党に公平に配分される。これは<span style="color: #7A3C00;">、**NSDAP**、</span>がドイツの中産階級にアピールする能力を著しく損なうだろう。しかし、関与する政党の右派的な傾向は、将来の協力をほぼ不可能にする可能性が高い。 ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_elections_1930_timer == 1 and bourgeois_merger_trigger_moderate and not liberal_parliament: 驚くべきことに、[+ dvp_leader +]は、<span style="color: #c00000;">社会主義</span>への共通の恐れ、過去の協力事例、あるいは裕福な献金者から提供される現金の山によって、ブルジョワ政党をまとめ上げることに成功した。多数のブルジョワ政党が共通の選挙リストに合意した。その結果、[? if kvp_cnblp_sister: <span style="color: #385A38;">**農村同盟**</span>?][? if not kvp_cnblp_sister: <span style="color: #7FCEB1;">**CNBLP**</span>?] と<span style="color: #007A00;">ドイツ農民党</span>の候補者が農村リストで優勢な政党となり、より都市部の[? if kvp_formed or dnvp_split_2: <span style="color: #0087DC;">**KVP**</span>、?] <span style="color: #b8996f;">**WP**</span>[? if bourgeois_list_ddp:、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>?] と<span style="color: #C0A054;">、**DVP**、</span>が都市部の投票用紙で主要な政党となるだろう。全国リストの議席は各党に公平に配分される。これは<span style="color: #7A3C00;">、**NSDAP**、</span>がドイツの中産階級にアピールする能力を著しく損なうだろう。関与する政党の右派的な傾向にもかかわらず、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>と<span style="color: #C0A054;">、**DVP**、</span>のやや友好的な指導力は、将来の協力をいくらか可能にするだろう。 ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_aftermath_timer == 1 and bourgeois_list: ブルジョワ団結の勢いは、多数のブルジョワ政党によって支持される共通の選挙リストの合意へと結実した。その結果、[? if kvp_cnblp_sister: <span style="color: #385A38;">**農村同盟**</span>?][? if not kvp_cnblp_sister: <span style="color: #7FCEB1;">**CNBLP**</span>?] と<span style="color: #007A00;">ドイツ農民党</span>の候補者が農村リストで優勢な政党となり、より都市部の[? if kvp_formed or dnvp_split_2: <span style="color: #0087DC;">**KVP**</span>、?]<span style="color: #b8996f;">**WP**</span>[? if bourgeois_list_ddp:、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>?] と<span style="color: #C0A054;">、**DVP**、</span>が都市部の投票用紙で主要な政党となるだろう。全国リストの議席は各党に公平に配分される。これは<span style="color: #7A3C00;">、**NSDAP**、</span>がドイツの中産階級にアピールする能力を著しく損なうだろう。 ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_1930_aftermath_timer == 1 and bourgeois_list_fail: ブルジョワ統一の運動は、今回は何の意義のある目標も達成できなかった。職業政党の指導部は、多数のブルジョワ政党による共通名簿の提案に反発した。それは彼らの職業的アイデンティティを破壊するものだったからだ。この敗北にもかかわらず、政党間の敵意を最小限に抑えることを目指して、いくつかの小規模な合意が成立した。?]{!</p>!}

{!<p class="dnvp">!}[? if bourgeois_negotiations_1930_aftermath_timer == 1 and bourgeois_parliament_no_liberals: トレヴィラヌスが率いる<span style="color: #0087DC;">**KVP**</span>の非自由主義ブルジョワ政党間の交渉は、ついに<span style="color: #0087DC;">**KVP**</span>、<span style="color: #b8996f;">**WP**</span>、そして<span style="color: #7FCEB1;">**CNBLP**</span>を特徴とする議会同盟の合意で幕を閉じた。これに<span style="color: #007A00;">ドイツ農民党</span>が加わったが、彼らは反対したにもかかわらず、そうでなければ議会では無所属であっただろう。?]{!</p>!}

{!<p class="dnvp">!}[? if bourgeois_negotiations_1930_aftermath_timer == 1 and bourgeois_negotiations_fail_parliament: の通り、<span style="color: #0087DC;">**KVP**</span> が主導する非自由主義ブルジョワ政党間の交渉は、結論的な合意なしに終わった。穏健なドイツ右派の多数の政党は、<span style="color: #7A3C00;">**NSDAP**</span> にドイツ中流層の分裂を利用させるだろう。?]{!</p>!}

{!<p class="dnvp">!}[? if bourgeois_negotiations_elections_1930_timer == 1 and bourgeois_merger_kvp_trigger: 驚くべきことに、[+ kvp_leader +]は、<span style="color: #c00000;">社会主義</span>への共通の恐れ、過去の協力事例、あるいは裕福な献金者から提供される現金の山によって、ブルジョワ政党を結集させることに成功した：[? if dnvp_split_2: 穏健なドイツ右派政党が<span style="color: #0087DC;">**KVP**</span>（<span style="color: #0087DC;">保守人民党</span>）の周りに統一が進んでいる。?][? if complete_dnvp_split: 穏健なドイツ右派政党が<span style="color: #0087DC;">**KVP**</span>（<span style="color: #0087DC;">保守人民党</span>）の周りに加わる動きが進んでいる。?] [? if dnvp_split_2: <span style="color: #3E88B3;">**DNVP**</span>からの様々な分裂の間、穏健派はそれぞれの背景から様々な政党に分かれていた。今や、彼らの再統合への切迫感が、自らの特殊な利益を代表したいという願望を上回ったようだ?][? if complete_dnvp_split:。これまで自らのアイデンティティを妥協することを拒否してきた<span style="color: #b8996f;">**WP**</span>と<span style="color: #7FCEB1;">**CNBLP**</span>の指導部は、今やブルジョワ統一の問題がより差し迫った懸念事項であると認識した?]。 ?]{!</p>!}

{!<p class="dnvp">!}[? if bourgeois_negotiations_elections_1930_timer == 1 and bourgeois_parliament_trigger_5: 驚くべきことに、<span style="color: #7FCEB1;">**CNBLP**</span>、<span style="color: #b8996f;">**WP**</span>、そして<span style="color: #0087DC;">**KVP**</span>は、ブルジョワ議会派閥の結成について合意した。彼らは、ブリューニングとその政策を支持する共同宣言と選挙休戦協定を発表した。しかし、<span style="color: #007A00;">ドイツ農民党</span>は、[? if not kvp_cnblp_sister: <span style="color: #7FCEB1;">**CNBLP**</span>?][? if kvp_cnblp_sister: <span style="color: #385A38;">**ランドブント**</span>?]、そして<span style="color: #0087DC;">**KVP**</span>の中での貴族や地主の優位性に不満を抱いている。彼らの反対にもかかわらず、派閥なしでは議会で無力であるため、計画に従わざるを得ない。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_elections_1930_timer == 1 and bourgeois_negotiations_fail_elections and not liberal_parliament: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>内の多くの者の頑迷さにより、同党と残るブルジョワ右派との合意は不可能になった。それでも[+ dvp_leader +]が招いた諸党の協議は続いたが、統一中道政党という[+ dvp_leader +]の提案への反応は冷淡だった。このため[+ dvp_leader +]は構想を縮小し、代わりに選挙休戦と、[? if chancellor == "Brüning":&nbsp;ブリューニングおよび?]ヒンデンブルク大統領を支持する共同選挙声明を提案した。当初は全党が受け入れたものの、<span style="color: #7FCEB1;">**CNBLP**</span>と<span style="color: #b8996f;">**WP**</span>の古参派が妨害した。だが条件付きの産業界資金を受け、最終的に「ヒンデンブルク綱領」を支持したのは<span style="color: #C0A054;">**DVP**</span>[? if dnvp_split_2 or kvp_formed:、<span style="color: #b8996f;">**WP**</span>、<span style="color: #0087DC;">**KVP**</span>?][? if not dnvp_split_2 and not kvp_formed:&nbsp;と<span style="color: #b8996f;">**WP**</span>?]だけであった。 ?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_elections_1930_timer == 1 and bourgeois_negotiations_fail_elections and liberal_parliament: 自由議会グループの結成から生じた不信感が、交渉を最初から事実上不可能にした。これらの会談の唯一の結果は、ヒンデンブルク大統領とブリューニング首相の政策を支持する曖昧な共同訴えである。選挙休戦協定の提案は、特殊利益政党によって拒否され、代わりに互いに論争を書きつけることに集中している。ブルジョワ政党間の不和は表面上は我々に有益に見えるかもしれないが、ドイツ中流階級の混乱と分裂は、<span style="color: #7A3C00;">ナチス</span>に状況を利用するための大きな機会を与えるだろう。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_elections_1930_timer == 1 and bourgeois_negotiations_fail_elections_dstp and not liberal_parliament:<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の結成と、<span style="color: #C0A054;">**DVP**</span>の議員を引き抜こうとする試みは、彼らの口に苦い味を残した。それにもかかわらず、党間の[+ dvp_leader +]での交渉は続行し、他の党からは統一の中道党を求める[+ dvp_leader +]の提案に対し冷ややかな反応が引き起こされた。これにより[+ dvp_leader +]は野心を縮小させ、代わりに選挙休戦と、次の党を支持する共同選挙運動を提案した。それは[? if chancellor == "Brüning":&nbsp;ブリューニングと?]大統領ヒンデンブルク。当初は全党から支持されたものの、<span style="color: #7FCEB1;">**CNBLP**</span>や<span style="color: #b8996f;">**WP**</span>の旧勢力からの反対がこの提案を妨げてきたが、最終的には条件付きの産業資金提供により、「ヒンデンブルク・プログラム」は<span style="color: #C0A054;">**DVP**</span>のみから支持された。[? if dnvp_split_2 or kvp_formed:<span style="color: #b8996f;">**WP**</span>、そして<span style="color: #0087DC;">**KVP**</span>?][? if not dnvp_split_2 and not kvp_formed:そして<span style="color: #b8996f;">**WP**</span>?] のみによって支持された。?]{!</p>!}

{!<p class="other">!}[? if flavour_2_trigger and flavour_2_trigger_time == time: バデンとヴュルテンベルクの<span style="color: #D3C24D;">**[+ ddp_name +]**</span>と<span style="color: #C0A054;">**DVP**</span>の州組織は、それぞれの全国指導部と相談することなく、来る国会選挙で統一候補者を出すことに合意した。これはシュレースヴィヒ＝ホルシュタインでも同様の提案を促したが、両党の全国指導部が介入し、現在および将来の交渉を迅速に停止させた。この中央本部からの干渉は、地方の党組織から強く嫌悪され、ブルジョワ統一の問題をめぐって全国指導部と一般党員との間の亀裂を深めた。?]{!</p>!}

{!<p class="other">!}[? if flavour_3_trigger and flavour_3_trigger_time == time: ヴァイマル共和国の州組織である<span style="color: #D3C24D;">**[+ ddp_name +]**</span>と<span style="color: #C0A054;">**DVP**</span>が、来る国会選挙で統一候補者名簿を提出することに合意した。これはそれぞれの全国指導部と相談なしに行われた動きである。この動きはシュレースヴィヒ＝ホルシュタインでも同様の提案を促し、やがてドイツ全土で統一された自由主義者名簿が出現した。これらの合意は全国指導部から公式に承認されたわけではないが、阻止されたわけでもない。ヘルマン・ディートリッヒやユリウス・クルティウスのような主要な自由主義指導者たちは、自身の選挙区で互いを共同名簿の筆頭に据えることさえした。?]{!</p>!}

{!<p class="other">!}[? if bourgeois_negotiations_elections_1930_timer == 1 and bourgeois_negotiations_fail_elections_kvp: <span style="color: #FFCC00;">**LVP**</span>の右派だが<span style="color: #3E88B3;">**DNVP**</span>より左派の統一ブルジョワ議会派をめぐる交渉は失敗した。<span style="color: #b8996f;">**WP**</span>と<span style="color: #7FCEB1;">**CNBLP**</span>は、彼らの職業的アイデンティティから、イデオロギー志向の<span style="color: #0087DC;">**KVP**</span>との接近に強く反対した。これは産業資本家たちにとって容認できないものであり、彼らは再び政党たちに、ブリューニングへの支持と選挙休戦に関する共同宣言に署名させることで協力を強要した。ブルジョワ政党の不和とそれに伴う企業献金の削減は、彼らの分裂を利用しようとする過激派の<span style="color: #7A3C00;">**NSDAP**</span>を生み出すだろう。?]{!</p>!}

{!<p class="dnvp">!}[? if dnvp_split_2_timer == 1: ウェスタープと彼の<span style="color: #3E88B3;">**DNVP**</span>穏健派グループは、新設された<span style="color: #0087DC;">保守人民党</span>（<span style="color: #0087DC;">**KVP**</span>）に、<span style="color: #7FCEB1;">**CNBLP**</span>[? if stegerwald_path == 0:&nbsp;や<span style="color: #8ED8E4;">**CSVD**</span>?]といった場所を見つけた。?]{!</p>!}

{!<p class="dnvp">!}[? if dnvp_split_2_timer == 1 and bourgeois_cooperation < 7:国民農村同盟（RLB）の会長であるマルティン・シエレだ。[? if not spd_in_government and chancellor == "Brüning":農務大臣、?]またドイツ農業界で最も影響力のある人物であるシエレは、組織農業とドイツ右派の関係再建に取り組んできた。これは、フーゲンベルクの行動によって両者と<span style="color: #3E88B3;">**DNVP**</span>との歴史的な結びつきが断たれたことを受けたものである。シエレはRLBと<span style="color: #7FCEB1;">**CNBLP**</span>を合同して新たな農民党を結成し、都市部でより広い支持を得られる<span style="color: #0087DC;">保守人民党</span>の姉妹政党とする構想を示した。しかし<span style="color: #7FCEB1;">**CNBLP**</span>の古参派は、農業をイデオロギー政党へ再編することに断固反対し、この提案を退けた。 ?]{!</p>!}

{!<p class="dnvp">!}[? if dnvp_split_2_timer == 1 and bourgeois_cooperation >= 7:国民農村同盟（RLB）の会長であるマルティン・シエレだ。[? if not spd_in_government and chancellor == "Brüning":農務大臣、?]そしてドイツの農業界で最も影響力のある人物の一人である彼は、組織化された農業とドイツ右派との間の繋がりを再構築しようと取り組んできた。これは、フーゲンベルクの行動によって生じた亀裂が、彼らと<span style="color: #3E88B3;">**DNVP**</span>との歴史的な絆を断ち切ったことに続くものだ。シエレは、RLBと<span style="color: #7FCEB1;">**CNBLP**</span>を合併させて新しい農民党を設立する計画を提案し、それが都市部により大きなアピール力を持つ<span style="color: #0087DC;">**KVP**</span>の姉妹党となることを目指している。党の古参勢力からの強い反対にもかかわらず、シエレは、かなりの影響力を持つ別の<span style="color: #3E88B3;">**DNVP**</span>の反体制派であるギュンター・ゲレケと共に、<span style="color: #0087DC;">保守人民党</span>との合意へと党を導くことに成功した。?]{!</p>!}

{!<p class="dnvp">!}[? if dnvp_split_2_timer == 2 and not kvp_cnblp_sister: 元<span style="color: #3E88B3;">**DNVP**</span>のメンバーであり、<span style="color: #7FCEB1;">**CNBLP**</span>の原動力であったギュンター・ゲレケは、党の旧勢力を<span style="color: #0087DC;">**KVP**</span>との選挙同盟を結ぶことで説得することに成功した。その努力に対し、彼はブルジョワ統一に向けた努力が評価され、ドイツの企業から厚遇された。これが彼がより広い党を説得する方法となった。これがなければ、<span style="color: #0087DC;">**KVP**</span>は議席を失う可能性が高く、<span style="color: #7FCEB1;">**CNBLP**</span>[? if stegerwald_path == 0:&nbsp;と<span style="color: #8ED8E4;">**CSVD**</span>?]が彼らがたった一つの議席を得るための余地を大きく狭めるだろう。?]{!</p>!}

{!<p class="dnvp">!}[? if dnvp_split_2_timer == 2 and kvp_cnblp_sister: <span style="color: #7FCEB1;">**CNBLP**</span>は解散し、代わりに、国民農民同盟（RLB）と<span style="color: #385A38;">**農村同盟**</span>の統合である<span style="color: #7FCEB1;">**CNBLP**</span>が誕生した。バイエルンやヴュルテンベルクのような州におけるRLBの地方支部は、数州で二桁の支持を得るほど浸透している。しかし、<span style="color: #007A00;">ドイツ農民党</span>は、<span style="color: #385A38;">**農村同盟**</span>の指導部における貴族や地主層の優勢に不満を抱いており、単独のリストで出馬するつもりだ。それにもかかわらず、<span style="color: #385A38;">**農村同盟**</span>と<span style="color: #0087DC;">国民保守党</span>の姉妹党的な取り決めは、ヴェスタープの下の小規模な<span style="color: #0087DC;">**KVP**</span>を、ブルジョワ的統一を促進する彼らの努力に満足した主要な産業資本家からの資金援助によって繁栄させるだろう。 ?]{!</p>!}

{!<p class="dnvp">!}[? if dnvp_split_2_timer == 2 and not kvp_cnblp_sister : <span style="color: #7FCEB1;">**CNBLP**</span>は、シエレの提案を拒否し、現在、農業共同体の職業的連帯を求めている。これには、RLBがその地方支部に対し、様々な地方保守組織を統合し、その後<span style="color: #7FCEB1;">**CNBLP**</span>の国会代表団に参加させることを目指して、共通の農民リストで出馬するよう働きかけることが含まれる。これはバイエルンやヴュルテンベルクのような州で二桁の支持を得ているものの、ドイツ農民組合連合のような主要組織は、二党派的な中立を維持している。 [? if not cnblp_dbp: <span style="color: #007A00;">ドイツ農民党</span>もまた、<span style="color: #7FCEB1;">**CNBLP**</span>の指導部における貴族や地主層の優勢に不満を抱いており、単独のリストで出馬するつもりだ。 ?][? if cnblp_dbp: <span style="color: #007A00;">ドイツ農民党</span>は、<span style="color: #7FCEB1;">**CNBLP**</span>の指導部における貴族や地主層の優勢に不満を抱きつつも、職業的連帯を根拠に<span style="color: #7FCEB1;">**CNBLP**</span>と共通のリストで出馬することを選んだ。 ?] ?]{!</p>!}

# not timer but dnvp split occurs anyway on the historical date of all the bourgeois negotiations so it will still work

{!<p class="other">!}[? if year = 1930 and month = 8: 映画化された物議を醸す反戦小説<i>西部戦線異状なしなき日々</i>がアメリカで公開されたが、我々の岸にはまだ届いていない。 ?]{!</p>!}

{!<p class="other">!}[? if flavour_8_trigger and flavour_8_trigger_time == time: かつて<span style="color: #D3C24D;">**[+ ddp_name +]**</span>を支持した多くの若者やブルジョワの団体の組織が、<span style="color: #C0A054;">**DVP**</span>の[+ dvp_leader +]による厳しい拒絶を受け、以来、党から距離を置いた。これらの<span style="color: #C0A054;">**DVP**</span>系の組織は、当初、ブルジョワの集中に向けた進展の欠如に不満を抱いていたが、今や態度を変えた。彼らは<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の結成を非難し、それがブルジョワの統一と両立しないと主張し、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の創設者たちに対し、真に包括的な中道党を創設するために<span style="color: #C0A054;">**DVP**</span>に参加するよう呼びかけた。これらの出来事は、党に対する敵意と相まって、その創設をめぐる当初の熱狂を著しく冷めた。 ?]{!</p>!}

{!<p class="other">!}[? if flavour_9_trigger and flavour_9_trigger_time == time: 若きドイツ騎士団の反ユダヤ主義とロマン主義は、<span style="color: #005EB8;">ユダヤ人</span>と旧来の<span style="color: #D3C24D;">民主主義者</span>の間で<span style="color: #D3C24D;">**[+ ddp_name +]**</span>において激しい対立を引き起こした。注目すべき例は、若きドイツ人たちから強い攻撃を受け、国会での議席をほとんど剥奪されそうになった<span style="color: #005EB8;">ユダヤ人</span>グスタフ・シュトルパーである。彼は、旧来の<span style="color: #D3C24D;">民主主義者</span>からの辞任の脅しによって、この運命を免れた。若きドイツ人と<span style="color: #D3C24D;">民主主義者</span>の間の対立は非常に激しく、<span style="color: #D3D3A9;">**VNR**</span>の候補者たちは、地元の組織からの抵抗なしに選出された者が一人もいなかった。 [? if dvp_ideology == "Right": 少なくとも<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、<span style="color: #7A3C00;">__**NSDAP**</span>に対して強い姿勢を示したが、これは<span style="color: #C0A054;">**DVP**</span>には言えない。彼らは、この崩壊によって生じた不満を抱え続けている。?] ?]{!</p>!}

{!<p class="both">!}[? if flavour_6_trigger and flavour_6_trigger_time == time: フーゲンベルクが<span style="color: #3E88B3;">**DNVP**</span>に割いた、アドルフ・ヒトラーを攻撃することへの注意の欠如が、 [? if nsdap_leader == "Hitler": アドルフ・ヒトラー ?][? if nsdap_leader == "Goebbels": ヨゼフ・ゲッベルス ?] の<span style="color: #7A3C00;">**NSDAP**</span>は、極めて大きな失策になりそうだ。党が<span style="color: #7A3C00;">ナチス</span>への対応で沈黙しているにもかかわらず、<span style="color: #7A3C00;">ナチス</span>も恩返しをしてくれない。彼らは、<span style="color: #3E88B3;">**DNVP**</span>が我々の代わりに攻撃することから多くの利益を得ている。<span style="color: #3E88B3;">**DNVP**</span>が保守的・国家主義的な勢力を自分たちの周りに集めようとする目標は、最終的に自分たちのためというよりも、<span style="color: #7A3C00;">ナチス</span>のためになっている。 ?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1930 and month = 9 and dnvp_ideology == "Moderate": [? if dnvp_leader == "Hergt": <span style="color: #3E88B3;">**DNVP**</span>の党大会がわずか二ヶ月後に迫る中、ヘルグトとその支配的な旧勢力は比較的安定した党を率いている。しかし、二つの主要な問題が依然として論争の的となっている。トレヴィラヌスと彼の若手保守派は民主主義への移行を主張する一方、台頭する<span style="color: #7A3C00;">**NSDAP**</span>との協力の問題が大きく影を落としており、<span style="color: #7A3C00;">ナチス</span>は、右派における支配的な勢力として<span style="color: #3E88B3;">**DNVP**</span>を凌駕する脅威となっている。 ?][? if dnvp_leader == "Lambach": ここ数か月、ランバッハは<span style="color: #3E88B3;">**DNVP**</span>党内で敵を増やしている。彼が<span style="color: #6D5298;">キリスト教社会派</span>の理念を党綱領へ取り入れ、党内で労働者と労働組合の役割を拡大しているためである。古参派や<span style="color: #385A38;">農業派</span>に連なる者の多くは、ランバッハが自分たちの利益を軽視し続けるなら<span style="color: #003755;">**DNF**</span>へ離党すると脅している。 ?][? if dnvp_leader == "Treviranus": トレヴィラヌスは、民主主義を受け入れ、君主制を公式な党の方針から外すという彼の動きをめぐり、ヴェスタープのような国家保守主義者からなる<span style="color: #3E88B3;">**DNVP**</span>の旧勢力とますます衝突している。さらに、賠償金に関する主要な「国家問題」についての彼の立場は、<span style="color: #3E88B3;">**DNVP**</span>の伝統的な立場から大きく逸脱している。 ?] ?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 9 and dvp_leader == "Scholz" and not lvp_formed and not lvp_merger_2_timer : <span style="color: #C0A054;">**DVP**</span>の得票率の大幅な低下と党組織の衰退を受け、党内で党首エルンスト・ショルツへの反発が強まっている。多くの党員は、ブルジョワ諸党の結集に向けた交渉を頓挫させた責任がショルツにあると考えている。地区組織の指導者の一人、ヴァルター・シュネルはショルツの無策に業を煮やし、ドイツのブルジョワジーの命運は単一政党への統合にかかっていると訴えている。 ?]{!</p>!}

{!<p class="other">!}[? if dkp_merger_timer == time + 2 and (dvp_leader == "Dingeldey" or dvp_leader == "Hugo") : 極右ポピュリズムの急増と左派の強気な態度に悩まされ、ドイツの重工業金融家たちは、KVP/DNVPとDVPに密かにより緊密な協力を議論するよう圧力をかけ始めている。産業資本家たちは、これら二つの党がより協力することで、国会での彼らの影響力を高められると期待している。KVP/DNVPとDVPの双方の議員、特にトレヴィラヌスとディンゲルデーは、これらの潜在的な会合に楽観的である。数週間にわたる舞台裏の圧力の後、KVP/DNVPとDVPは、国会での立法戦略を調整することを目的とした一連の合同会合を正式に開始した。トレヴィラヌスとディンゲルデーが慎重な楽観論をもって協議を主導する一方、KVP/DNVPの農村派の間には、DVPの都市中心の産業的利益からのさらなる影響を恐れる懸念が残っている。DVPの穏健派も同様に抵抗的であり、これをシュトレーゼマンの遺産からさらなる後退と見なしている。 ?]{!</p>!}

{!<p class="other">!}[? if dkp_merger_timer == time + 1 and (dvp_leader == "Dingeldey" or dvp_leader == "Hugo") : 数週間にわたる慎重な審議を経て、KVP/DNVPとDVPは、党の綱領を一致させ、候補者の選出を調整する上で予想外に急速な進展を見せた。この勢いは、正式な合併を目前に控えている。トレヴィラヌスとディンゲルディーは、前例のない団結を称賛し、完全な合併が目前に迫っていることを公然と認めている。DVPの穏健派とKVP/DNVPの農民派は依然として懸念を表明しているが、より広範な多数派がより深い統合のもとに結集するにつれて、彼らの抵抗はますます脇に追いやられている。?]{!</p>!}

{!<p class="other">!}[? if dkp_merger_timer == time + 2 and dvp_leader == "Glatzel" : 極右ポピュリズムの波と勢いづく左翼を抑え込もうと、KVP/DNVPとDVPはより緊密な協力を議論し始めた。彼らの狙いは、同盟が国会における彼らの影響力を高め、支持を維持するのに役立つことだ。KVP/DNVPとDVPのメンバー、特にトレヴィラヌスとグラッツェルは、これらの潜在的な会合に楽観的だ。数週間にわたる秘密会合の後、KVP/DNVPとDVPは、国会での立法戦略を調整することを目的とした一連の合同会合を正式に開始した。トレヴィラヌスとグラッツェルが慎重な楽観論をもって協議を主導する一方、KVP/DNVPの農民派の間には、DVPの都市中産階級の利益からのさらなる影響を恐れる懸念が残っている。DVPの穏健派も同様に抵抗的であり、これをシュトレーゼマンの遺産からのさらなる後退と見なしている。?]{!</p>!}

{!<p class="other">!}[? if dkp_merger_timer == time + 2 and dvp_leader == "Glatzel" : 数週間にわたる慎重な審議を経て、KVP/DNVPとDVPは、党の綱領を一致させ、候補者の選出を調整する上で予想外に急速な進展を見せた。この勢いは、正式な合併を目前に控えている。トレヴィラヌスとグラッツェルは、前例のない団結を称賛し、完全な合併が目前に迫っていることを公然と認めている。DVPの穏健派とKVP/DNVPの農民派は依然として懸念を表明しているが、より広範な多数派がより深い統合のもとに結集するにつれて、彼らの抵抗はますます脇に追いやられている。?]{!</p>!}

{!<p class="other">!}[? if flavour_12_trigger and flavour_12_trigger_time == time: ブルーニング政権を容認するという我々の決定は、評価されるものの、ドイツのブルジョワエリートのより保守的な派閥からのブルーニングの支持を著しく損なう重大な負債となった。これは特にドイツ重工業の間で顕著であり、彼らは首相が我々の支持に過度に依存するのを防ぐため、ブルーニングと<span style="color: #7A3C00;">極左</span>-<span style="color: #3E88B3;">右</span>の党との接近を促進する努力を倍増させている。ブルーニング政権と、当初彼を熱心に支持した資本家経済的利益との関係は、今やますます緊張している。[? if dvp_ideology == "Right" and not lvp_formed and dvp_exist:右派の<span style="color: #C0A054;">-**DVP**-</span>は、この展開にあまりに不満を抱いており、もはやブルーニングとその政権に対して強い忠誠心を感じていない。まるで<span style="color: #C0A054;">-**DVP**-</span>がすでに十分な政権を倒したかのようだ。?]-[? if lvp_ideology == "Right" and lvp_formed: <span style="color: #FFCC00;">-**LVP**-</span>の右派の要素は、この展開にあまりに不満を抱いており、もはやブルーニングとその政権に対して強い忠誠心を感じていない。?] ?]{!</p>!}

{!<p class="other">!}[? if flavour_10_trigger and flavour_10_trigger_time == time : 何らかの理由で、<span style="color: #D3C24D;">**[+ ddp_name +]**</span> 議会派閥を形成するための国会代表を欠いており、今や別の政党と交渉して同盟を結ぶ必要がある。この場合、<span style="color: #D3C24D;">**[+ ddp_name +]**</span> は、<span style="color: #C0A054;">**DVP**</span> のと協力して議会派閥を設立することを決定した。驚くべきことに、<span style="color: #C0A054;">**DVP**</span> は、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>, [? if dvp_leader == "Scholz" and dstp_formed: と協力することに関心を示したが、まさに合意を最終決定しようとしたところ、怒れるエルンスト・ショルツが交渉を水泡に帰させた。彼は、<span style="color: #D3C24D;">**[+ ddp_name +]**</span> がブルジョワの統一に向けた彼の努力を妨害したことに今なお激怒していた。幸いなことに、<span style="color: #D3C24D;">**[+ ddp_name +]**</span> は、<span style="color: #b8996f;">**WP**</span> から数名の離脱を受け入れることができ、議会派閥に必要な規模に達した。?][? if dvp_leader != "Scholz" or not dstp_formed: [? if chancellor == "Brüning" and not spd_in_government: ブリューニング政権に対する陰謀を止め、合意を最終決定した。?][? if not (chancellor == "Brüning" and not spd_in_government): 確執を棚上げし、合意を最終決定した。?]?] ?]{!</p>!}

{!<p class="other">!}[? if flavour_11_trigger and flavour_11_trigger_time == time : 何らかの理由で、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は議会派閥を形成するための国会代表を欠いており、今や別の党と交渉して協力する必要がある。この場合、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は<span style="color: #C0A054;">**DVP**</span>と協力して議会派閥を設立することを決定した。驚くべきことに、<span style="color: #C0A054;">**DVP**</span>は<span style="color: #D3C24D;">**[+ ddp_name +]**</span>との協調に関心を示した。 [? if dvp_leader == "Scholz" and dstp_formed: しかし、彼らが合意をまとめる寸前、怒れるエルンスト・ショルツが交渉を水泡に帰させた。彼は、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>がブルジョワ統一に向けた彼の努力をいかに妨害したかということに依然として激怒していた。その結果、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は選択肢を使い果たしたため、代わりに<span style="color: #b8996f;">**WP**</span>と合意した。 ?][? if dvp_leader != "Scholz" or not dstp_formed: [? if chancellor == "Brüning" and not spd_in_government: ブリューニング政権に対する陰謀を止め、合意をまとめたため。 ?][? if not (chancellor == "Brüning" and not spd_in_government): 恨みを棚上げし、合意をまとめたため。 ?]?] ?]{!</p>!}

{!<p class="other">!}[? if flavour_32_trigger and flavour_32_trigger_time == time : 何らかの理由で、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は議会派閥を形成するための国会代表を欠いており、今や別の政党と交渉して協力する必要がある。ブルジョワ政党がすでにグループ化しているため、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は彼らと交渉せざるを得ない。驚くべきことに、ブルジョワ政党は党に対するわだかまりを乗り越え、協力に前向きである。[? if dvp_leader == "Scholz" and dstp_formed:しかし、彼らが合意をまとめる寸前、怒れるエルンスト・ショルツが交渉を水泡に帰させた。彼は、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>がブルジョワの団結に向けた彼の努力をいかに妨害したかについて、いまだに激怒していた。幸いなことに、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、派閥に必要な規模に達するために、グループ内の様々な政党からの数名の離脱を受け入れることができた。?][? if dvp_leader != "Scholz" or not dstp_formed:[? if chancellor == "Brüning" and not spd_in_government:彼らは皆、合意をまとめるためにブリューニング政権に対する陰謀を止めることに合意した。?][? if not (chancellor == "Brüning" and not spd_in_government):過去の争いを棚上げし、彼らは合意をまとめた。?]?]?]{!</p>!}

{!<p class="other">!}[? if flavour_33_trigger and flavour_33_trigger_time == time : 何らかの理由で、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は議会派閥を形成するための国会代表を欠いており、今や別の政党と交渉して協力する必要がある。ブルジョワ政党がすでにグループ化しているため、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は彼らと交渉せざるを得ない。驚くべきことに、ブルジョワ政党は党に対するわだかまりを乗り越え、協力に前向きである。[? if dvp_leader == "Scholz" and dstp_formed:しかし、彼らが合意をまとめる寸前、怒れるエルンスト・ショルツが交渉を水泡に帰させた。彼は、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>がブルジョワの団結に向けた彼の努力をいかに妨害したかについて、いまだに激怒していた。その結果、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、[? if z_party_name != "CVP": <span style="color: #000000;">中央</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]の議会グループに入ることを余儀なくされた。?][? if dvp_leader != "Scholz" or not dstp_formed:[? if chancellor == "Brüning" and not spd_in_government:彼らは皆、合意をまとめるためにブリューニング政権に対する陰謀を止めることに合意した。?][? if not (chancellor == "Brüning" and not spd_in_government):過去の争いを棚上げし、彼らは合意をまとめた。?]?]?]{!</p>!}

{!<p class="other">!}[? if flavour_54_trigger and flavour_54_trigger_time == time : <span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、何らかの理由で、議会派閥を形成するための必要な国会代表を欠いている。その結果、[? if wp_r + ddp_r >= 3.6:で<span style="color: #b8996f;">**WP**</span>およびその他の小規模なブルジョワ政党?][? if wp_r + ddp_r < 3.6:と合意し、[? if z_party_name != "CVP": <span style="color: #000000;">中央</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]'s議会グループ?]に入ることを余儀なくされた。<span style="color: #C0A054;">**DVP**</span>が<span style="color: #3E88B3;">**DNVP**</span>に合流したことは、統一された自由主義議会グループの可能性を事実上排除した。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 9 : 小さなブラウンシュヴァイク自由州で選挙が行われ、[? if not brunswick_hitler:<span style="color: #c00000;">**SPD**</span>が再び過半数を獲得した。?][? if brunswick_hitler:ブルジョワ統一名簿と<span style="color: #7A3C00;">**NSDAP**</span>が勝利した。我々が得票で第一党となったにもかかわらず、両者が連立政権を樹立する。?][? if brunswick_hitler:<span style="color: #7A3C00;">**NSDAP**</span>は新たに得た政権内での地位を利用し、依然として無国籍のヒトラーにドイツ国籍を与えると見られている。?]?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1930 and month = 9 : <span style="color: #7A3C00;">**NSDAP**</span>のアドルフ・ヒトラーは、合法的手段で権力を獲得すると誓う「合法性宣誓」を行った。これは、国防軍内に<span style="color: #7A3C00;">**NSDAP**</span>の細胞を築いて全国蜂起を企てたとして、<span style="color: #7A3C00;">ナチ</span>党員と国防軍将校リヒャルト・シェリンガー、ハンス・ルーディンが起訴された裁判でのことである。通常なら、大逆罪の準備に等しいヒトラーの発言は起訴につながるはずだった。だが当局は<span style="color: #7A3C00;">ナチ</span>の方針を容認し、正当化さえしている。 ?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_18_trigger and flavour_18_trigger_time == time: かつてブリューニングのブルジョワ政権の熱烈な支持者であり、閣僚の地位を確保した唯一の特別利益政党であった<span style="color: #b8996f;">**WP**</span>は、選挙での敗北を受けて、今や政権から自らを切り離そうと奔走している。党は選挙基盤を新しい州に拡大したことから利益を報告しているが、これらは、最初に成功を収めた地域での不釣り合いに大きな損失によって相殺されている。同じ傾向は<span style="color: #7FCEB1;">**CNBLP**</span>でも観察できる。現在、党首のヘルマン・ドロイッツと、党内の右翼の反ブリューニング派との間で、分裂的な内部闘争が生じている。後者は、単独の閣僚の辞任を党に要求し、ブリューニングに我々の票への依存を放棄し、代わりに<span style="color: #7A3C00;">**NSDAP**</span>と連立することを圧力をかけることを目指している。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_29_trigger and flavour_29_trigger_time == time: かつてブリューニングのブルジョワ政権を熱心に支持した<span style="color: #b8996f;">**WP**</span>は、選挙での敗北を受け、政権と距離を置こうと躍起になっている。新たな州への進出で支持を得たものの、従来の地盤での大幅な後退がそれを上回った。<span style="color: #7FCEB1;">**CNBLP**</span>にも同じ傾向が見られる。党首ヘルマン・ドロイッツと司法相ヨハン・ブレヒトが率いる親ブリューニング派と、反発を強める地区組織の間で、党内の権力闘争が起きている。反ブリューニング派は、ブリューニングに<span style="color: #7A3C00;">**NSDAP**</span>との連立を組ませるよう、党が圧力をかけることを要求している。[? if spd_toleration:我々の票への依存を減らすためだ。?]要求が受け入れられなければ、地区組織を解散するか、さらには離党することも辞さないと警告している。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 10 and spd_prussia:失敗したヤング案の住民投票後の経済不況の中、<span style="color: #3E88B3;">**鉄兜団**</span>は再びドイツを不安定化させ、二極化させようとしている。彼らの年次大会で、<span style="color: #3E88B3;">**鉄兜団**</span>はプロイセン州議会を早期解散するための住民投票の計画を発表した。ヴァイマル共和国建国以来、プロイセンで支配的な地位を占めてきた<span style="color: #c00000;">社会民主主義</span>に不満を抱き、彼らは右翼への全国的な移行をよりよく反映する新たな選挙を強要しようとしている。[? if dnvp_ideology == "Radical":他の右翼政党からの強い熱狂にもかかわらず、?][? if dnvp_ideology == "Moderate":これは右翼政党から懐疑的に見られており、?] ヒトラー自身はこの構想にほとんど関心を示さず、<span style="color: #7A3C00;">ナチ</span>幹部の一部が強く支持しているにもかかわらず、<span style="color: #7A3C00;">**NSDAP**</span>としての参加を拒んでいる。 [? if dvp_ideology == "Right" and not in_grand_coalition_prussia and (dvp_leader == "Scholz" or dvp_leader == "Dingeldey"):<span style="color: #C0A054;">**DVP**</span>も「国民戦線」への参加を求められたが、その指導部は<span style="color: #7A3C00;">ナチス</span>が未定である限りコミットすることを拒んでいる。彼らがこの申し出を完全に拒否していないという事実は、彼らが民主主義からどれほど逸脱したかを物語っている。?]この段階では、その計画の成功はヒトラーの支持にかかっているように見える。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 10 and dvp_leader == "Scholz" and not lvp_formed and not lvp_merger_2_timer : ヴァルター・シュネルはブルジョワ勢力集中という目標に向けて具体的に動き、ドイツ各地の幹部を特別会議へ招いた。同グループは、ブルジョワ諸党の議会会派だけでは不十分で、ドイツ中間層の存続にはさらに抜本的な措置が必要だと考えている。シュネルのグループは<span style="color: #C0A054;">**DVP**</span>全国指導部に目標を支持させるため、今月の<span style="color: #C0A054;">**DVP**</span>執行委員会で主導権を握るつもりだったが、彼らにとって不運なことに会合は翌月へ延期された。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 10 and dvp_leader != "Scholz" and not lvp_formed and not lvp_merger_2_timer : <span style="color: #C0A054;">**DVP**</span>の得票率の大幅な低下と党組織の衰退を受け、党内で党首[+ dvp_leader +]への反発が強まっている。党内右派の多くは、指導部が<span style="color: #c00000;">**SPD**</span>に接近しすぎたことが支持低下の原因だと考えている。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 10:<span style="color: #009739;">ブ</span><span style="color: #FEDD00;">ラジ</span><span style="color: #009739;">ル</span>は、第一共和制を第二共和制に置き換え、今年初めの争われた大統領選挙の結果を受けてゲトゥリオ・ヴァルガスを権力者に迎えるという革命を経験した。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1930 and month = 10 and dnvp_ideology == "Moderate" and (dnvp_leader != "Hergt" or spd_prussia): [? if dnvp_leader == "Hergt":プロイセン州議会を解散するための住民投票を仕掛けることでドイツの民主主義を不安定化させようとする<span style="color: #3E88B3;">**鉄兜団**</span>の計画は、<span style="color: #3E88B3;">**DNVP**</span>内に分裂を引き起こした。党内の多くの者は、プロイセンにおける<span style="color: #c00000;">社会民主主義</span>の支配を終わらせるためのこの動きに参加することを支持しているが、トレヴィラヌスと彼の若年保守派は、それには<span style="color: #7A3C00;">**NSDAP**</span>との協力が必要になるため反対している。?][? if dnvp_leader == "Lambach": ランバッハとその支持者たちは、新しい党綱領を掲げた。特に、ドイツ労働者の生活改善を目的とした具体的な政策に重点を置き、君主制を控えめに扱っている。この転換は、古い勢力から激しい反発を招いている。彼らは、これがランバッハがかつて「ランバッハ論文」で示したビジョンを進めている証拠だと見ているのだ。来月党大会を控え、彼らは公然と彼を排除する計画を立てている。少なくとも、彼はトレヴィラヌスの支持を確保した。 ?][? if dnvp_leader == "Treviranus": トレヴィラヌスとその支持者たちは、<span style="color: #3E88B3;">**DNVP**</span>の綱領を刷新する提案を出し、より<span style="color: #0087DC;">キリスト教民主</span>の路線へと転換させた。この提案は、君主制に関する大きな言及を省き、大統領権限の強化という形で、現体制を暗に支持している。これは古い勢力を大いに怒らせた。 [? if not true_christian_democracy: そして、彼らのトレヴィラヌスに対する影響力によって、彼はその提案を撤回し、現状維持を保たざるを得なかった。 ?][? if true_christian_democracy: 彼らは、君主制が<span style="color: #3E88B3;">**DNVP**</span>の核心的な部分だと信じている。 ?] これらの意見の相違は、来月の党大会で解決しなければならない。 ?] ?]{!</p>!}

{!<p class="other">!}[? if flavour_58_trigger and flavour_58_trigger_time == time: 全国農村同盟（RLB）は、悪化する経済的・農業的危機による急進化の増大を受け、指導部に大きな変化を遂げた。これにより、ブリューニング内閣の農政に対する反乱が生じた。その結果、農務大臣でありRLBの会長であったシエレは、RLBの指導部から<span style="color: #7FCEB1;">**CNBLP**</span>のカール・ヘップと共に辞任を余儀なくされた。その後任として、超反動主義者でありフーゲンベルク支持者であるエベルハード・フォン・カルクロイヒト伯爵がRLBの新会長に選出された。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_57_trigger and flavour_57_trigger_time == time: ブルーニング内閣は、東部農業企業の債務を軽減することを目的とした東部援助法を導入したが、これは多大な財政負担を伴う。この措置は、予算緊縮による経済回復というブルーニングのより広範な戦略と真っ向から矛盾する。政策の資金の一部を賄うため、政府はヤング計画後に時代遅れとなった賠償税を維持している。しかし、債務救済のための完全な資金不足は多くの有力地主を不満にさせ、彼らは自らの苦情を直接ヒンデンブルクに持ちかけ、彼に対してかなりの影響力を行使している。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 11 and dvp_leader == "Scholz" and not lvp_formed and not lvp_merger_2_timer : シュネルのグループは、エドゥアルト・ディンゲルダイをショルツ自身に副議長として当選させた。この選出は、ショルツが<span style="color: #C0A054;">**DVP**</span>の議長と国会代表団の責任者という二重の役割を担っていること、そして彼の継続的な健康問題によって正当化された。この動きは、<span style="color: #C0A054;">**DVP**</span>の活性化と、統一ブルジョワ党のためのシュネルの計画の実行責任を、ショルツからより協調的な人物へと移すことを目的としていた。ディンゲルダイの任命後のショルツの病状のため、彼は最終的に彼に譲る形で辞任することを選んだ。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 11 and dvp_leader != "Scholz" and not lvp_formed and not lvp_merger_2_timer : [? if dvp_leader == "Curtius": <span style="color: #C0A054;">**DVP**</span>の右翼は、エドゥアルト・ディンゲルダイを新たな副委員長に任命し、カーティウスの職務の一部を彼に移すことを目指した[? if foreign_minister_party == "DVP":、外務大臣としての職務に追われているため?][? if foreign_minister_party != "DVP":、政府の業務に関与しているため?]。しかし、カーティウスはこの動きに異議を唱え、ディンゲルダイの保守的な立場、特に<span style="color: #c00000;">**SPD**</span>との協力に関して懸念を示し、党の指導権を彼に委任することを拒否した。これにより、<span style="color: #C0A054;">**DVP**</span>の右翼は、来月の執行委員会で彼の排除を画策し始めた.?][? if dvp_leader == "Luther":昨年、彼が<span style="color: #C0A054;">**DVP**</span>の指導者として初めて選出されたとき、ハンス・ルーサーが得ていた幅広い支持は、主に<span style="color: #c00000;">**SPD**</span>との建設的な協力に関する彼の立場によって失墜した。この立場は、当初彼の指導を歓迎していた経済界の熱意を著しく冷めた。今や、<span style="color: #C0A054;">**DVP**</span>の右翼は、来月の執行委員会で彼の排除を画策している.?] ?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 11 and dstp_collapsed and not lvp_formed and not lvp_merger_2_timer : <span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、<span style="color: #D3C24D;">**党**</span>を形成する過程を確定させるため、正式に党大会を開いた。<span style="color: #D3C24D;">**[+ ddp_name +]**</span>が前身とは異なるようにするため、ヘルマン・ディートリヒは、より保守的な体裁を整えるため、平和主義者や急進的民主主義者を新党から排除する努力をした。これにより、残った左翼の<span style="color: #D3C24D;">**DDP**</span>のメンバーが離脱し、取るに足らない<span style="color: #E0B0FF;">急進民主党</span>（<span style="color: #E0B0FF;">**RDP**</span>）を組織した。そこには少数の若年民主党員しか加わらなかった。残念ながら、善意や高潔な理念だけでは、政治党を築くには不十分だった。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 11 and dstp_maintained and not lvp_formed and not lvp_merger_2_timer : <span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、<span style="color: #D3C24D;">**党**</span>の結成を確定させるため、正式に党大会を開いた。<span style="color: #D3D3A9;">**VNR**</span>の代表者数の増加は、党に「国民的」「社会的な」「*フォルクスゲマインシャフト*」といった言葉を用いる、より国家主義的な綱領を採用させた一方、「<span style="color: #586593;">民主主義</span>」や「<span style="color: #FFCC00;">自由主義</span>」への言及を省いた。さらに、党はより保守的なイメージを出すために、平和主義者や急進的民主主義者を排除するよう努めた。これにより、残った左翼の<span style="color: #D3C24D;">**DDP**</span>のメンバーが離脱し、取るに足らない<span style="color: #E0B0FF;">急進民主党</span>（<span style="color: #E0B0FF;">**RDP**</span>）を組織した。そこには少数の若年民主党員しか加わらなかった。残念ながら、善意や高潔な理念だけでは、政治党を築くには不十分だった。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 11 : <span style="color: #C8102E;">オーストリア社会民主党</span>は、最近の議会選挙で勝利し、<i>国会</i>で過半数を確保した。しかし、<span style="color: #000000;">キリスト教社会党</span>と小規模なブルジョワ政党による右派連合が、再び彼らを政府から排除した。<span style="color: #7A3C00;">**NSDAP**</span>のオーストリア支部は3%の票を獲得し、<span style="color: #ABDDA4;">ハインヴェア</span>の政治部門（我々の<i>フリーコープ</i>に相当）は6%を獲得した。これは特に懸念される。なぜなら、<span style="color: #C8102E;">オーストリア社会民主党</span>は、野党にありながら経済恐慌に見舞われる中で票を失っており、有権者が右側で答えを探していることを示唆しているからだ。 ?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_15_trigger and flavour_15_trigger_time == time: ブリューニング政権に対する我々の影響力、彼の農村救済計画の非効果性、マルティン・シエレがRLBを辞任したことで示された農村有権層の急進化、そして<span style="color: #7FCEB1;">**CNBLP**</span>が<span style="color: #3E88B3;">**DNVP**</span>と<span style="color: #7A3C00;">**NSDAP**</span>に続いた農村部での3位という結果が、党にブリューニングへの支持を再考させた。反ブリューニングの右派派閥が今や<span style="color: #7FCEB1;">**CNBLP**</span>を支配し、首相を非難し、<span style="color: #7A3C00;">ナチス</span>を含むよう連立の再編を要求する決議を押し通した。ブリューニングはこれに従うことを拒否し、<span style="color: #7FCEB1;">**CNBLP**</span>が彼の連立から離脱した最初の政党の一つとなり、今や彼の法令に反対票を投じ、右派の不信任動議を支持している。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_25_trigger and flavour_25_trigger_time == time: ブルニンの農村救済策の全体的な非効率性は、農業大臣マルティン・シエレが率いる[? if dnvp_split_2: <span style="color: #7FCEB1;">**CNBLP**</span>?][? if kvp_formed: <span style="color: #0087DC;">**KVP**</span>?][? if dnvp_ideology == "Moderate": <span style="color: #3E88B3;">**DNVP**</span>?]において、党内での不満の高まりを招いた。支持を維持するため、シエレとブルニンは、重い財政負担を課すにもかかわらず、東部の農業企業の負債を軽減することを目的とした正式な<i>東部援助法</i>を導入した。この措置は組織化された農業とヒンデンブルク自身をなだめたが、ブルニンの均衡予算による経済回復というより広範な戦略と真っ向から矛盾する。?]{!</p>!}

{!<p class="other">!}[? if year = 1930 and month = 12 and kpd_leader == "Thälmann" : エルンスト・テルマンは新しい<span style='color: #7A3C00;'>国民的ポピュリスト</span>戦略を受け入れ、<i>人民革命</i>のスローガンのもとで結集する。この動きは、<span style='color: #700000;'>**KPD**</span>が、<span style='color: #7A3C00;'>**NSDAP**</span>が最も強いブルジョワ階級の社会集団における影響力を拡大しようとする試みである。レオン・トロツキーや他の多くの<span style='color: #700000;'>**共産主義者**</span>は、この転換を非難し、「プロレタリア革命」の代わりに「人民革命」を用いることは<span style="color: #9B0000;">マルクス主義</span>の歪曲であると糾弾する。彼らはまた、それがオットー・シュトラッサーや<span style='color: #7A3C00;'>**NSDAP**</span>の左派派が使用した全く同じスローガンであることも指摘する。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_17_trigger and flavour_17_trigger_time == time: 北部派閥の国会議員が<span style="color: #007A00;">ドイツ農民党</span>から<span style="color: #D3C24D;">**[+ ddp_name +]**</span>へ離脱したことで、この党は全国的な政治勢力としての地位を事実上失った。残っているのは、元の<span style="color: #38C538;">バイエルン農民同盟</span>のみであり、この同盟は、ドイツの危機に対する解決策を求めて農民のほとんどが右に傾く中で、次期選挙でかつての支持のほんの一部しか確保できないと予想される。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_19_trigger and flavour_19_trigger_time == time: [? if bruning_time: <span style="color: #b8996f;">の**WP**</span>は、ブリューニングに対する不信任決議案を提出した。これは、彼の政府との和解の可能性を正式に終わらせ、かつて支持していたブルジョワ政党の増加する列に加わることを意味する。この決定は、党の単独大臣が反ブリューニングの右派からの圧力により辞任した後に起こった。彼だけが辞任したわけではない。党の?][? if not bruning_time:の<span style="color: #b8996f;">**WP**</span>の?]副委員長であり実質的な宣伝担当者であったオットー・コロザーも、ドロイッツの「一人の男による独裁」に抗議して辞任し、さらに彼を財政不正やその他の不正行為で告発した。内部の争いは深刻化し、多くの地方支部が離脱し、<span style="color: #b8996f;">**WP**</span>を存続可能な国家政治勢力として事実上終わらせた。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_30_trigger and flavour_30_trigger_time == time: <span style="color: #b8996f;">**WP**</span>の単独の閣僚であるヨハン・ブレヒトに、その反ブリューニングの右派からの圧力がかかっているにもかかわらず、党会長のヘルマン・ドロイッツは、議会代表団の過半数を味方につけることに成功した。[? if not in_right_coalition and not in_center_right_coalition: ブリューニングとの交渉で中産階級のための重要な譲歩を取り付けた後。?][? if in_right_coalition or in_center_right_coalition: より広範な閣僚たちを説得し、中産階級に影響を与えることになる増税を断念させた後。?] しかし、この勝利には代償が伴う。副会長で主任プロパガンダ担当のオットー・コロッサーは、ドロイッツの「一人の独裁」を非難し、金銭的な不正やその他の不正行為で彼を告発して抗議し辞任した。この内部対立は深刻化し、多くの地方支部が離反し、<span style="color: #b8996f;">**WP**</span>が実行可能な国家的な政治勢力としての地位を著しく弱体化させた。?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 1 and dvp_leader == "Dingeldey" and not bourgeois_list and (dnvp_split_2 or kvp_formed) and not lvp_formed and not lvp_merger_2_timer: 自由派やブルジョワの団結にとって以前の挫折があったにもかかわらず、中道派と穏健な右派政党間のより緊密な結びつきへの推進は、特に地方レベルで生き続けている。ヘッセン州の[? if dstp_formed: <span style="color: #E0B0FF;">**急進民主党**</span>?][? if not dstp_formed: <span style="color: #D3C24D;">**民主党**</span>?], <span style="color: #0087DC;">**KVP**</span>, および<span style="color: #8ED8E4;">**CSVD**</span>の政治家たちが、より緊密な協力について話し合うために会合を開いた。彼らの取り組みは驚くほど肯定的な反応を受け、新しい全国組織の結成や、ハンス・リューターやオットー・ゲスラーのような人物への招待につながった。しかし、この努力は期待外れだった。多くの人が参加を辞退した[? if spd_prussia:。これは主に、<span style="color: #3E88B3;">**鉄兜団**</span>が計画したプロイセンの住民投票によって引き起こされた深い分裂が原因であり、それによって<span style="color: #D3C24D;">**[+ ddp_name +]**</span>が穏健な右派の残りの部分から引き裂かれた?][? if not spd_prussia:。これは主に、各全国政党の指導部間の強い敵意によるものだった?]?]{!</p>!}

{!<p class="other">!}[? if flavour_23_trigger and flavour_23_trigger_time == time: [+ dvp_leader +]率いる<span style="color: #C0A054;">**DVP**</span>は、自党のユリウス・クルティウス、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の副首相ヘルマン・ディートリヒ、そして[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]の内相ヨーゼフ・ヴィルトら比較的左派寄りの閣僚を外して内閣を改造するよう、ブリューニングに圧力をかけた。しかし<span style="color: #C0A054;">**DVP**</span>国会議員団の過半数を得られず、計画は棚上げとなった。[+ dvp_leader +]は、[+ chancellor +]が緊急令の策定から支持政党を事実上排除したことに今なお憤っている。その一方で、[+ dvp_leader +]は「<span style="color: #7A3C00;">国民</span><span style="color: #3E88B3;">野党</span>」との関係強化を進めている。 ?]{!</p>!}

{!<p class="other">!}[? if flavour_39_trigger and flavour_39_trigger_time == time: [? if lvp_leader == "Dingeldey": <span style="color: #FFCC00;">**LVP**</span>のディンゲルデーは、自党の副首相ヘルマン・ディートリヒと、[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]の内相ヨーゼフ・ヴィルトら比較的左派寄りの閣僚を外すよう、ブリューニングに圧力をかけようと画策した。しかし党内のほぼ全方面から強い反発が起きた。それでも、[+ chancellor +]が緊急令の策定から支持政党を事実上排除したことへの憤りを背景に、反ブリューニング右派が徐々に台頭している。 ?][? if lvp_leader != "Dingeldey": ブリューニング政権の意思決定の多くから政党が排除されたことで、かつて熱烈に支持した者たちの間にも反感が広がり、<span style="color: #FFCC00;">**LVP**</span>も例外ではない。議員団の一部、とりわけ旧<span style="color: #C0A054;">**DVP**</span>右派で、その多くが<span style="color: #3E88B3;">**鉄兜団**</span>員でもある者たちは、自党の副首相ヘルマン・ディートリヒと、[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]の内相ヨーゼフ・ヴィルトら左派寄りの閣僚を公然と批判している。 ?] ?]{!</p>!}

{!<p class="other">!}[? if flavour_35_trigger and flavour_35_trigger_time == time: [+ dvp_leader +]の<span style="color: #C0A054;">**DVP**</span>は、自らのジュリウス・クルティウスや、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の副首相ヘルマン・ディートリヒら、比較的左派の閣僚を排除することで、ブリューニングに内閣の再編を迫ろうとした。しかし、これらの試みは<span style="color: #C0A054;">**DVP**</span>の国会代表団からの支持を得られず、[+ dvp_leader +]は計画を断念せざるを得なかった。右派の<span style="color: #3E88B3;">**DNVP**</span>の政府への参加は、<span style="color: #C0A054;">**DVP**</span>の右派に、フーゲンベルクの<span style="color: #003755;">**DNF**</span>やヒトラーの<span style="color: #7A3C00;">**NSDAP**</span>を懐柔する努力を断念させた。彼らは、内閣はすでに十分に右派だと考えているからだ。?]{!</p>!}

{!<p class="other">!}[? if flavour_56_trigger and flavour_56_trigger_time == time: ディンゲルデーと<span style="color: #C0A054;">**DVP**</span>右派は、自党のユリウス・クルティウスや<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の副首相ヘルマン・ディートリヒを含む比較的左派寄りの閣僚を外し、内閣を改造するようブリューニングに圧力をかけた。しかし<span style="color: #C0A054;">**DVP**</span>国会議員団では支持が広がらず、[+ dvp_leader +]も自党閣僚の追放を強く非難した。党内右派は今後もブリューニングを悩ませるだろうが、現時点では騒音以上の存在ではない。 ?]{!</p>!}

{!<p class="other">!}[? if flavour_43_trigger and flavour_43_trigger_time == time: <span style="color: #FFCC00;">**LVP**</span>のディンゲルデーは、自党の副首相ヘルマン・ディートリヒと、[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]の内相ヨーゼフ・ヴィルトら比較的左派寄りの閣僚を外すよう、ブリューニングに圧力をかけようと画策した。しかし党内のほぼ全方面から強い反発を受け、計画を断念した。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 2 and bruning_time and not bruning_event_timer: フーゲンベルクの[? if dnvp_ideology == "Radical": <span style="color: #3E88B3;">**DNVP**</span>?][? if dnvp_ideology == "Moderate": <span style="color: #003755;">**DNF**</span>?]と<span style="color: #7A3C00;">**NSDAP**</span>は、ブリューニング政権に抗議して国会を退場し、<span style="color: #7A3C00;">全国</span> [? if dnvp_ideology == "Radical": <span style="color: #3E88B3;">野党</span>?][? if dnvp_ideology == "Moderate": <span style="color: #003755;">野党</span>?]を形成した。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 2 and saxony_nsdap: サクソン州内閣に対する我々の不信任決議は、ブルジョワ政党の支持を得て成功した。<span style="color: #7A3C00;">ナチス</span>による他の閣僚への度重なる侮辱と誹謗中傷、そしてシュトラッサーの反資本主義的な見解が、ブルジョワ政党との協力を崩壊させた。その結果、我々は政府の安定を維持するために彼らと容認協定を結んだ。 ?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_16_trigger and flavour_16_trigger_time == time: <span style="color: #7FCEB1;">**CNBLP**</span>の国会代表団のメンバー4名が離脱し、全国野党の<span style="color: #7A3C00;">ナチス</span>に加わった。ブリューニング支持派穏健派とブリューニング反対派急進右派の間の内部対立が、党のすでに脆い統一を崩壊させ、自らの有権者からの地位を傷つけた。<span style="color: #7FCEB1;">**CNBLP**</span>は、実行可能な政治勢力としてほとんど消滅した。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 2 and dstp_formed and not lvp_formed and not lvp_merger_2_timer : かつて<span style="color: #D3C24D;">**DDP**</span>に属していたほとんどの地方組織は、新しい党に関わることに極度にためらいを感じており、彼らの青年団や女性団のような多くの<span style="color: #D3C24D;">**DDP**</span>補助組織は崩壊し、再建する必要がある。これらすべてが、経済危機の深化の結果、<span style="color: #D3C24D;">**国家党**</span>の指導者たちがすでに抱えていた重い精神的負担と相まって、党の将来に対する増大する諦めと悲観のムードを生み出している。?]{!</p>!}

{!<p class="both">!}[? if year = 1931 and month = 3 and PLR_launched : <span style="color: #7A3C00;">**NSDAP**</span> はついに、州議会解散の住民投票を支持することに合意した[? if not hitler_deported:, ただしヒトラー自身は、その成功の見込みについて個人的に懐疑的である。 ?]。[? if dnvp_ideology == "Moderate": <span style="color: #3E88B3;">**鉄兜団**</span> と <span style="color: #7A3C00;">**NSDAP**</span> の両方からの支持を得て、<span style="color: #3E88B3;">**DNVP**</span> もそのイニシアチブを支持した。[? if dnvp_leader == "Treviranus":しかし、トレヴィラヌスはためらいが残るものの、それでも党員たちに良心に従って投票することを許した。 ?]?] [? if landtag_ref_dvp: さらに<span style="color: #C0A054;">**DVP**</span>は<span style="color: #7A3C00;">極</span><span style="color: #3E88B3;">右</span>と歩調を合わせ、ディンゲルデーは<span style="color: #c00000;">社会主義</span>との闘争を続けるという党の決意を改めて示した。?]幸いにも、<span style="color: #700000;">**KPD**</span>は、この取り組みにおいて、フーゲンベルクや[+ nsdap_leader +]のような人物と協力することを拒んだ[? if kpd_leader != "Conciliators":, 反民主的な票を分断させた。 ?]。?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 3 and kpd_leader == "Thälmann" : リヒャルト・シェーリンガーは、元国防軍将校であり、<span style='color: #7A3C00;'>**NSDAP**</span>と<span style='color: #7A3C00;'>**SA**</span>の著名なメンバーであったが、軍内に<span style='color: #7A3C00;'>ナチ</span>の細胞を設立しようとしたため投獄された。驚くべきことに、彼の<span style='color: #700000;'>**共産主義**</span>の仲間たちとの広範な議論の後、彼は<span style='color: #700000;'>**KPD**</span>に寝返った。この機会を捉え、<span style="color: #700000;">**KPD**</span>は現在、「シェーリンガー・ライン」と呼ばれるものを採用し、<span style="color: #7A3C00;">ナチ</span>の脱走者を惹きつけるために、より国家主義的なレトリックをメッセージに取り入れている。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_27_trigger and flavour_27_trigger_time == time: 東部援助法は、数ヶ月前に東部の農業企業の債務を軽減するために導入されたが、それがブリューニングの均衡予算維持という目標に真っ向から矛盾するため、連立内に緊張を生じさせている。賠償税は、ヤング計画によりすでに廃止されたにもかかわらず、農業補助金の資金源として使われ続け、[? if not lvp_formed: <span style="color: #C0A054;">**DVP**</span>?][? if lvp_formed: <span style="color: #FFCC00;">**LVP**</span>?] から激しい抗議を引き起こしている。彼らは、この税が主に企業に課せられるものであり、現在の経済危機において雇用創出者にとって不当な負担だと主張する。ブリューニングにとって幸運なことに、[? if budget >= 0: 予算黒字?][? if reparations == -2: 賠償の一時停止?] が、彼が税を廃止しつつも、プログラムへの完全な資金提供を維持することを可能にした。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_28_trigger and flavour_28_trigger_time == time: 東部援助法は、数ヶ月前に東部の農業企業の負債を軽減するために導入されたが、それはブリューニングの均衡予算維持という目標に真っ向から矛盾するため、連立内に緊張を生じさせている。賠償税は、ヤング計画によりすでに廃止されているにもかかわらず、農業補助金の資金源として引き続き使用され、[? if not lvp_formed: <span style="color: #C0A054;">**DVP**</span>?][? if lvp_formed: <span style="color: #FFCC00;">**LVP**</span>?]から激しい抗議を引き起こしている。彼らは、主に企業に課されるこの税は、現在の経済危機を考えると、雇用創出者にとって不当な負担だと主張する。ブリューニングは今や、一方では大産業をなだめ、他方では組織化された農業とヒンデンブルクをなだめるという板挟みになっている。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_26_trigger and flavour_26_trigger_time == time: ブルーニング内閣は、東部農業企業の債務を軽減することを目的とした東部援助法を導入したが、これは多大な財政負担を伴う。この措置は、予算緊縮による経済回復というブルーニングのより広範な戦略と真っ向から矛盾する。政策の資金の一部を賄うため、政府はヤング計画後に時代遅れとなった賠償税を維持している。しかし、債務救済のための完全な資金不足は多くの有力地主を不満にさせ、彼らは自らの苦情を直接ヒンデンブルクに持ちかけ、彼に対してかなりの影響力を行使している。?]{!</p>!}

{!<p class="other">!}[? if flavour_13_trigger and flavour_13_trigger_time == time: ブルーニングが国会とその政党を、自らの財政および経済政策の形成において実質的な役割から外したことは、彼がより嫌悪する政策を阻止する力を持たなかったため、ブルジョワ政党の伝統的な有権者の目からその正当性を著しく損なった。明確な例は、給与が約20パーセントも削減された打撃を受けた公務員の窮状であり、多くの人々を<span style="color: #7A3C00;">ナチ</span>へと追い込んだ。彼のデフレ的かつ緊縮的な措置は経済危機を深め、これらの穏健な政党が選挙支援に頼っていたまさにその社会集団を急進化した。これにより、ブルーニングと彼の支持政党との間に緊張が高まり、中には彼の連立を放棄するとさえ脅しをかけている。?]{!</p>!}

{!<p class="other">!}[? if flavour_14_trigger and flavour_14_trigger_time == time: ブルーニングが、自らの財政および経済政策を緊急令によって統治するのではなく、国会に重要な役割を与えたことは、[? if in_right_coalition or in_center_right_coalition:、?]ブルジョワ政党の伝統的な有権者の目からその正当性を維持するのに役立った。<span style="color: #b8996f;">特別</span> <span style="color: #7FCEB1;">利益</span>、そして<span style="color: #FFCC00;">自由主義</span>政党が、公務員の給与削減のような彼の最も嫌悪する政策の一部を阻止し、彼に農業支援の増額を圧力をかける能力は、彼らの信頼性を強化した。しかし、これはまた、彼が自らの経済計画を適切に実行するためには特定の犠牲が必要だと主張するあまり、ブルーニングと彼の支持政党との間に緊張を引き起こした。?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 4 and PLR_launched : 提案されたプロイセン州議会住民投票の署名収集は終了し、[+ landtag_ref_signatures +]%が請願書に賛成票を投じた。[? if landtag_ref_signatures < 20:したがって、20%の割当により、請願書は否決された。これは我々の民主主義の存続にとってささやかな勝利であり、<span style="color: #7A3C00;">極右</span>-<span style="color: #3E88B3;">右翼</span>の士気を低下させ、資金を浪費させた。?][? if landtag_ref_signatures >= 20:したがって、20%の割当により、請願書は可決された。これは予想外であり、今や我々は<span style="color: #3E88B3;">右翼</span>からの嵐に対抗するため、プロパガンダの戦いを急ぐ必要がある。この住民投票は今月8月に投票される予定だ。?] ?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 4 and thuringia_nsdap: チュルンゲン州内閣のヴィルヘルム・フリックに対する不信任決議は、ブルジョワ政党の支持を得て成功した。<span style="color: #7A3C00;">ナチス</span>によるチュルンゲン州内閣の他のメンバーに対する度重なる侮辱と誹謗は、彼らとのブルジョワの協力を崩壊させた。その結果、我々は現在、ブルジョワとの閣外協力協定にある。?]{!</p>!}

{!<p class="other">!}[? if year == 1931 and month == 4 and dvp_leader == "Dingeldey" and not lvp_formed: <span style="color: #C0A054;">**DVP**</span>の退潮を覆し、<span style="color: #7A3C00;">極</span><span style="color: #3E88B3;">右</span>へのさらなる離党を食い止めるため、党指導部は<span style="color: #7A3C00;">ナチ</span>を手本に新たな宣伝手法を採用した。発表した綱領では、従来の<span style="color: #FFCC00;">自由主義</span>的目標を<span style="color: #7A3C00;">極</span><span style="color: #3E88B3;">右</span>の言葉で言い換えている。たとえば個人の権利について、<span style="color: #C0A054;">**DVP**</span>は、信仰と宗教心に根差した人格を持つ者と定義される「倫理的責任を負う個人」の権利を、<span style="color: #700000;">革命</span>、<span style="color: #c00000;">社会主義</span>、唯物論から守ると約束した。これは、シュトレーゼマン党首時代を特徴づけた<span style="color: #FFCC00;">自由主義</span>原則の率直な擁護からの明白な後退である。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 4 : アルフォンソ13世の王制に取って代わり、第二共和政が樹立された。これは、共和派候補が大きな勝利を収め、41の全州都で勝利を収めた地方選挙の結果である。これにより国王は亡命を余儀なくされ、新しく若き共和国が誕生した。?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 5 and kpd_leader == "Thälmann" and kpd_relation < 40 : <span style="color: #D50000;">コミンテルン</span>の命令の下、<span style="color: #700000;">**KPD**</span>は、ヒトラーの<span style="color: #7A3C00;">ファシズム</span>を主要な敵と見なすという以前の立場を放棄した。彼らは今や、「<span style="color: #7A3C00;">ファシズム</span>の評価を適切な比率に減らす」ことによって立場を「是正」していると主張し、これは彼らの<span style="color: #c00000;">社会</span> <span style="color: #7A3C00;">ファシスト</span>の立場への回帰を意味する。彼らにとって、我々は実際の<span style="color: #7A3C00;">ファシスト</span>と何ら変わらない。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1931 and month = 6 and dnvp_ideology == "Radical": フーゲンベルクのヒトラー的なカリスマ性を養おうとする試みは失敗した。彼の上流階級のエリート主義と傲慢さが、経済危機に苦しむ一般大衆から彼を乖離させているからだ。カリスマ性の欠如に苛立ちを感じた一部の実業家たちは、彼が<span style="color: #3E88B3;">**DNVP**</span>を破滅に導いていると確信し、彼を失脚させるための多額の報酬さえ申し出ている。さらに、経済不況が彼のメディア帝国からの歳入を激減させ、党を維持するためだけに<span style="color: #3E88B3;">**DNVP**</span>の予算を30％削減せざるを得なくなっている。?]{!</p>!}

{!<p class="other">!}[? if banking_crisis_timer == 3 : オーストリア・ドイツ関税同盟の樹立が、<span style="color: #002654;">フランス</span>にオーストリアに対して大きな経済的圧力をかけるきっかけとなった。オーストリア経済に対するその大きな影響力を利用し、<span style="color: #002654;">フランス</span>は、苦境にある国の主要銀行への財政支援を拒否するだけでなく、多額の資金を意図的に引き揚げ、オーストリアの金融部門をさらに不安定にさせている。?]{!</p>!}

{!<p class="other">!}[? if banking_crisis_timer == 2 : 主要なオーストリア銀行クレディタンシュタルトが、オーストリア・ドイツ関税同盟の計画を弱体化させることを目的とした<span style="color: #002654;">フランス</span>の政治的・経済的圧力を受けて破産を宣言した。その点においては、彼らは確かに成功した。我々が望めるのは、この危機がドイツに波及したり、さらにはヨーロッパ全土に広がることはないようにということだけだ。?]{!</p>!}

{!<p class="other">!}[? if banking_crisis_timer == 1 : クレディタンシュタルトの破綻に続き、国際金融市場は動揺し、投資家たちはドイツの銀行から急速に資金を引き揚げている。ドイツが短期の外国融資に大きく依存していたことが、オーストリアの銀行危機を我々自身の安定に対する直接的な脅威に変えた。これに対応し、ライヒスバンク総裁の[? if luther_reichsbank:ハンス・ルーター?][? if not luther_reichsbank:フリードリヒ・ドレゼ?]は、海外への資金移動を抑制するインセンティブを設けることで資本逃避を抑える措置を講じた。しかし、これらの政策の有効性は不確かであり、意図しない結果を招く可能性がある。?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month == 6 and not kaas_explode_seen and z_leader == "Kaas": <span style="color: #000000;">中央党</span>の指導者ルートヴィヒ・カーズが辞任する意向を示しているという噂が流れている。彼は個人的にその重荷な地位から降りることを望んでいる。彼の頻繁なドイツ国外滞在、特にローマでの滞在は、副指導者のユースと国会指導者のブリューニングに事実上党の運営を任せてきた。カーズは国会での出席記録も最悪な部類に入る。しかし、カーズは長期の不在を健康上の問題によるものだと説明し、同僚たちに与えたかなりの自主性が、より活動的だが物議を醸す指導者による交代の動きを鎮静化させている。?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 6 and dstp_formed and not lvp_formed and not lvp_merger_2_timer : <span style="color: #D3C24D;">**[+ ddp_name +]**</span>の組織的な病理は、その減少する会員数に明らかである。全国的に見て、1930年夏に<span style="color: #D3C24D;">**DDP**</span>に所属していた人々の30%から60%が、今年同じ時期までにその後継組織に加わっていない。一部の都市部では、党が右派に傾いたことで、かつての支持層の半分以上を失ったと推定されている。強力な自由主義の伝統を持たない州では、状況はあまりに深刻で、昨年<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の樹立をかつて擁護していた地方支部でさえ、敗北を認め、党を完全に解体することをほぼ推奨している。?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 6 : 第二次スペイン共和国の初めての選挙が行われ、<span style="color: #EF1C27;">スペイン社会主義者</span>と<span style="color: #E25822;">共和派左翼</span>が大きな勝利を収めた。彼らは共にマヌエル・アサニャを首相とする政府を樹立した。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_20_trigger and flavour_20_trigger_time == time: <span style="color: #b8996f;">**WP**</span>の指導者たちは、ドロイッツとコロサーの間の対立によって引き起こされた損害を必死に修復しようとしているが、その努力はドロイッツの辞任を求める新たな要求によって繰り返し妨げられている。これに対し、ドロイッツはこの月、全国党大会で自身の件を提起した。党内のブリューニング支持派からの強い支持を背景に、彼は党委員長としての再選を成功させた。一方、数ヶ月前に離脱したいくつかの地区組織の指導者たちは、大会に間に合うように再び党の懐に戻ってきた。もしかすると、党は生き残れるのだろうか？ ?]{!</p>!}

{!<p class="other">!}[? if flavour_22_trigger and flavour_22_trigger_time == time: [+ dvp_leader +]と<span style="color: #C0A054;">**DVP**</span>右派は、新税と公務員給与削減を含むブリューニングの緊急令に激怒している。[+ dvp_leader +]は<span style="color: #c00000;">**SPD**</span>との関係をすべて断ち、政権へのブルジョワ層の信頼を回復するようブリューニングに強く迫った。圧力をかけるため、[+ dvp_leader +]は国会再開に賛成し、彼らの支持で「<span style="color: #7A3C00;">国民</span><span style="color: #3E88B3;">野党</span>」に不信任決議を提出させると脅した。この動きは、かねて内閣改造を求めてきた<span style="color: #C0A054;">**DVP**</span>右派の強い支持を得た。しかし議員団内の支持は僅差の過半数にすぎず、ブリューニングは、[? if luther_reichsbank: ライヒスバンク総裁である?][? if not luther_reichsbank: 元首相である?]<span style="color: #C0A054;">**DVP**</span>党員ハンス・ルターとともに、右傾化と労働法緩和を段階的に進めると約束し、忍耐を求めた。この確約と、クルティウスら党内左派の要人による辞任の威嚇を受け、議員団は最終的に方針を撤回した。 ?]{!</p>!}

{!<p class="other">!}[? if flavour_34_trigger and flavour_34_trigger_time == time: [+ dvp_leader +] および <span style="color: #C0A054;">**DVP**</span> の右翼は、ブリューニングの緊急政令、新たな税金と公務員の給与削減を批判し、激怒している。[+ dvp_leader +]は、ブリューニングに対し、すべての関係を<span style="color: #c00000;">**SPD**</span>と断ち切ることで、政府に対するブルジョワの信頼を回復するよう強く促した。この動きは、内閣改造を長年主張してきた<span style="color: #C0A054;">**DVP**</span>の右翼から大きな支持を得た。これに対し、ブリューニングは、[? if luther_reichsbank:のドイツ銀行総裁?][? if not luther_reichsbank:、元首相?]、そして<span style="color: #C0A054;">**DVP**</span>のメンバーのハンス・ルーテルと共に、内閣再編における右への移行と労働法の緩和を約束し、忍耐を求めた。これらの保証により、[+ dvp_leader +]はもはや政府を倒すための活動をしていない。?]{!</p>!}

{!<p class="other">!}[? if flavour_38_trigger and flavour_38_trigger_time == time: [? if lvp_leader == "Dingeldey":ディンゲルデーと<span style="color: #FFCC00;">**LVP**</span>の右翼は、ブリューニングの緊急令に失望し、新たな税金と公務員給与の削減を批判している。ディンゲルデーは個人的に、ブリューニングに対し、我々の票への依存を終わらせるために<span style="color: #7A3C00;">の国会</span>の<span style="color: #3E88B3;">野党</span>と連立を組むよう促した。しかし、彼が党の過半数を説得してブリューニングに反対させることは不可能であり、そのため、彼は計画を実行できないままである――少なくとも今のところはだ。?][? if lvp_leader != "Dingeldey":<span style="color: #FFCC00;">**LVP**</span>は、ブリューニングの緊急令に失望し、新たな税金と公務員給与の削減を批判している。党の右翼の一部は、我々の票への依存を終わらせるために<span style="color: #7A3C00;">の国会</span>の<span style="color: #3E88B3;">野党</span>と連立を組むようブリューニングに促した。しかし、[+ lvp_leader +]とより広範な党は、彼の政府に対して概ね支持を維持しており、中産階級を害する政策から彼を遠ざけるよう働きかけを続けるだろう。?] ?]{!</p>!}

{!<p class="other">!}[? if flavour_42_trigger and flavour_42_trigger_time == time: ディンゲルディーと<span style="color: #FFCC00;">**LVP**</span>の右翼は、ブリューニングの緊急政令に失望しており、新たな税金と公務員給与の削減を批判している。ディンゲルディーは個人的に、彼が我々の票に頼るのを終わらせるため、<span style="color: #7A3C00;">全国</span>の<span style="color: #003755;">野党</span>[? if spd_toleration_right:&nbsp;と連立するようブリューニングに強く求めた?]。しかし、彼は<span style="color: #3E88B3;">**DNVP**</span>の含まれたため、自身の政府に概ね満足している。?]{!</p>!}

{!<p class="other">!}[? if flavour_45_trigger and flavour_45_trigger_time == time:<span style="color: #FFCC00;">**LVP**</span>は、これまでのブリューニングの緊急令に失望し、新たな税金と公務員給与の削減を批判している。党の右派の間では、ブリューニングが<span style="color: #7A3C00;">の国会</span>の<span style="color: #003755;">野党</span>と連立を組むべきだという声が高まっている。[? if spd_toleration_right:&nbsp;が我々の票への依存を終わらせるため?]. しかし、党は依然として彼の政府に概ね満足しており、特に<span style="color: #3E88B3;">**DNVP**</span>の参加があったためだ。[? if not spd_toleration_right:,事実上、我々を野党に釘付けにした。?]. ?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_51_trigger and flavour_51_trigger_time == time: クルト・フォン・シュライヒャーは、当初ヒンデンブルクにブリューニングの任命を説得した人物だが、今や懐疑的である。特に銀行危機の後、ブリューニングがドイツの大国としての地位を回復するために必要な広範な改革を実行できるのかどうかについてだ。その結果、シュライヒャーは反議会派の右派との繋がりを築こうとしている。?]{!</p>!}

{!<p class="other">!}[? if flavour_24_trigger and flavour_24_trigger_time == time:銀行危機[? if emergency_decree_seen:&nbsp;とブリューニングの二度目の緊急令による余波は?]ブルジョワジー政党の間、特に<span style="color: #C0A054;">**DVP**</span>の間で反ブリューニング感情を著しく高めた。[? if emergency_decree_seen:, この政党はブリューニングを支持するために自党内でもかろうじて過半数を確保したにすぎない。?]<span style="color: #C0A054;">**DVP**</span>の右翼は、ブリューニングが内閣をさらに右に傾けるという約束を守らなかったことにますます不満を抱いている。しかし、[+ dvp_leader +]は、それがドイツの財政状況をさらに不安定にすると恐れ、政府を倒すことにためらいを抱いている。さらに、<span style="color: #7A3C00;">の全国的な</span> <span style="color: #3E88B3;">野党</span>は、ブリューニングの内閣に参加する関心を示していない。このような状況下で、<span style="color: #C0A054;">**DVP**</span>は、ブリューニングの支持を続ける以外に選択肢がない。 ?]{!</p>!}

{!<p class="other">!}[? if flavour_57_trigger and flavour_57_trigger_time == time:銀行危機[? if emergency_decree_seen:とブリューニングの二度目の緊急令による余波。?]ブルジョワジー政党の間、特に<span style="color: #C0A054;">**DVP**</span>の間で反ブリューニング感情を著しく高めた。[? if emergency_decree_seen:, この政党はブリューニングを支持するために自党内でもかろうじて過半数を確保したにすぎない。?]. この党の右翼は、約束した通りに内閣をさらに右に傾けるというブリューニングの失敗にますます不満を抱いている。しかし、[+ dvp_leader +]は、そのような動きはドイツの脆弱な財政状況をさらに不安定にするだけであり、<span style="color: #7A3C00;">の全国的な</span> <span style="color: #3E88B3;">野党</span>は政府入りを認めないと主張する。不満があるにもかかわらず、<span style="color: #C0A054;">**DVP**</span>は、今のところ、ブリューニングの支持を続ける以外に選択肢がない。 ?]{!</p>!}

{!<p class="other">!}[? if flavour_40_trigger and flavour_40_trigger_time == time: [? if lvp_leader == "Dingeldey": 銀行危機とそれに続く緊縮財政措置は、<span style="color: #FFCC00;">**LVP**</span>がブリューニング政権に対する認識を悪化させ、彼ら自身の指導者[+ lvp_leader +]に、そもそも破滅的なオーストリア・ドイツ関税同盟の立案者であったにもかかわらず、彼を批判する公の声明を出させた。<span style="color: #FFCC00;">**LVP**</span>のかなりの部分は、政権との完全な決別には依然として反対しており、特に<span style="color: #D3C24D;">**[+ ddp_name +]**</span>出身者もそうだ。?][? if lvp_leader != "Dingeldey": 銀行危機とそれに続く緊縮財政措置は、<span style="color: #FFCC00;">**LVP**</span>がブリューニング政権に対する認識を悪化させた。彼ら自身のジュリス・クルティウスがそもそも破滅的なオーストリア・ドイツ関税同盟の立案者であったにもかかわらずだ。<span style="color: #FFCC00;">**LVP**</span>内の急進右翼の産業家や民主主義懐疑論者の一部は、政権との完全な決別を主張しているが、現時点ではノイズに過ぎない。?] ?]{!</p>!}

{!<p class="other">!}[? if flavour_44_trigger and flavour_44_trigger_time == time: 銀行危機とそれに続く緊縮財政措置は、<span style="color: #FFCC00;">**LVP**</span>がブリューニング政権に対する認識をさらに悪化させ、彼らの指導者ディンゲルデーに、彼ら自身のジュリス・クルティウスが破滅的なオーストリア・ドイツ関税同盟の立案者であったという事実にもかかわらず、公然と彼を批判するよう促した。<span style="color: #FFCC00;">**LVP**</span>内の急進右翼の産業家や民主主義懐疑論者の一部が政権との完全な決別を主張しているが、それはノイズに過ぎない。?]{!</p>!}

{!<p class="other">!}[? if flavour_46_trigger and flavour_46_trigger_time == time: 銀行危機とそれに続く緊縮財政措置は、<span style="color: #FFCC00;">**LVP**</span>がブリューニング政権に対する認識をさらに悪化させたが、[+ lvp_leader +]はブリューニング[? if lvp_leader != "Heuss" and lvp_leader != "Luther":の確固たる支持者であり続け、ブリューニング政権内で自身が[? if lvp_leader != "Dietrich":大臣を務め、さらにはブリューニング自身に?][? if lvp_leader == "Dietrich":副首相を務めている。?]?]。<span style="color: #FFCC00;">LVP</span>内の急進右翼の産業家や民主主義懐疑論者の一部が政権との完全な決別を主張しているが、それはノイズに過ぎない。?]{!</p>!}

{!<p class="other">!}[? if flavour_36_trigger and flavour_36_trigger_time == time: 銀行危機[? if emergency_decree_seen:&nbsp; とブリューニングの第2次緊急令による余波?][? if emergency_act_seen:&nbsp; およびブリューニングの緊急措置による余波?] は、ブルジョワ政党、特にすでに彼の行動に不満を抱いていた<span style="color: #C0A054;">**DVP**</span>[? if emergency_decree_seen:の間で反ブリューニング感情を強めている?][? if emergency_act_seen:、また、支持政党との協議不足にすでに不満を抱いていた?]。しかし、[+ dvp_leader +] は、ドイツの財政状況をさらに不安定にさせることを恐れ、政府を倒すことにためらいを抱いている。さらに、<span style="color: #7A3C00;"> の全国的な</span> <span style="color: #003755;"> 野党</span> は、依然としてブリューニング内閣に参加する関心を示していない。このような状況下で、<span style="color: #C0A054;">**DVP**</span> は、ブリューニングの支持を続ける以外に選択肢がない。?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month == 7 and landtag_ref_signatures_passed and not landtag_ref_dvp and not lvp_formed: <span style="color: #C0A054;">**DVP**</span>は、プロイセン州議会住民投票に予期せぬ形で反対の立場を取り、安定と民主主義を支持する運動を展開した。この動きは、住民投票を支持する統一右翼戦線を目指していた<span style="color: #3E88B3;">**鉄兜団**</span>の計画を混乱させ、その成功の可能性を著しく低下させた。?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month == 7 and landtag_ref_votes and landtag_ref_dvp and not lvp_formed: <span style="color: #C0A054;">**DVP**</span>の残存する影響力のある左派メンバーは、党がプロイセン州議会住民投票を強く支持したことを非難した。中には、住民投票を支持しないことを「愛国的な義務」と呼ぶ者さえいる。クールティウスはラジオで演説し、自身は党の住民投票に関する立場に従わないと発表した。残念ながら、党内の親民主主義勢力は無力で無能だが、少しでも良いことはある。?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month == 8 and blutmai:ベルリンの<span style="color: #700000;">**KPD**</span>は、警察に殺害された<span style="color: #700000;">**KPD**</span>党員一人につきベルリンの警察官一人を殺害するという報復暗殺方針を採用した。この方針にもとづき、警察大尉パウル・アンラウフとフランツ・レンクが、エーリヒ・ミエルケとエーリヒ・ツィーマーによって暗殺された。犯人を特定し得た三人目の警察官の殺害には失敗したため、二人は危険を避けて直ちにモスクワへ逃亡した。この事件は<span style="color: #700000;">共産主義者</span>に対する広範な憤激を引き起こし、ブルジョワ層では共産主義運動の速やかな弾圧を求める声が再び高まっている。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_21_trigger and flavour_21_trigger_time == time: <span style="color: #b8996f;">**WP**</span>の指導者ヘルマン・ドロイッツをめぐるスキャンダルは、数ヶ月前に起こったものよりもさらに深刻な離脱を防ぐため、ついに彼に党首職の辞任を強いた。[? if not lvp_formed:の多くの国会議員、オットー・コロッサーを含む者たちが、彼らの内部対立を利用しようとしている<span style="color: #D3C24D;">**[+ ddp_name +]**</span>に寝返った。?]継続的な内部抗争と最も有能な指導者たちの辞任により、<span style="color: #b8996f;">**WP**</span>はもはや政治勢力として機能するのがやっとの状態だ。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_31_trigger and flavour_31_trigger_time == time: <span style="color: #b8996f;">**WP**</span>の指導者ヘルマン・ドロイッツと彼のスキャンダルをめぐる論争は、彼が会長職を辞任し、尊敬されるヨハン・ブレヒトに引き継いだことでついに収まった。この動きは、オットー・コロッサーと反抗的な地方組織を再び懐に入れた。内部抗争や度重なる分裂を乗り越え、<span style="color: #b8996f;">**WP**</span>は国家的な勢力として生き残り、そうでなければ<span style="color: #7A3C00;">**NSDAP**</span>に流れたかもしれない保守的な中産階級を代表し続けている。?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_37_trigger and flavour_37_trigger_time == time: <span style="color: #3E88B3;">**DNVP**</span> は、銀行危機後のブリューニング内閣への継続的な支持を理由に、<span style="color: #7A3C00;">の国粋的な </span> <span style="color: #003755;">野党</span>から激しい批判を浴びており、<span style="color: #003755;">**DNF**</span> は、幻滅した <span style="color: #3E88B3;">国粋主義者</span>の支持を得ようとしている。これは党内に大きな懸念を引き起こしている。なぜなら、彼らは[? if dnvp_votes >= nsdap_votes:&nbsp;と脅かす?] より急進的な<span style="color: #7A3C00;">**NSDAP**</span>に覆い隠され、その台頭は<span style="color: #3E88B3;">**DNVP**</span>の産業支援者たちを、ブリューニングに<span style="color: #7A3C00;">極</span><span style="color: #003755;">右</span>を政府に組み入れるよう圧力をかけるに至った。 ?]{!</p>!}

{!<p class="dnvp">!}[? if flavour_52_trigger and flavour_52_trigger_time == time: <span style="color: #7A3C00;">**NSDAP**</span>が<span style="color: #3E88B3;">**DNVP**</span>を犠牲にして急速に台頭したことは、党の多くのメンバーに懸念を引き起こしている。彼らは、自分たちの衰退の原因を不人気なブリューニング政権との関連性に求め、失われた支持を取り戻すためには、<span style="color: #7A3C00;">の全国的な</span> <span style="color: #003755;">野党</span>との関係を深めることが極めて重要だと考えている。その結果、多数の<span style="color: #3E88B3;">**DNVP**</span>のメンバーがブリューニング首相を公然と批判し始め、全国的な野党との連立を積極的に推進している。これは彼の内閣の将来の安定にとって良い兆しではない。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month == 9 and banking_crisis_seen: オーストリア・ドイツ関税同盟は公式に崩壊し、国際法廷がこの計画を無効にした。[? if foreign_minister_party == "DVP": この計画の立案者である<span style="color: #C0A054;">**DVP**</span>のユリウス・クルティウスは、自身の党内から辞任を求める声が高まり、評判に大きな打撃を受けた。[? if bruning_toleration_time and dvp_ideology == "Right": 彼が辞任すれば、<span style="color: #C0A054;">**DVP**</span>は内閣での議席を失い、ブリューニングに対する不信任投票を支持する自由を得るだろう。?]?]?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 9 : イギリスは金本位制を放棄した！給与カットによる短命な海軍の反乱がロンドン証券取引所にパニックを引き起こし、ポンドへの取り付け騒ぎを招いた。英国政府はその後、ポンドの切り下げによって達成されるデフレの有害な副作用なしに、産業輸出を刺激する手段としてこの政策を採用した。ドイツのトップ経済専門家たちは、これをイングランドの銀行や保険会社を破綻させる絶望的な行為と見なした。ドイツ国民は、ヤング計画の下でマルクの価値を純金0.358グラムに維持する義務とインフレへの恐れから、ライヒスバンク総裁の[? if luther_reichsbank: ルーター?][? if not luther_reichsbank: ドライゼ?] が金本位制を放棄することを防いできた。しかし、米国と英国の両方が我々のより柔軟な規制を求める要望に同情を示したことで、結局この決定は経済的な根拠に基づいていたのかもしれない。?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 9: 日本は満州を侵略した。?]{!</p>!}

{!<p class="other">!}[? if flavour_41_trigger and flavour_41_trigger_time == time: オーストリア・ドイツ関税同盟計画の失敗とその悲惨な結果を受け、計画の立案者である[? if not lvp_formed and dvp_exist:<span style="color: #C0A054;">**DVP**</span>?][? if not lvp_formed and not dvp_exist:<span style="color: #D3C24D;">**[+ ddp_name +]**</span>?][? if lvp_formed:<span style="color: #FFCC00;">**LVP**</span>?]は責任を取り辞任した。これは、カーティウスが彼の最も強力な支持者の一人であったため、ブリューニング政権の安定性を著しく弱めた。今や、ブリューニングが外務大臣を引き継いだことで、[? if not lvp_formed:<span style="color: #C0A054;">**DVP**</span>?][? if not lvp_formed and not dvp_exist:<span style="color: #D3C24D;">**[+ ddp_name +]**</span>?][? if lvp_formed:<span style="color: #FFCC00;">**LVP**</span>?]は、彼の政権を支持する理由が少なくなった。[? if dvp_leader == "Curtius" or lvp_leader == "Curtius" and lvp_formed: さらに、カーティウスは党の指導的地位からも辞任し、右翼勢力が彼に取って代わるか、[? if not lvp_formed:<span style="color: #C0A054;">**DVP**</span>?][? if lvp_formed:<span style="color: #FFCC00;">**LVP**</span>?]の指導者として期待されている。なぜなら、党内ではブリューニング支持派が弱体化しているからだ。?] ?]{!</p>!}

{!<p class="other">!}[? if year == 1931 and month == 10 and not bourgeois_list and not bourgeois_parliament and (dnvp_split_2 or kvp_formed) and dvp_leader == "Dingeldey" and not lvp_formed and not lvp_merger_2_timer: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、問題に実質的な対応を取る気のないディンゲルデー率いる<span style="color: #C0A054;">**DVP**</span>ではなく、穏健右派諸党に接触した。この動きは、<span style="color: #7A3C00;">極</span><span style="color: #3E88B3;">右</span>に政治的に壊滅させられることへの共通の恐れと[? if bruning_toleration_time:、ブリューニングの立法方針に影響を及ぼす狙い?]から出たものだ。ハンス・シュランゲ＝シェーニンゲンは、[? if not bruning_toleration_time: ブルジョワ統一の最も強力な支持者の一人であり?][? if bruning_toleration_time: ブリューニングの最も強力な支持者の一人であり?]、[? if not kvp_formed: <span style="color: #7FCEB1;">**CNBLP**</span>?][? if kvp_formed: <span style="color: #0087DC;">**KVP**</span>?][? if cnblp_defect:（その後ブリューニングから離反した）?]に属する。彼はヴェスタープ[? if csvd_formed:、<span style="color: #8ED8E4;">**CSVD**</span>?]、そして<span style="color: #C0A054;">**DVP**</span>の一部代表に対し、相違を脇に置くよう訴えた。[? if bruning_toleration_time: ブリューニングの強い後押しを受け、彼らは国会で政権支持を確認する共同声明を出すことに合意した。しかし計画が漏洩し、複数政党が協議から離脱したため、断念を余儀なくされた。?]?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 10: 最近の英国総選挙は、同国史上最大の圧勝をもたらし、<span style="color: #f0456a;">労働党</span>はわずか52議席しか得られず、前回選挙から235議席を失った。それにもかかわらず、現職の<span style="color: #008000;">国民労働</span>首相ラムゼイ・マクドナルドは政権を維持し、<span style="color: #0087DC;">保守党</span>と共に統治している。?]{!</p>!}

{!<p class="other">!}[? if flavour_47_trigger and flavour_47_trigger_time == time: [? if year == 1931 and month >= 11:ヘッセン州議会選挙運動の最中に?][? if year != 1931 or month < 11:地方選挙の運動中に?], ディンゲルディーはヒトラーに、自分たちの党が<span style="color: #000000;">ヴァ</span><span style="color: #DD0000;">イマ</span><span style="color: #FFCC00;">ル</span>の連立政権の党たちに対して、互いに攻撃することを控えて、統一戦線を示すよう提案した。彼らの<span style="color: #7A3C00;">極</span><span style="color: #3E88B3;">右</span>への転換は、[? if dvp_defect:ブリューニング内閣からの離脱と相まって、?]この動きは党内左派を奮起させ、指導者の名を取った「クンツ＝ドーナ」グループのもとへ結集させた。彼らの目標は、<span style="color: #C0A054;">**DVP**</span>を故シュトレーゼマン党首の政治路線へ戻し、<span style="color: #7A3C00;">国民</span><span style="color: #3E88B3;">野党</span>との提携から遠ざけることにある。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 12 and (reparations == -2 or hoover_moratorium_seen) and bruning_time: ブリューニングは外交問題においてますます積極的な役割を果たすようになり、債務の一時停止後であっても、政府が経済の完全崩壊を防ごうとする試みによって賠償金を支払う余地がほとんど残されていないことを理由に、西側連合国を説得し、ドイツの賠償負担の再検討に成功した。「ベネデューチェ報告書」は専門銀行家チームによって作成され、ドイツが近い将来賠償金を支払う余裕がないだけでなく、債務負担を減らすための積極的な努力が必要であると結論付けた。外交的攻勢を通じて、ドイツの行動の余地を劇的に拡大する合意に至った。?]{!</p>!}

{!<p class="other">!}[? if flavour_59_trigger and flavour_59_trigger_time == time: 首相[+ chancellor +]は、<span style="color: #7A3C00;">**NSDAP**</span> を政府に組み込む試みから公然と距離を置いた。彼は、彼らの合法的な道へのコミットメントに疑問を呈した。これは、ブリューニングがフーゲンベルクを迂回し、ヒトラーと直接交渉しようとしたことで知られるブリューニング＝ヒトラー同盟となった後のことである。ブリューニングと<span style="color: #7A3C00;">**NSDAP**</span>のヒトラーとシュトラッサーの間の会談は、両者が和解に真に興味を持っていることを示唆し、ブリューニングは批判の矛先をヒトラーからフーゲンベルクへと向け直したことさえあった。幸いなことに、これらの会談は崩壊した。なぜなら、<span style="color: #7A3C00;">ナチ</span>の選挙での獲得票が、権力への道がブリューニングを通るものではないと彼らに確信させたからである。?]{!</p>!}

{!<p class="other">!}[? if flavour_48_trigger and flavour_48_trigger_time == time: ディンゲルデーが<span style="color: #C0A054;">DVP</span>の産業派に対抗しようとしないため、共和国成立以来一貫して党を支持してきたホワイトカラー労組DHVとの関係が悪化した。団体交渉における労組の役割を認めない彼の姿勢により、DHVは軽視されていると感じ、党との将来を疑問視している。クンツ＝ドーナ・グループは今月の幹部会で懸念を提起したが、ブリューニングを明確に非難する決議への反対が344票中14票にとどまり、その孤立と無力さが露呈した。同グループは、同じ会合で[? if dnvp_ideology == "Moderate":党?][? if dnvp_ideology == "Radical":フーゲンベルク率いる党?]の<span style="color: #3E88B3;">**DNVP**</span>との合併を唱えた極右派に続き、離党を検討している。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1931 and month = 12 : 新しい第二共和政が新しい民主憲法を採択し、世俗的で進歩的、共和制の政府を樹立した。スペインの時は明るい見通しだ。?]{!</p>!}

{!<p class="other">!}[? if flavour_49_trigger and flavour_49_trigger_time == time: 党執行部会議で極右勢力が勝利して以来、ディンゲルダイには、<span style="color: #7A3C00;">国民派</span><span style="color: #3E88B3;">野党</span>の諸党との関係強化を求める圧力が高まっている。党の<span style="color: #3E88B3;">**鉄兜団**</span>連絡担当エーリヒ・フォン・ギルザは、ディンゲルダイに地方党組織の指導者との会合を強いた。党を[? if dnvp_ideology == "Moderate":穏健派の?][? if dnvp_ideology == "Radical":フーゲンベルクの?]<span style="color: #3E88B3;">**DNVP**</span>との関係強化、さらには合併へと向かわせるためである。[? if dnvp_ideology == "Radical": これまでディンゲルダイは、フーゲンベルクが<span style="color: #C0A054;">**DVP**</span>の完全吸収以外には満足しないと主張し、こうした動きに抵抗してきた。?][? if dnvp_ideology == "Moderate": ブルジョワ諸党の得票率が低下する中、この選択肢はかなり魅力的に映り、両党間の交渉が始まっている。?] ?]{!</p>!}

# make version for if dvp never split cuz of many reasons

{!<p class="other">!}[? if flavour_50_trigger and flavour_50_trigger_time == time: エリヒ・フォン・ギルザが、ディンゲルデーが<span style="color: #C0A054;">**DVP**</span>との合併に関心を示さないことへの抗議として、<span style="color: #3E88B3;">**DNVP**</span>を辞任した。これにより一連の事態が引き起こされ、多くの地方区組織や党の極右派の主要指導者が辞任し、<span style="color: #3E88B3;">**DNVP**</span>に寝返った。[? if bruning_time:さらに、国会が再開した際、ディンゲルデーは党規律を押し付けようとし、代表団にブリューニングに満場一致で反対票を投じるよう強要し、左派で最も尊敬されていた広報担当者であるクルティウスとジークフリート・フォン・カルドルフを追放させた。?]<span style="color: #C0A054;">**DVP**</span>はもはや実行可能な国家的な政治勢力ではないと言って差し支えない。?]{!</p>!}

{!<p class="dnvp">!}[? if year = 1932 and month = 3 and dnvp_ideology == "Radical" and presidential_election_seen: 大統領選挙での最近の出来事、そしてフーゲンベルクの最も近しい同盟者たちが<span style="color: #7A3C00;">**NSDAP**</span>に裏切られたことは、彼を深く意気消沈させ、諦め寸前だ。党内では、多くの者がその衰退する運命を救おうと、新しい指導者への呼びかけが大きくなっている。しかし、フーゲンベルクはフーゲンベルクだ。彼が最後だとは思えない。?]{!</p>!}

{!<p class="other">!}[? if flavour_53_trigger and flavour_53_trigger_time == time: [? if dnvp_leader == "Lambach": <span style="color: #C0A054;">の**DVP**の</span>と<span style="color: #3E88B3;">の**DNVP**の</span>の間の交渉は、ラムバッハの<span style="color: #6D5298;">キリスト教社会</span>と自由主義的でない理想が、ほぼ全ての問題で<span style="color: #C0A054;">の**DVP**の</span>と衝突しているため、これまでのところ失敗している。しかし、<span style="color: #C0A054;">の**DVP**の</span>内の急進的右派派は、合併が<span style="color: #3E88B3;">の**DNVP**の</span>内の指導部の変更を強いる可能性があると信じ、より緊密な関係を推し進めている。?][? if dnvp_leader != "Lambach": <span style="color: #C0A054;">の**DVP**の</span>と<span style="color: #3E88B3;">の**DNVP**の</span>の間の交渉は進展し、両党間のさらなる協力を生んでいる。彼らの得票率の低下とイデオロギー的な類似性を認識し、次回の選挙で共同リストでの出馬に合意した。[? if dnvp_leader == "Treviranus": トレヴィラヌスは、民主的なブルジョワ右派の統合を長年求めてきたため、特にブルジョワジーの協力強化を支持している。?][? if dnvp_leader == "Schiele": シーレの農民保守主義は、<span style="color: #C0A054;">の**DVP**の</span>の産業資本主義と衝突し、党の支持者たちの間に不安を引き起こしている。彼らは、より広範な党の中で自分たちの影響力が希薄化するのではないかと恐れている。?][? if dnvp_leader == "Hergt" or dnvp_leader == "Westarp": [+ dnvp_leader +]は、提案された合併に対して懐疑的な見方を示し、<span style="color: #C0A054;">の**DVP**の</span>が右に傾いたにもかかわらず、君主制や「[? if reparations >= 0: 賠償金」といった問題において根本的な違いが残っていると主張している。?][? if reparations == -2:「国家問題」?]. ?]?] ?]{!</p>!}

{!<p class="other">!}[? if year = 1932 and month = 4 and pro_republic < 50 and dvp_exist and (luther_reichsbank or dvp_leader == "Luther" or (lvp_leader == "Luther" and lvp_formed)): ハンス・ルーテルが射撃された！幸いにも、肩を負傷しただけで、彼は[? if luther_reichsbank:ライヒス銀行?][? if dvp_leader == "Luther" or (lvp_leader == "Luther" and lvp_formed):の総裁として、[? if not lvp_formed:<span style="color: #C0A054;">**DVP**</span>?][? if lvp_formed:<span style="color: #FFCC00;">**LVP**</span>?]?]の指導者としての職務を続けることができるだろう。[? if luther_reichsbank: 襲撃者たちは事前に手紙を残しており、彼の金融政策?][? if dvp_leader == "Luther" or (lvp_leader == "Luther" and lvp_formed):を批判している。襲撃者たちは事前に手紙を残しており、彼が[? if not lvp_formed:<span style="color: #C0A054;">**DVP**</span>?][? if lvp_formed:<span style="color: #FFCC00;">**LVP**</span>?]?]を指導してきたことを批判している。?]{!</p>!}

{!<p class="other">!}[? if year = 1932 and month = 5 and not lvp_formed and not bourgeois_parliament and not bourgeois_list and liberal_vote < 5 and dvp_exist: ブルジョワおよび自由主義政党が<span style="color: #7A3C00;">ナチ</span>運動の前に崩壊したことで、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>と<span style="color: #C0A054;">**DVP**</span>の指導部は、自分たちの党、そして自由主義全般が過去の残骸であり、新しい統一されたブルジョワ党が灰の中から出現するために、できるだけ早く死ぬことが愛国的な義務だと確信している。[? if dvp_leader == "Dingeldey": 現在の状況にもかかわらず、<span style="color: #C0A054;">**DVP**</span>は依然として自分たちの条件での統一を要求する。?] ?]{!</p>!}

{!<p class="other">!}[? if year = 1932 and month = 5 : オーストリア政府は、最近の地方選挙におけるオーストリアの<span style="color: #7A3C00;">**NSDAP**</span>の大きな躍進により辞任し、エンゲルベルト・ドルフフが大統領によって首相に任命された。ドルフフは現在、<span style="color: #ABDDA4;">ハイムヴェア</span>と連立して統治している。?]{!</p>!}

{!<p class="other">!}[? if flavour_62_trigger and (flavour_62_trigger_time == time or (flavour_62_trigger_time == rubicon_time and rubicon)): 意外にも、普段は敵対的な<span style="color: #700000;">**KPD**</span>との関係にわずかな雪解けが見られる。これは<span style="color: #7A3C00;">**NSDAP**</span>こそ自党の存続にとって最大の脅威だと、その指導部がようやく認識したためである。労働者の間では、<span style="color: #9B0000;">マルクス主義者</span>の団結こそ、台頭する<span style="color: #7A3C00;">ファシズム</span>を前に不可欠だとの理解が広がっている。 ?]{!</p>!}

{!<p class="other">!}[? if papen_time == 1 and z_leader == "Kaas": <span style="color: #000000;">中央党</span>のルートヴィヒ・カーズは、健康上の理由を理由に党会長を辞任する意向を発表し、ハインリヒ・ブリューニングを後任として提案した。しかし、彼は、副党会長のヨーゼフ・ユースとブリューニングに党の日常業務のほとんどを任せるという条件で、留任するよう説得された。カーズはその後、南チロルに長期の療養休暇に出た。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 1 and not lvp_formed: <span style="color: #D3C24D;">[+ ddp_name +]</span>は、パーペン男爵閣僚に対する確固たる反対を表明し、政府の責任にもはや縛られない自党の背後に、反パーペン的なブルジョワ層の有権者を動員しようとしている。[? if dvp_exist and dvp_leader == "Dingeldey":一方、<span style="color: #C0A054;">**DVP**</span>は、その貴族的な外見と、<span style="color: #7A3C00;">**NSDAP**</span>が含まれていないという批判にもかかわらず、新政府に対してより協力的である。それにもかかわらず、彼らはそれを前政権よりの改善と見なし、政府批判の攻撃を控えている。これは自由主義的な統一のいかなる試みをも大きく混乱させるだろう。?][? if dvp_exist and dvp_leader != "Dingeldey":また、<span style="color: #C0A054;">**DVP**</span>もまた、新政府に対して強い反対の声を上げ、その貴族的な構成と広く不人気な決定を批判している。これにより、パーペンは将来の国会において極めて狭い支持基盤しか残らない。?] ?]{!</p>!}

{!<p class="other">!}[? if papen_time == 2: ヨゼフ・ゲッベルス、<span style="color: #7A3C00;">ナチ</span>のプロパガンダの立役者は、パーペン首相の首相在任期間が数日続いた後、党が人気を維持するためにはこれと決別しなければならないと結論付けた。党は、ドイツ国民の最大90%から支持を拒否されている政府を支持できない。彼らの決定は今のところ秘密であり、パーペンは彼らの支持を得る努力を続けている。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 2 and not lvp_formed and not bourgeois_parliament and not bourgeois_list and dvp_exist and dvp_leader == "Dingeldey": ブルジョワの団結に向けた努力は停滞した。<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、右翼の反民主主義政党と協力することを拒否した。ディートリヒでさえ、極右に傾いたブルジョワ政党間の取り決めを交渉する気がない。[? if dvp_exist:さらに、統一された中道政党への抗議による<span style="color: #C0A054;">**DVP**</span>の国会議員辞任は、ディンゲルディーが<span style="color: #D3C24D;">**[+ ddp_name +]**</span>との交渉を破棄し、代わりに<span style="color: #3E88B3;">**DNVP**</span>との取り決めを模索するという決意を強めた。さらに、彼は<span style="color: #7A3C00;">ナチ</span>運動と戦うことを目的としたいかなる計画にも参加することを拒否した。?]その後、経済界は進展があるまで全ての政治献金を停止した。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 3 and nsdap_r_prussia >= 25 and not in_far_right_coalition_prussia: 中央党<span style="color: #000000;">とプロイセンの</span>および<span style="color: #7A3C00;">**NSDAP**</span>の交渉は、前者の元党員であり現首相パーペンに対する敵意によって崩壊した。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 4 and not lvp_formed and not bourgeois_parliament and not bourgeois_list and dvp_exist and dvp_leader == "Dingeldey": ディンゲルデーが交渉崩壊の全ての責任を<span style="color: #D3C24D;">**[+ ddp_name +]**</span>のせいにしたため、<span style="color: #C0A054;">**DVP**</span>の指導部は、彼に<span style="color: #3E88B3;">ナショナリスト</span>との「代替」取り決めを探るための白紙委任状を与えた。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 5 and hugenberg_dvp: ブルジョワ諸党のなかで、深刻な資金難にもかかわらず<span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、<span style="color: #000000;">ヴァ</span><span style="color: #DD0000;">イマ</span><span style="color: #FFCC00;">ル</span>共和国の擁護に最も断固たる姿勢を示し、<span style="color: #000000;">中央党</span>さえ上回っている。一方、<span style="color: #C0A054;">**DVP**</span>は同盟条件に従ってパーペンへ接近した。両党の境界はますます曖昧となり、<span style="color: #C0A054;">**DVP**</span>党員の一人は、ディンゲルデーが最後の一歩を踏み出して<span style="color: #3E88B3;">**DNVP**</span>と全面合同することを拒んだため、抗議して辞任した。 ?]{!</p>!}

{!<p class="other">!}[? if papen_time == 6 and nsdap_r_prussia >= 25 and not in_far_right_coalition_prussia and spd_prussia and not presidential_powers and not prussian_reichsexekution: の噂では、パーペン首相が内閣とヒンデンブルク大統領から、プロイセンに対する<i>ライヒスエクゼクティオン</i>を認める政令の支持を得たという。その根拠は、<span style="color: #c00000;">**SPD**</span>と<span style="color: #700000;">**KPD**</span>との合併という捏造された主張であり、これはヒンデンブルクを動かすには十分な嘘らしい。彼がすでに署名した政令を提示するためには、口実さえあればよいようだ。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 7 and prussia_leader == "Papen": パーペンによるプロイセン政府の掌握に対し、直ちに法廷闘争が開始された。<span style="color: #c00000;">**SPD**</span>と<span style="color: #000000;">中央党</span>の当局者らが、パーペンとその任命された委員たちが権力を掌握することを阻止するための仮処分を求めている。<span style="color: #808080;">反動的な</span>裁判所は仮処分を棄却し、本訴訟は3ヶ月の遅延を経てからようやく開始される予定である。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 7: パーペン首相は、<span style="color: #002654;">フランス</span>がドイツの均等な軍備権の要求に強い異議を唱えたため、ジュネーブ軍縮会議からドイツ代表団に退席を命じた。パーペンは、他の列強が彼の条件に同意しない限り、ドイツは会議に戻らないと宣言した。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 8 and prussia_leader == "Papen": <i>宰相</i> パーペンによって結成された新右派非党派のプロイセン内閣は、公務員から<span style="color: #c00000;">社会主義</span> および <span style="color: #D3C24D;">民主主義</span>の職員を大規模に粛清し、早期退職に追い込んでいる。彼らのほとんどの後任者は保守派であり、その多くは<span style="color: #3E88B3;">国家主義者</span>である。この粛清は特に<span style="color: #c00000;">社会主義</span>の州知事や警察官を標的としている。推定69名の<span style="color: #000000;">代表</span>の<span style="color: #DD0000;">職員</span>は<span style="color: #FFCC00;">アメリカ人</span>の役職を剥奪された。民主主義の防波堤は解体されたと言って差し支えない。?]{!</p>!}

{!<p class="other">!}[? if flavour_60_trigger and ((flavour_60_trigger_time == time and not rubicon) or (flavour_60_trigger_time == rubicon_time and rubicon)): <span style="color: #D3C24D;">**[+ ddp_name +]**</span>の成績は、選挙連合を欠いたことによる不利さから国会でわずか[+ ddp_r +]%に留まり、党の存続に関する議論の新たな波を引き起こした。党の将来をめぐる辞任の動きは、特に財界部門で強く、多くのメンバーが解散を求める圧力に屈している。[? if ddp_leader == "Dietrich":ディートリヒでさえも諦め、辞任を発表したが、彼に代わる者は誰もいない。?]しかし、党の活動的な州組織がバーデン＝ヴュルテンベルクとハンブルクという牙城で、党を解散から説得した。その結果、党はより活気あるトーンを採用し、権力はディートリヒ、活発なヴュルテンベルク州首相ラインホルト・マイア、そしてハンブルク市長カール・ペテルセン—元<span style="color: #D3C24D;">**DDP**</span>会長—の間で共有されている。?]{!</p>!}

{!<p class="other">!}[? if year = 1932 and month = 8 and (week == 1 or not rubicon) and unemployed >= 25 : おそらく世界的な回復がようやく目前に迫っている。多くの経済学者は、不況は底を打ったと考えており、フランクフルト証券取引所は着実に上昇している。株価と債券価格は春以来30%以上上昇している。しかし、この回復は、貧困に閉じ込められた何百万人もの失業者にとっては依然として抽象的なものだ。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 9 and hitler_right_coalition >= 50: 国会選挙後に黒・茶の多数派が生まれたことで、<span style="color: #7A3C00;">**NSDAP**</span>と<span style="color: #000000;">中央党</span>の交渉が始まった。中央党は<span style="color: #7A3C00;">ナチ</span>を抑えるため、首相候補[+ nsdap_chancellor +]に緊急令ではなく議会を通じて統治させようとしている。そうなれば彼は、実権を握る、より保守的で信頼できる非<span style="color: #7A3C00;">ナチ</span>の閣僚たちと協議せざるを得なくなる。 ?]{!</p>!}

{!<p class="other">!}[? if papen_time == 9: シュライヒャー将軍は[+ nsdap_chancellor +]に、緊急令で統治する大統領内閣の樹立という魅力的な提案を示した。この構想ではグレゴール・シュトラッサーがプロイセンとライヒ双方の内相となり、シュライヒャーは自ら国防相に就いて<span style="color: #7A3C00;">ナチ</span>を制御できると考えている。しかし<span style="color: #7A3C00;">ナチ</span>指導部の熱意は、ヒンデンブルク大統領が[+ nsdap_chancellor +]の首相任命を拒むと急速に冷めた。シュライヒャーが自分を見捨てる姿勢を見せたことに深く憤慨したパーペンは、ヒンデンブルクとの親密さを利用し、大統領に対するシュライヒャーの影響力を切り崩している。 ?]{!</p>!}

{!<p class="other">!}[? if papen_time == 10: 国会選挙の結果を受け、パーペンとヒンデンブルク大統領は[+ nsdap_chancellor +]と会い、党の政権参加に関する要求を聞いた。[+ nsdap_chancellor +]は再び首相に指名されるよう要求したが、これはヒンデンブルクによって拒否された。選挙での勝利に勢いづいた<span style="color: #7A3C00;">ナチス</span>は、パーペンを容認するという以前の約束を正式に破棄した。今後は、すべてか無かかの戦略を追求する：[+ nsdap_chancellor +]のための首相職、さもなければ何もない。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 11: パーペンが先週の[+ nsdap_chancellor +]との会話の内容を報道陣にリークし、[+ nsdap_chancellor +]が「国家に対する完全な権力」を要求するためにヒンデンブルクの執務室に押し入った、すなわち暴力的な一党独裁であったと主張し、大統領から激しい拒絶を受けた、と述べている。この報道は、<span style="color: #7A3C00;">ナチス</span>に対する反攻の開始を意図している。しかし今、どの政党も首相を巻き込んだ過激派との公然の対決に踏み込む意思も能力もない。<span style="color: #000000;">中央党</span>でさえ、[+ nsdap_chancellor +]の出来事の記述をパーペンのものより信頼している。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 11 and hitler_right_coalition >= 50: <span style="color: #000000;">中央党</span>と<span style="color: #7A3C00;">**NSDAP**</span>の間の連立交渉は続いており、パーペンに、<span style="color: #7A3C00;">ナチス</span>の恩恵を得るために元所属政党を出し抜くよう圧力をかけている。ブリューニングは、党指導部の許可を得て、<span style="color: #7A3C00;">**NSDAP**</span>のシュトラッサーと会談し、もし自分があの[+ nsdap_chancellor +]を説得し、国防大臣をシュライヒャー、プロイセンの委員をゲルダーラーとする議会内閣による政権を樹立できれば支持を約束した。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 11 and schleicher_kvp: ゲントル・フォン・シュライヒャー将軍の圧力により、<span style="color: #0087DC;">**KVP**</span>は、不人気なパーペン政権を支持せざるを得ない。さもなければ、シュライヒャーの秘密の国防軍の資金提供を失うことになる。党がそのような反社会的な首相を支持したことに激怒した<span style="color: #6D5298;">キリスト教社会党</span>は、抗議して職を辞する。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 12 and hitler_right_coalition >= 50: シュトラッサーが手配した、潜在的な黒・ブラウン同盟に関する先週の議論のフォローアップ会議は、[+ nsdap_chancellor +]がパーペンに対する不信任決議案の採決を延期することに合意したという結果になった。[+ nsdap_chancellor +]もまた、ブリューニングの他の要求に同意したようだった。両党が議会を通じて共に統治するというコミットメントに真剣であれば、近い将来、より緊密な協力が期待される。[? if nsdap_chancellor == "Hitler":しかし、[+ nsdap_chancellor +]は大嘘つきだ。?] ?]{!</p>!}

{!<p class="other">!}[? if year = 1932 and month = 8 and (week == 3 or not rubicon): オーストリアは国際連盟からの融資を得たが、それはアンシュルス（併合）を20年間禁止することに結びついている。しかし、<span style="color: #C8102E;">社会民主党</span>と<span style="color: #0E428E;">大ドイツ党</span>からの反対により、この法律は議会で単票の可決を前にして停滞している。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 13 and hitler_right_coalition >= 50: 中央党<span style="color: #000000;">と</span>および<span style="color: #7A3C00;">**NSDAP**</span>の連立交渉は、ブリューニングが関わる重大な危険についてますます不安を感じているため中止された。この決定は、友人であり我々の党員でもあるヒルファーディングの影響も受けている。彼は、<span style="color: #7A3C00;">**NSDAP**</span>が議会政治を回復させることは決してないと主張した。ヒルファーディングはまた、ブリューニング自身の党の仲間たちの多くが<span style="color: #7A3C00;">ナチ</span>の影響下にあることも指摘した。この事実は、彼らが計画された取引で大統領ヒンデンブルクの弾劾にほぼ同意したことで裏付けられた。ヒルファーディングはまた、パーペン内閣を容認することが、<span style="color: #7A3C00;">ナチ</span>独裁を防ぐ唯一の方法であるとして、我々の党内で唯一それを主張している人物である。ブリューニングの目標は今、<span style="color: #7A3C00;">ナチ</span>に対し、パーペン政権に経済を再活性化させるための「公正な機会」を与えるよう説得することである。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 15 and hitler_right_coalition >= 50: <span style="color: #000000;">中央党</span>とその草の根支持者は、主にブリューニングが<span style="color: #7A3C00;">と**NSDAP**と</span>と秘密裏に交渉しているため、ますます士気が低下している。地元では、党の活動家たちが、集会を妨害し反対者を威嚇する暴力的なごろつきとして<span style="color: #7A3C00;">ナチス</span>に直面している。これは潜在的な連立パートナーというイメージとは程遠い。一部の活動家は、党とその指導部に信頼を失い、自衛のために武器を手にしている。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 16 and papen_explode: <span style="color: #7A3C00;">**NSDAP**</span>のグレゴール・シュトラッサーは、党が最近行った不信任決議と、それに続く解散選挙に公然と反対した。そのような行動は<span style="color: #7A3C00;">ナチ</span>の大衆的支持を損ない、権力獲得の唯一現実的な機会を浪費するだけだと警告している。これを受け、約60人の<span style="color: #7A3C00;">ナチ</span>党国会議員が、[+ nsdap_leader +]の全か無かの路線に幻滅してシュトラッサーの周囲に非公式派閥を形成した。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1932 and month = 9 and (week == 3 or not rubicon) : スウェーデンで総選挙が行われ、ペル・アルビン・ハンソンと彼の<span style="color: #D70926;">社会民主党</span>が大勝し、現在少数与党として政権を担っている。<span style="color: #D70926;">スウェーデン社会民主党</span>は、「人民の家」という概念を受け入れ、資本主義の枠組みの中で階級間の格差を減らすことを目指した改革主義的な社会主義の形態に取り組んでいる。我々も彼らの「北欧」モデルを考慮すべきではないか？?]{!</p>!}

{!<p class="other">!}[? if papen_time == 17 and prussia_leader == "Papen": パーペンによるプロイセン政府の違憲な<i>国務執行</i>に対する主要な訴訟手続きが始まり、数週間以内に判決が予想されている。しかし、司法の歴史的に<span style="color: #808080;">反動的</span>な傾向が、我々に明白な不利な立場を与えている。バイエルン州とバーデン州の州政府からの支持があるにもかかわらず、彼らはこの布告の合法性に異議を唱えることで我々に加わっている。?]{!</p>!}

{!<p class="other">!}[? if year = 1932 and month = 10 and (week == 1 or not rubicon) : オーストリアの首相エンゲルベルト・ドルフフスは、オーストリア＝ハンガリー帝国時代に可決された「戦時経済権限法」を用い、議会の承認なしにクレディタンシュタルトを再編した。<span style="color: #C8102E;">オーストリアの社会民主党</span>は抗議したが、ドルフフスの行動は技術的には合法である。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 18 and papen_explode and not lvp_formed and ddp_ideology == "Right": <span style="color: #D3C24D;">**[+ ddp_name +]**</span>は、支持率回復を試み、ドイツの自由主義運動において重要な役割を果たした国家主義的衝動を再燃させることを目指し、「国民民主主義」の概念を概説した。しかし、これは本質的に古典的自由主義イデオロギーの再表明であり、より国家主義的なドイツの中産階級にアピールするように調整されている。国民民主主義プログラムはまた、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の<span style="color: #000000;">ヴァ</span><span style="color: #DD0000;">イマ</span><span style="color: #FFCC00;">ル</span>共和国へのコミットメントを再確認し、それを強化するための憲法改正を推奨する。?]{!</p>!}

{!<p class="dnvp">!}[? if papen_time == 18 and papen_explode and hugenberg_dvp and not lvp_formed: <span style="color: #3E88B3;">DNVP</span>との選挙同盟により、<span style="color: #C0A054;">**DVP**</span>の行動の自由はますます制約されている。その主張も<span style="color: #3E88B3;">**DNVP**</span>へ近づき、「<span style="color: #000000;">ヴァ</span><span style="color: #DD0000;">イマ</span><span style="color: #FFCC00;">ル</span>体制の清算」、憲法の権威主義的改変、大衆からの権力剥奪を求めるようになった。 ?]{!</p>!}

{!<p class="dnvp">!}[? if papen_time == 20 and papen_explode and hugenberg_dvp and not lvp_formed: ディンゲルデーとその仲間たちは、もはや<span style="color: #3E88B3;">__**DNVP**</span>との選挙名簿上の繋がりを更新するだけでは満足していない。代わりに、彼らは<span style="color: #C0A054;">**DVP**</span>、<span style="color: #3E88B3;">**DNVP**</span>、<span style="color: #3E88B3;">**鉄兜団**</span>、および様々な実業家や商工団体が、ヒンデンブルクとパーペンに対する結束した支持を提供するための統一された右翼ブロックを推進した。しかし、フーゲンベルクは全く無関心な態度を示し、選挙名簿上の繋がりを更新すること以上のコミットメントを拒否した。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 21 and papen_post_2: ヒンデンブルク大統領は、最近の選挙結果を受けて、再び<span style="color: #7A3C00;">ナチ</span>を牽制した。[+ nsdap_chancellor +]は、首相に指名された場合、他の政党の支持を得る用意があることを示唆した。[+ nsdap_chancellor +]の虚勢を試すように、大統領は彼を任命する用意があると申し出たが、それは国会で過半数を確保し、大統領自身が国防大臣と外務大臣を選任することを条件とした。予想通り、[+ nsdap_chancellor +]はヒンデンブルクの提案を拒否し、代わりに非常権限を行使すれば、すぐに満足のいく政府を樹立できると提案した。[+ nsdap_chancellor +]が大統領首相職を望んでいると確信したヒンデンブルクは、彼を検討対象から外した。?]{!</p>!}

{!<p class="other">!}[? if ((flavour_61_trigger_time == time and not rubicon) or (flavour_61_trigger_time == rubicon_time and rubicon)): <span style="color: #D3C24D;">**[+ ddp_name +]**</span>にとってまたもろく失敗した結果を受け、元国会議員と高官のグループ6名が、党解散を目的とした党大会が開かれなければ、離脱すると[+ ddp_leader +]に伝えた。しかし、この呼びかけはあまり支持を得ておらず、元<span style="color: #D3C24D;">**DDP**</span>会長のカール・ペテルセンは、仲介の技術を駆使して、反体制派が党との決別を公に発表するのを防いだ。?]{!</p>!}

{!<p class="other">!}[? if year = 1932 and month = 11 and (week == 1 or not rubicon): <span style="color: #00AEF3;">民主党</span> フランクリン・D・ルーズベルトが、現職の<span style="color: #E81B23;">共和党</span> ヘンバート・フーヴァー大統領を、<span style="color: #B31942;">合衆国</span> <span style="color: #0A3161;">州</span>大統領選挙で圧勝した。これは世界恐慌と、ルーズベルトが提案した大規模な公共事業と政府改革を掲げた「ニューディール」の選挙運動によるものとされる。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 22 and papen_post_2: シュライヒャー将軍が、自分が引き付けた首相を失脚させようとしているという噂が広まっている。彼の知人たちの間では、すでに次期首相として言及されている。?]{!</p>!}

{!<p class="other">!}[? if papen_time == 23 and papen_post_2: ヒンデンブルク大統領は、[+ z_leader +]に過半数連立を形成するための最後の試みを命じた。翌日報告した[+ z_leader +]は、そのような過半数は組めないことを確認した。彼の勧告は率直だった。前進する唯一の方法は、国会が彼を首相として決して受け入れないため、大統領がパーペンを解任することだ。?]{!</p>!}

{!<p class="other">!}[? if (papen_time or chancellor == "Schleicher") and year == 1932 and month == 12 and week == 1:ここで<span style="color: #7A3C00;">**NSDAP**</span>は再び大打撃を受けた。今回はテューリンゲ州の地方選挙だ。結果は、前回の州選挙と比較して票のシェアがほぼ四分の一も失ったことを示している。投票率の低さが一因かもしれないが、これと最近の他の三つの地方選挙は、<span style="color: #7A3C00;">ナチ</span>が頂点に達し、急速に支持を失っているという感覚を強めるだけだ。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 0 and chancellor == "Schleicher": 追放されたにもかかわらず、パーペンは首相よりも大統領に物理的にずっと近い場所にいる。ヒンデンブルクの個人的な要請により、彼は内務省の建物内のアパートに住み続けている。そこはヒンデンブルク自身の住居から数歩の距離だ。一方、シュライヒャーは私邸に何マイルも離れて住んでいる。この取り決めは、パーペンが公の注目を集めることなく、終日策略を巡らせることを可能にした。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 0 and chancellor == "Schleicher": かつての親友であったオスカー・フォン・ヒンデンブルクは、新しい首相にとって容赦ない敵となった。噂によると、彼のプライドを許しがたいほど傷つけた、趣味の悪い冗談が原因だ。プロイセン時代なら、そのような侮辱は決闘で終わったかもしれない。今回は、その余波が共和国の命を奪うかもしれない。カマリラの一員2人がシュライヒャーに対して強い敵意を抱き、大統領に任命の再考を促すよう働いている。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 0 and chancellor == "Schleicher": シュライヒャーの任命直後、国連軍縮会議での長期交渉を経て、<span style="color: #0A3161;">西部</span> <span style="color: #C8102E;">連合国</span>は、武装面での平等権を原則としてドイツに譲歩した。この譲歩の実質的な条件は不明瞭なままだが、シュライヒャーの見解では、これは公式な民兵制度を確立する道を開くものだ。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 1: シュライヒャーが国民に向けて演説する際、一つの中心的なテーマが明確に響く。「仕事を生み出せ！」彼は、財政破綻した荘園から切り出された、人口のまばらな東部の農場に、都市の失業者を再定住させる努力を復活させた。国会は依然として解散しており、彼には法を制定する権限はないが、彼は公然とパーペンによる失業保険制度の変更に反対し、自分自身を<span style="color: #C0A054;">資本主義</span>も<span style="color: #c00000;">社会主義</span>のどちらの支持者でもない者として提示している。彼のイデオロギー的な曖昧さは、「社会の将軍」というニックネームをもたらし、彼はそれを自ら受け入れ、それが軍の将校と兵士の間の連帯という伝統に沿っていると主張する。 ?]{!</p>!}

{!<p class="dnvp">!}[? if schleicher_time == 1 and hugenberg_dvp: <span style="color: #C0A054;">**DVP**</span>の世論調査での再浮上は、ディンゲルデーに過信を抱かせ、彼はパーペンを、そしてシュライヒャーを明確に支持し、さらにはそれと<span style="color: #3E88B3;">**DNVP**</span>の間の様々な分裂政党と議会派閥を形成した。この動きは彼らの影響力を高めたが、彼らは依然として選挙同盟として頼りにしているフーゲンベルクと<span style="color: #3E88B3;">**DNVP**</span>を疎外した。 ?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 2:どういうわけか、フォン・シュライヒャーは、[+ nsdap_chancellor +]が議会多数派に支えられた首相への任命を果たせなかったのは、本人が「心の底では」その地位を望んでいないからにすぎない、と考えるようになった。[+ month : month +]までに、この疑念は確信へと変わっていた。彼はジャーナリストや閣僚に、あの男は本当は権力を望んでいないのだ、と繰り返し打ち明けた。この思い込みにより、シュライヒャーは、自らの内閣に対する<span style="color: #7A3C00;">**NSDAP**</span>の支持を、[+ nsdap_chancellor +]を首相に据えることなく取り付けられる可能性を過大評価している。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 2: 地方選挙における<span style="color: #7A3C00;">**NSDAP**</span>の大敗は、同党を台頭させた有権者の幻滅をさらに深めた。勝利の分け前を期待して入党し、献金していた多くの人々が絶望し、献金を打ち切り始めている。かつて地方組織の主要な収入源であった集会の入場料収入も、大幅な値下げにもかかわらず激減した。[+ nsdap_chancellor +]が首相の座を獲得できず、また政府に参加してドイツの経済的苦境の緩和に建設的に取り組むこともできなかったため、運動内部では不満がさらに高まった。しかし、<span style="color: #7A3C00;">ナチ</span>指導部は、内部の反対意見や衰退の噂が世間に漏れると、直ちにこれを封じ込めている。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 3: 世界経済は上向きになり、それに伴って<span style="color: #7A3C00;">**NSDAP**</span>の支持基盤は引き続き弱まっている。<span style="color: #000000;">共</span><span style="color: #DD0000;">和</span><span style="color: #FFCC00;">派</span>の警察がミュンヘンで<span style="color: #7A3C00;">**NSDAP**</span>を監視しているところ、崩壊の明確な兆候が確認された。辞任が日々起こり、会費の納入が不規則になり、負債を理由とした除名がますます一般的になっている。党のあらゆる支部が荒廃しているように見える。士気については、警察の報告書は次のように述べていた。「頂点は過ぎ去り、好機は逃したという見方が多くの組合員の間で一般的である。」 ?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 3: シュライヒラーは、今や無力なシュトラッサーが、休暇から戻った今、どうにかして[+ nsdap_chancellor +]に<span style="color: #7A3C00;">ナチ</span>の閣僚への参加を認めさせるという幻想的な希望にしがみついている。シュトラッサーが公の場から姿を消したことは、党を分裂させようとする潜在的な裏の陰謀を恐れる[+ nsdap_leader +]を動揺させている。特に、シュトラッサーの残る忠実な支持者たちがまさにそうしようと熱心であるためだ。実際には、シュトラッサーが行っていることは、旧首相ブリューニングに対し、パーペンがヒトラーと秘密の会合を、一週間か二週間以内に計画していると警告することだけである。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 4 and nazi_funds <= 1: <span style="color: #7A3C00;">**NSDAP**</span>の財政状況は深刻になりつつある。ますます、備品や物資が信用取引で調達されており、それはすでに党の既存の負債の重みで枯渇しつつある信用である。残された寄付金の分け方について、<span style="color: #7A3C00;">**SA**</span>と党指導部との間で緊張が高まっており、一部の組合員は路上で物乞いをしたり、資金を集めるために宝くじを企画したりしている。もう一度選挙が行われれば、党は本格的な財政危機に直面する可能性がある。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 4: 彼の支持する元首相を公然と批判しないと約束したにもかかわらず、シュライヒャーは、パーペンから距離を置こうと、まさにそのことを行った。信頼の裏切りに不快感を覚えたヒンデンブルクは、シュライヒャーからますます疎遠になっていく。一方のパーペンは、自身の失脚に対して表立った敵意を見せることはなく、心底の憤りと復讐心を丁寧な態度で覆い隠している。その間、ヒンデンブルクは彼に[+ nsdap_leader +]への秘密の連絡役として奉仕するよう静かに命じた。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 4 and not schleicher_public_works_fast: 公共事業の意欲的な特別委員であるギュンター・ゲレケは、官僚的な障害を取り除くための介入を求めたが、それがきっぱりと拒否された後、首相に対して苛立ちを募らせた。彼の野心的な計画は停滞している。ゲレケは幻滅し、その失望を親友、すなわちオスカー・フォン・ヒンデンブルクに打ち明けた。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 4 and schleicher_public_works_fast: ギュンター・ゲレケ、公共事業の意欲的な特別委員は、首相に介入し官僚的な障害を取り除くよう要請した結果、自身の計画が加速した。[? if schleicher_spd_r >= 4: シュライヒャーが労働組合と<span style="color: #c00000;">**SPD**</span>への約束を果たし、彼らの選挙基盤が活動を再開する前に<span style="color: #7A3C00;">**NSDAP**</span>にさらなる圧力をかけるという熱意が、この決定を後押しした。?][? if schleicher_spd_r < 4 and workers_nsdap_normalized + workers_kpd_normalized >= 55: シュライヒャーが労働組合への約束を果たすこと、そして過激化した労働者層における増大する<span style="color: #700000;">**共産主義**</span>の票の割合を抑えるという熱意が、この動きを動機づけた。?][? if schleicher_spd_r < 4 and workers_nsdap_normalized + workers_kpd_normalized < 55 and unemployed >= 42: ドイツ経済の悲惨な状況は再軍備を夢物語にし、シュライヒャーはそれを軌道に乗せることに熱心だ。?] ?]{!</p>!}

{!<p class="other">!}[? if (papen_time or chancellor == "Schleicher") and year == 1933 and month == 1 and week == 1: 非常に小さなフリー州リップペでの州議会選挙の運動が始まった。<span style="color: #7A3C00;">ナチス</span>は、わずか十万人分の有権者を味方につけるため、多額の資源を投じている。しかし、その規模が小さいにもかかわらず、ここでの勝利は、<span style="color: #7A3C00;">ナチス</span>が破滅的な衰退の瀬戸際にいるという増大する信念を払拭する可能性がある。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 5: ジャーナリストとの私的な晩餐会で、フォン・シュライヒャー首相は、<span style="color: #7A3C00;">ナチ</span>指導者が、[+ nsdap_leader +]の全てか無かかの路線を公言しているにもかかわらず、やがて自らの内閣を容認するようになるだろうと繰り返し表明した。シュライヒャーは、必要であれば国会を解散させるつもりであることを明確にしたが、この動きは<span style="color: #7A3C00;">ナチ</span>にさらなる議席を失わせるだろう（ただし、<span style="color: #700000;">**共産主義者**</span>がその崩壊から最も恩恵を受けると恐れ、このような一手は避けたいと考えている）。「彼らはすぐに私の手のひらで飯を食うことになる」というのが、その夜の首相の正確な言葉だった。シュライヒャーが理解できていないのは、[+ nsdap_leader +]が普通の政治家ではないということだ。彼は、シュトラッサーの離反や<span style="color: #7A3C00;">**NSDAP**</span>の選挙での崩壊に対して、合理的に、あるいは思慮深く反応しないだろう。彼は運命が自分側に働いていると信じている。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 5: フォン・シュライヒャーと彼の報道官は、シュトラッサーを副首相、内務大臣、プロイセン州首相に任命する計画を意図的に「リーク」し、<span style="color: #000000;">中央党</span>の労働指導者シュテーガーヴァルトを労働大臣に指名した。農林水産省と経済省は、自分自身のために取っておかれたと報じられた。これは単なるブラフであり、彼らが完全に周縁化されるリスクを冒さないように、<span style="color: #7A3C00;">**NSDAP**</span>に完全な反対を撤回させようとする試みである可能性が高い。?]{!</p>!}

{!<p class="dnvp">!}[? if schleicher_time == 5 and hugenberg_dvp: ディンゲルデーの気取りと、<span style="color: #C0A054;">**DVP**</span>の世論調査の上昇に煽られ、「穏健派」右派の第一党にまで上り詰めたフーゲンベルクは、彼らの独立性にますます苛立ちを感じ、もし新選挙が呼ばれれば、彼らの選挙同盟を解消しようとしている。<span style="color: #C0A054;">**DVP**</span>はまだ同盟の更新を望んでいるが、フーゲンベルクが関係を断絶した場合のほぼ確実な壊滅に対する安全策として、<span style="color: #D3C24D;">の[+ ddp_name +]</span>およびブルジョワ党との協調の可能性を探り始めている。一方、ドイツの中産階級の統合を目指す無党派組織DNV（ドイツ国民協会）は、すでに非自由主義右派、トレヴィラヌスのような政治家の支持を確保した上で、自由主義者との関係修復を始めている。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 6: フォン・シュライヒャーのブラフ、例えばシュテーガーヴァルトとフーゲンベルクの両方を含む内閣の提案などは、信用を完全に失った。<span style="color: #000000;">中央党</span>は、シュテーガーヴァルトが労働組合運動の悪名高い敵であるフーゲンベルクとともに入閣する可能性を公然と否定した。さらに、大統領とシュトラッサーの会合に関するリークは、<span style="color: #7A3C00;">ナチ</span>指導者とシュライヒャーとの間に恒久的な決裂をもたらし、シュトラッサーがシュライヒャーを含む内閣を支持するように彼を説得する希望を終わらせた。彼の矛盾した戦術と不用意な発言は、不信感を深め、彼の政治的孤立を深めるだけだった。彼は、一週間前にその考えを支持していたにもかかわらず、今になって選挙延期を求める動きを非難する。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 6: あらゆる部門で進展が停滞する中、シュライヒャーは再軍備の問題を再び公の注目を集めることで焦点を移そうと試みる。彼は、重火器による国防軍への再武装への新たなコミットメントと、国民皆兵制の導入とともに、1年以内に義務的な民兵を設立する計画を発表した。しかし、この意図された広報上の勝利の影響は最小限であり、シュライヒャーの政治的挫折のニュースが世間の注目を占めている。?]{!</p>!}

{!<p class="dnvp">!}[? if schleicher_time == 6: 首相からドイツを独裁国家にするための譲歩を引き出すことに失敗したため、党内のより急進的な派閥が彼にシュライヒャーに対する全面的な反対を採用するよう圧力をかけた。憲法を「改革」する意志における彼の「ぐらつき」を非難する、強い言葉の決議が発表された。さらに、破産した東部の荘園での農民の自営農場再開に関する彼の取り組みは、保守エリートの怒りを買った。次の不信任投票が迫る中、これはシュライヒャー対議場全体の問題になりかねない。?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 7: ルビコン川を渡り、シュライヒャーは対岸に立つ。（今後の内容はすべて憶測であることを留意せよ）?]{!</p>!}

{!<p class="other">!}[? if schleicher_time == 8: <span style="color: #7A3C00;">ナチス</span>党は完全に混乱しており、最も反抗的な派閥である<span style="color: #7A3C00;">**SA**</span>が最初に崩壊した。エルンスト・レームは、[? if rohm_explode:、刑務所から釈放された今?]、[+ nsdap_leader +]の方向性に幻滅し、ここ数日静かに画策している。?]{!</p>!}

{!<p class="other">!}[? if year = 1933 and month = 3 and not ((spd_in_government and foreign_minister_party = "SPD") or (austria_relation >= 1)) and (week == 1 or not rubicon): ドルフフスは、「戦時経済権限法」によって与えられた権限を濫用し、鉄道ストライキの労働者たちを弾圧した。その結果、重要な採決の最中に議会の三人の大統領が辞任した。この危機は、ドルフフスが議会制度を廃止し、報道の自由や公の抗議といった民主的権利を制限する完璧な機会となった。もう一つの民主主義が権威主義に陥った。?]{!</p>!}

{!<p class="other">!}[? if year = 1933 and month = 5 and (week == 4 or not rubicon) : ドルフースの<span style="color: #7A3C00;">オーストロファシスト</span>独裁政権は、<span style="color: #700000;">オーストリア共産党</span>と、<span style="color: #C8102E;">オーストリア社会民主党</span>の準軍事組織である<span style="color: #C8102E;">共和国防衛同盟</span>を禁止した。さらに、極右の<span style="color: #7A3C00;">ファシズム</span>とコーポラティズムを掲げる政党、<span style="color: #7A3C00;">祖国戦線</span>を結成した。 ?]{!</p>!}

{!<p class="other">!}[? if year = 1933 and month = 11 and (week == 3 or not rubicon): <span style="color: #EF1C27;">スペイン社会主義者</span>と<span style="color: #E25822;">共和派左派</span>は、右翼の<span style="color: #303180;">**CEDA**</span>とますます右翼化する<span style="color: #A871A8;">急進派</span>の手に圧倒的な敗北を喫した。?]{!</p>!}

{!<p class="other">!}[? if year = 1934 and month = 2 and (week == 2 or not rubicon) and not austrian_parliament_seen: オーストリア内戦が始まり、三日で終わった。戦いは<span style="color: #C8102E;">共和派保護結社</span>とオーストリアの<span style="color: #7A3C00;">オーストファシスト</span>政権の間で行われ、国境を越えた<span style="color: #C8102E;">社会主義者</span>に敗北をもたらした。蜂起は<span style="color: #C8102E;">オーストリア社会民主党</span>の残党とその準軍事部門を鎮圧しようとする試みによって引き起こされた。しかし、連携が取れておらず弱体化した運動は、軍隊によって速やかに鎮圧された。もし彼らがもっと早く武装していれば、事態はもっと違ったものになっていたかもしれない。?]{!</p>!}

{!</div>!}

