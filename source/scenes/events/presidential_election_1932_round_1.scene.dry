@round2_organizational_endorsement
title: 超党派団体の支持はどうなっている？
subtitle: [+ dnvp_candidate_1932 +]が撤退し、選択肢は[+ reactionary_candidate_1932 +]と[+ nsdap_candidate_1932 +]になった。
on-arrival: {!
Q.organizational_endorsements_seen = 1;
if (Q.rlb_nazi) {
    Q.rlb_hindenburg = 0;
    Q.rural_other *= 0.9;
} else if (!Q.rlb_nazi) {
    Q.rlb_hindenburg = 1;
    Q.rural_other += 4;
    if (Q.dnvp_ideology == "Moderate") {
        Q.rural_dnvp += 2;
    } else {
        Q.rural_kvp += 2;
    }
}

Q.new_middle_nsdap += 2;
Q.new_middle_other -= 2;
Q.old_middle_nsdap += 4;
Q.old_middle_dnvp -= 4;

!}
view-if: hindenburg_run and not hitler_support_hindenburg
max-visits: 1
go-to: round2_menu

