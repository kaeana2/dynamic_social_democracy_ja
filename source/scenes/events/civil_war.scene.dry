title: 内戦
audio: music/communist/A_las_barricadas.ogg
on-arrival: {!
Q.rb_strength = Math.round(Q.rb_strength);
Q.sh_strength = Math.round(Q.sh_strength);
Q.sa_strength = Math.round(Q.sa_strength);
Q.rfb_strength = Math.round(Q.rfb_strength);
// re-calculate dissent, in case we transitioned from, say, the KPD support that raised reformist dissent.
var total_strength = Q.left_strength + Q.center_strength + Q.labor_strength + Q.reformist_strength + Q.neorevisionist_strength;
var total_dissent = Q.left_strength*Q.left_dissent + Q.center_strength*Q.center_dissent + Q.labor_strength*Q.labor_dissent + Q.reformist_strength*Q.reformist_dissent + Q.neorevisionist_strength*Q.neorevisionist_dissent;

Q.dissent = 0.01*total_dissent/total_strength;
console.log('new dissent: ' + Q.dissent);

if (Q.dissent < 0) {
    Q.dissent = 0;
} else if (Q.dissent > 0.95) {
    Q.dissent = 0.95;
}

Q.civil_war_seen = 1;

// our allies
Q.total_power = 0;
Q.rb_power = Q.rb_strength*Q.rb_militancy;
if (Q.dissent > 0.15) {
    Q.rb_power *= (1 - Q.dissent/1.5);
}
Q.total_power += Q.rb_power;
Q.prussian_police_power = Q.prussian_police_strength*Q.prussian_police_militancy*Q.prussian_police_loyalty;
if (Q.spd_prussia && Q.prussia_leader == "Braun" || Q.prussia_leader == "Rosenfeld") {
    Q.total_power += Q.prussian_police_power;
} else if (Q.spd_prussia && Q.prussia_leader !== "Braun" && Q.prussia_leader !== "Rosenfeld") {
    Q.total_power += (Q.prussian_police_power / 2);
}
if (Q.reichswehr_loyalty < 0) {
    Q.reichswehr_loyalty = 0;
}
Q.loyal_reichswehr_power = Q.reichswehr_strength*Q.reichswehr_militancy*Q.reichswehr_loyalty;
if (Q.spd_in_government && Q.chancellor_party == "SPD") {
    Q.total_power += Q.loyal_reichswehr_power;
} else {
    Q.total_power += Q.loyal_reichswehr_power/4;
}
Q.rfb_power = Q.rfb_strength*Q.rfb_militancy;
if (Q.kpd_relation >= 60) {
    Q.total_power += Q.rfb_power;
} else if (Q.kpd_relation >= 45) {
    Q.total_power += Q.rfb_power*0.5;
}
// general strike strength
// maximum (given 25 labor strength) is 400
// use normalized workers_spd instead of labor_strength?
Q.normalized_workers_spd = 100*Q.workers_spd/(Q.workers_spd + Q.workers_kpd + Q.workers_nsdap + Q.workers_other + Q.workers_dnvp + Q.workers_z);
Q.normalized_workers_kpd = 100*Q.workers_kpd/(Q.workers_spd + Q.workers_kpd + Q.workers_nsdap + Q.workers_other + Q.workers_dnvp + Q.workers_z);
if (Q.sapd_formed) {
    Q.normalized_workers_spd = 100*Q.workers_spd/(Q.workers_spd + Q.workers_kpd + Q.workers_nsdap + Q.workers_other + Q.workers_dnvp + Q.workers_z + Q.workers_sapd);
    Q.normalized_workers_kpd = 100*Q.workers_kpd/(Q.workers_spd + Q.workers_kpd + Q.workers_nsdap + Q.workers_other + Q.workers_dnvp + Q.workers_z + Q.workers_sapd);
    Q.normalized_workers_sapd = 100*Q.workers_sapd/(Q.workers_spd + Q.workers_kpd + Q.workers_nsdap + Q.workers_other + Q.workers_dnvp + Q.workers_z + Q.workers_sapd);
}
Q.normalized_workers_total = Q.normalized_workers_spd;
if (Q.kpd_relation >= 60) {
    Q.normalized_workers_total += Q.normalized_workers_kpd;
} else if (Q.kpd_relation >= 45) {
    Q.normalized_workers_total += Q.normalized_workers_kpd*0.5;
}
if (Q.kpd_relation >= 30 && Q.sapd_formed) {
    Q.normalized_workers_total += Q.normalized_workers_sapd;
} else if (Q.kpd_relation >= 15 && Q.sapd_formed) {
    Q.normalized_workers_total += Q.normalized_workers_sapd*0.5;
}


Q.total_power += (2 - Q.labor_dissent/100)*Q.normalized_workers_total*(2 - Q.unemployed/100)*2.5;
console.log("Supporter strength:", Q.total_power);

// our enemies
Q.enemy_power = 0;
Q.sa_power = Q.sa_strength*Q.sa_militancy;
Q.enemy_power += Q.sa_power;
Q.sh_power = Q.sh_strength*Q.sh_militancy;
Q.enemy_power += Q.sh_power;
Q.hostile_reichswehr_power = Q.reichswehr_strength*Q.reichswehr_militancy*(1-Q.reichswehr_loyalty);
Q.enemy_power += Q.hostile_reichswehr_power;
console.log("Enemy strength:", Q.enemy_power);

if (Q.total_power > Q.enemy_power*1.1) {
    Q.republic_victory = 1;
    if (Q.hitler_revive) Q.der_aufstieg_skywalkers = 1;
} else if (Q.total_power/Q.enemy_power >= 0.6) {
    Q.long_war = 1;
} else {
    Q.total_defeat = 1;
}

Q.is_favorable = 0;
if (Q.total_power >= Q.enemy_power*0.95) {
    Q.is_favorable = 1;
}
!}
go-to: war_menu

= 両軍の戦力

敵は[+ sh_strength +]千人を擁する<span style="color: #808080;">国家主義</span>の<span style="color: #3E88B3;">**鉄兜団**</span>と、[+ sa_strength +]千人を擁する<span style="color: #7A3C00;">ナチ党</span>の<span style="color: #7A3C00;">**SA**</span>である。[+ reichswehr_strength +]千人の正規兵を持つ国軍と、[+ prussian_police_strength +]千人のプロイセン警察がどちらへ忠誠を示すかは分からない。

[? if chancellor_party == "KPD" or president == "Thälmann" or kpd_reichsex_sax : <span style="color: #700000;">**KPD**</span>の準軍事組織<span style="color: #8B0000;">**RFB**</span>が戦闘を主導し、我々は共同戦線を張っている。?]

我々の側には[+ rb_strength +]千人の国旗団がいる。[? if dissent > 0.15 and dissent <= 0.25: 党内の不和でやや弱体化し、一部の団員は戦闘を拒んでいる。?][? if dissent > 0.25 and dissent < 0.5: 党内の不和で弱体化し、多くの団員が戦闘を拒んでいる。?][? if dissent >= 0.5: 党内の不和で著しく弱体化し、相当数の団員が戦闘を拒んでいる。?]

[? if rb_militancy < 0.25 : 残念ながら国旗団は訓練も装備も不十分で、より軍事化された敵には対抗できない。?][? if rb_militancy >= 0.25 and rb_militancy < 0.5 : 国旗団の訓練と装備にいくらか資源を投じてきた。同志たちが持ちこたえることを祈ろう。?][? if rb_militancy >= 0.5 : 国旗団を戦闘部隊へ変えるため、かなりの資源を投じてきた。彼らが生き延びることを祈ろう。?]

ほかに何がある？

# note: many scenarios lead to civil war. This calculates the array of forces, and the possible outcomes.

@war_menu

- @rw_help: 国軍に武装解除を呼びかける。
- @kpd_help: <span style="color: #700000;">共産主義者</span>へ支援を求める。
- @general_strike: ゼネストを呼びかける！
- @loyal_police: 忠実な警察部隊を召集する。
- @war_outcome: いざ、戦闘へ……

@rw_help
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1

同胞を殺すことを避けるため、国軍に武装解除を呼びかけた。[? if reichswehr_loyalty < 0.2 : 残念ながら応じる者はわずかである。国軍は我々を憎悪している。?][? if reichswehr_loyalty >= 0.2 and reichswehr_loyalty < 0.4 : 一部の将校と兵士は、我々と戦わないよう求める呼びかけに応じた。中には我々へ加わる者もいる。?][? if reichswehr_loyalty >= 0.4 and reichswehr_loyalty < 0.6 : 国軍は分裂した。多くが中立を保つか、我々の側へ加わっている。?][? if reichswehr_loyalty >= 0.6 : 驚くべきことに、国軍の大半が我々の側についた！　準備が実を結んだ。?]

@kpd_help
max-visits: 1
view-if: chancellor_party != "KPD" and president != "Thälmann" and not kpd_reichsex_sax
go-to: war_menu
on-arrival: war_choices += 1

<span style="color: #700000;">共産党</span>の<span style="color: #8B0000;">**RFB**</span>には[+ rfb_strength +]千人の闘士がおり、さらに<span style="color: #700000;">**KPD**</span>を支持する労働者もいる。

[? if kpd_relation >= 60 : 良好な関係により、<span style="color: #700000;">**KPD**</span>は全面的に我々の側についている。?][? if kpd_relation < 60 and kpd_relation >= 45 : 我々との良好な関係により、<span style="color: #700000;">**KPD**</span>の大半が我々の側についている。?][? if kpd_relation < 45 : <span style="color: #700000;">**KPD**</span>は我々を支持しない。?]

@general_strike
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1

ゼネストは1920年にカップ一揆を阻止した。今日も<span style="color: #7A3C00;">ファシズム</span>を阻止できる。[? if normalized_workers_total > 70 : 労働者の大部分は我々と結束している。?][? if normalized_workers_total >= 50 and normalized_workers_total <= 70 : 労働運動内に多少の不和はあるが、労働者の過半数がゼネストを支持している。?][? if normalized_workers_total > 30 and normalized_workers_total < 50 : しかし労働運動内には相当な不和があり、ゼネスト支持は半数に満たない。?][? if normalized_workers_total <= 30 : しかし労働運動は深く分裂し、大半の労働者がストライキの呼びかけに応じない。?]


@loyal_police
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1
view-if: spd_prussia = 1

我々はなおプロイセン政府を掌握しているため、プロイセン警察を召集できる。[? if prussian_police_loyalty < 0.4 : 残念ながら警察は、よく見積もっても政治的に信用できない。?][? if prussian_police_loyalty >= 0.4 and prussian_police_loyalty < 0.65 : この決定的な時にプロイセン警察は分裂し、約半数が我々の戦いを積極的に支持している。?][? if prussian_police_loyalty >= 0.65 : 大半が我々の戦いに加わった。警察内に<span style="color: #000000;">共和</span><span style="color: #DD0000;">主義</span><span style="color: #FFCC00;">への</span>忠誠を育ててきた努力が報われた。?]




@foreign_intervention
max-visits: 1
go-to: war_menu
on-arrival: war_choices += 1; 

# note: the Prussian coup should not trigger foreign intervention...


@war_outcome
view-if: war_choices >= 2
go-to: defeat if total_defeat = 1; long_war if long_war = 1; republic_victory if republic_victory = 1

@defeat

= 完全敗北

我々の軍勢は<span style="color: #808080;">反動勢力</span>に太刀打ちできない。国旗団の闘士は<span style="color: #3E88B3;">**鉄兜団**</span>、<span style="color: #7A3C00;">**SA**</span>、国軍に瞬く間に制圧され、多くが殺された後、残りも降伏する。残された指導者は国外へ逃れるか処刑され、<span style="color: #808080;">反動勢力</span>がドイツの絶対権力を握る。

我々の抵抗は歴史書に記され、後世にはその名誉が称えられるだろう。しかし今は、すべてが失われた。

- @game_over: ゲーム終了。

@long_war
go-to: long_war_intervention if resist_coup == 0; game_over_menu if resist_coup == 1

= 長期戦

戦闘の初期段階が終わったが、どういうわけか双方とも持ちこたえている。

戦線は膠着した。これは短期間のクーデターではなく、長い内戦となる。国家は再建される前に自らを破壊するだろう。

@game_over_menu

国外へ支援を求めたいところだが、列強は「プロイセン・クーデター」を純粋な国内問題と見なしている。

- @game_over

# no war

@long_war_intervention

- @west_aid: 西側列強、<span style="color: #002654;">フランス</span>と<span style="color: #C8102E;">イギリス</span>から支援を受けられるかもしれない。
- @soviet_aid: <span style="color: #750e0e;">ソ連</span>から支援を受けられるかもしれない。
- @east_aid: 東の隣国、<span style="color: #DC143C;">ポー</span><span style="color: #FFFFFF;">ランド</span>と<span style="color: #11457E;">チェコ</span><span style="color: #FFFFFF;">スロバ</span><span style="color: #D7141A;">キア</span>が支援するかもしれない。彼らもドイツで<span style="color: #7A3C00;">ファシスト</span>が権力を握ることを望んではいない。
- @game_over: ゲーム終了。

@west_aid
choose-if: west_relation >= 2
unavailable-subtitle: 関係が十分に強くない。
on-arrival: west_aid += 1
max-visits: 1
go-to: long_war_intervention

西側へ救援を求めたが、各国政府は我々を支援すべきかで意見が割れている。彼らが決断するまで、自力で生き延びなければならない。

@soviet_aid
choose-if: (soviet_relation >= 1 and kpd_relation >= 50) or (kpd_relation >= 75)
on-arrival: soviet_aid += 1
unavailable-subtitle: 関係が十分に強くない。
max-visits: 1
go-to: long_war_intervention

<span style="color: #750e0e;">ソ連</span>へ救援を求めた。支援の大半は<span style="color: #700000;">**KPD**</span>が受け取り、国旗団と我々に忠実な軍部隊は苦境に取り残される。勝利したとしても、将来にとって良い兆候ではない。

@east_aid
choose-if: east_relation >= 2
on-arrival: east_aid += 1
unavailable-subtitle: 関係が十分に強くない。
max-visits: 1
go-to: long_war_intervention

<span style="color: #DC143C;">ポー</span><span style="color: #FFFFFF;">ランド</span>と<span style="color: #11457E;">チェコ</span><span style="color: #FFFFFF;">スロバ</span><span style="color: #D7141A;">キア</span>は自国の問題にかかりきりで大した援助はできないが、我々が支配する国境地帯を通じて武器と義勇兵が少しずつ入ってくる。

@republic_victory

= 共和国の勝利

戦線を維持し、<span style="color: #7A3C00;">**SA**</span>、<span style="color: #3E88B3;">**鉄兜団**</span>、クーデター派国軍部隊を打ち破った。今日、共和国の軍勢は<span style="color: #7A3C00;">ファシスト</span>と<span style="color: #3E88B3;">反動勢力</span>に勝利した。ドイツで新たな革命が起きたのである。前の革命より長く続く平和を生み出すことを願おう。

- @game_over: ゲーム終了。
