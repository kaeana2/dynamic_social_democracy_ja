@finalize_cvp_demands
title: <span style="color: #000000;">**[+ z_party_name +]**</span>と合意に達した。
subtitle: 不安定な枠組みだが、歴史的な先例となる。
choose-if: cvp_negotiations_points >= cvp_negotiations_min
unavailable-subtitle: <span style="color: #000000;">[+ z_party_name +]</span>は現在の約束に満足していない。
on-arrival: {!
if (Q.cvp_reichsbanner_accepted) {
    Q.rb_militancy = 0.02;
    if (Q.rb_strength > 2000) Q.rb_strength = 2000;
    Q.prussian_police_strength += 40;
}
if (Q.cvp_economy_accepted && Q.budget < 0) {
    Q.austerity_budget = Q.budget*-1;
    Q.budget = 0;
    Q.workers_spd -= Q.austerity_budget*3;
    Q.new_middle_spd -= Q.austerity_budget*2;
    Q.old_middle_spd -= Q.austerity_budget;
    Q.unemployed_spd -= Q.austerity_budget*3;
    Q.catholics_spd -= Q.austerity_budget;
    if (Q.welfare >= 1) Q.welfare -= 2;
    Q.workers_kpd += Q.austerity_budget*2;
    Q.workers_nsdap += Q.austerity_budget;
    Q.unemployed_kpd += Q.austerity_budget*2;
    Q.unemployed_nsdap += Q.austerity_budget*2;
    Q.left_dissent += 10*Q.austerity_budget;
    Q.center_dissent += 7*Q.austerity_budget;
    Q.labor_dissent += 10*Q.austerity_budget;
    Q.reformist_dissent += 5*Q.austerity_budget;
    Q.unemployed += Q.austerity_budget;
    Q.kpd_coalition_dissent += 1;
    Q.kpd_relation -= 10;
}
!}
go-to: social_catholic_coalition_cvp_2 if not left_split; social_catholic_coalition_cvp_3 if left_split
achievement: historischer_kompromiss

@social_catholic_coalition_cvp_2
go-to: social_catholic_coalition_cvp_3
achievement: frahm_und_brandt

@social_catholic_coalition_cvp_3
on-arrival: leverage -= 10; leverage += 5 if cvp_ideology == "Left"; in_weimar_coalition = 1; in_social_catholic_coalition = 1; spd_in_government = 1; in_popular_front = 0; in_left_front = 0; sapd_toleration = 0; foreign_minister_party = "Z"; interior_minister_party = "Z"; justice_minister_party = "Z"; labor_minister_party = "Z"; reichswehr_minister_party = "I"; finance_minister_party = "Z"; economic_minister_party = "Z"; agriculture_minister_party = "Z"; foreign_minister = "Wirth"; interior_minister = "Wirth"; justice_minister = "Guérard"; labor_minister = "Stegerwald"; reichswehr_minister = "Groener"; economic_minister = "Brüning"; finance_minister = "Köhler"; agriculture_minister = "Hermes"; dvp_right += 2; ddp_right += 4; ddp_cohesion -= 3; lvp_right += 3; hindenburg_angry = 30; liberal_cooperation += 5; z_relation += 10; workers_z += 3; unemployed_z += 3; new_middle_z -= 6; old_middle_z -= 10; rural_z -= 6; catholics_z += 4; new_middle_dnf += 2; new_middle_dvp += 2; new_middle_ddp += 2; new_middle_lvp += 4; old_middle_dnf += 6; old_middle_dvp += 4; old_middle_dvp += 4; rural_dnf += 4; rural_dvp += 2; rural_lvp += 2
achievement: sozialchristliche_koalition

