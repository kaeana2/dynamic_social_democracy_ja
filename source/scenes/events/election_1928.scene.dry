on-arrival: spd_in_government = 0; spd_toleration = 0; spd_toleration_right = 0; chancellor = "Brüning"; chancellor_party = "Z"; foreign_minister_party = "DVP"; foreign_minister_party = "LVP" if lvp_formed; interior_minister_party = "Z"; justice_minister_party = "Z"; labor_minister_party = "Z"; reichswehr_minister_party = "I"; economic_minister_party = "Z"; finance_minister_party = "Z"; agriculture_minister_party = "Z"; grand_coalition_failed = 1

大連立への参加も閣外協力も拒めば、政権の均衡を事実上右翼へ明け渡すことになる。[? if right_coalition >= 50 and dnvp_ideology == "Radical" : <span style="color: #3E88B3;">**DNVP**</span>を含む右翼連立には十分な議席がある。しかし<span style="color: #3E88B3;">**DNVP**</span>党首フーゲンベルクは、[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]の「十一月の犯罪者」との連立に反対している。当然、<span style="color: #7A3C00;">**NSDAP**</span>も連立政権に関心がない。このため多数派連立を組むだけの票は集まらない。?][? if right_coalition >= 50 and dnvp_ideology == "Moderate" : <span style="color: #3E88B3;">**DNVP**</span>と保守系小政党を含む右翼連立には十分な議席がある。<span style="color: #3E88B3;">**DNVP**</span>は、閣外協力でブリューニング内閣が我々の票に依存する事態を避けるため、喜んで入閣する。?][? if right_coalition < 50 and center_right_coalition >= 50 and dnvp_ideology == "Moderate" and not lvp_formed : <span style="color: #3E88B3;">**DNVP**</span>と保守系小政党だけでは右翼連立の議席が足りない。しかし<span style="color: #D3C24D;">**[+ ddp_name +]**</span>の参加によって不足は補われた。<span style="color: #3E88B3;">**DNVP**</span>は、閣外協力でブリューニング内閣が我々の票に依存する事態を避けるため、喜んで入閣する。?][? if right_coalition < 50 and dnvp_ideology == "Radical" : <span style="color: #3E88B3;">**DNVP**</span>を含む右翼連立には議席が足りず、同党も[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]の「十一月の犯罪者」との連立に関心がない。当然、<span style="color: #7A3C00;">**NSDAP**</span>も連立政権に関心がない。多数派連立への道は存在しない。?][? if right_coalition < 50 and center_right_coalition < 50 and dnvp_ideology == "Moderate" and not lvp_formed : <span style="color: #3E88B3;">**DNVP**</span>と保守系小政党を含む右翼連立には議席が足りず、<span style="color: #D3C24D;">**[+ ddp_name +]**</span>が加わっても届かない。それでも両党はブリューニングの大統領内閣に入る。当然、<span style="color: #7A3C00;">**NSDAP**</span>も連立政権に関心がない。多数派連立への道は存在しない。?][? if right_coalition < 50 and center_right_coalition < 50 and dnvp_ideology == "Moderate" and lvp_formed: <span style="color: #3E88B3;">**DNVP**</span>と保守系小政党を含む右翼連立には議席が足りない。それでも両者はブリューニングの大統領内閣に入る。当然、<span style="color: #7A3C00;">**NSDAP**</span>も連立政権に関心がない。多数派連立への道は存在しない。?]

[? if not (right_coalition < 50 and center_right_coalition >= 50 and dnvp_ideology == "Moderate" and not lvp_formed) or (right_coalition >= 50 and dnvp_ideology == "Moderate") : 少なくとも政権に「閣外協力」しなければ、数か月後には再選挙となる。その間、大統領と首相は憲法第48条の緊急権を用い、事実上の命令統治を行うかもしれない。次の選挙で我々が議席を伸ばせる保証も全くない。?]

