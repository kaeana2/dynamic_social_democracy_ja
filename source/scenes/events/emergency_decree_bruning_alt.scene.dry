if (Q.emergency_decree_mitigated) {
    Q.unemployed -= 0.5;
    Q.budget -= 1;
    Q.inflation += 0.8;
    Q.economic_growth += 0.5;
    Q.new_middle_ddp += 2;
    Q.old_middle_ddp += 1;
    Q.new_middle_dvp += 3;
    Q.old_middle_dvp += 3;
    Q.rural_dvp += 1;
    Q.new_middle_lvp += 4;
    Q.old_middle_lvp += 6;
