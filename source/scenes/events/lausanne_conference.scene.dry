title: ローザンヌ会議
subtitle: 賠償問題をめぐって……。
view-if: year = 1932 and month >= 7 and hoover_moratorium_seen and foreign_minister_party != "SPD" and not reparations_resolved and chancellor != "Papen"
on-arrival: {!
Q.reparations = -2;
Q.budget += 1;
Q.pro_republic += 8;
Q.hindenburg_angry -= 30;
Q.hindenburg_angry_bruning -= 75;
Q.lausanne_seen = 1;
Q.reparations_resolved = 1;
Q.dvp_left += 3;
Q.lvp_left += 3;
Q.ddp_left += 2;
Q.ddp_cohesion += 2;
Q.coalition_dissent -= 2;

if (Q.spd_in_government) {
    if (foreign_minister_party === "DVP") {
        Q.new_middle_dvp += 3;
        Q.old_middle_dvp += 3;
        Q.rural_dvp += 3;
    } else if (foreign_minister_party === "LVP") {
        Q.workers_lvp += 3;
        Q.new_middle_lvp += 3;
        Q.old_middle_lvp += 3;
        Q.rural_lvp += 3;
    } else if (foreign_minister_party === "Z") {
        if (!Q.stegerwald_path) {
            Q.workers_z += 3;
            Q.new_middle_z += 3;
            Q.old_middle_z += 3;
            Q.rural_z += 3;
            Q.catholics_z += 3;
        } else if (Q.stegerwald_path) {
            Q.workers_z += 5;
            Q.new_middle_z += 5;
            Q.old_middle_z += 5;
            Q.rural_z += 5;
            Q.unemployed_z += 3;
            Q.catholics_z += 5;
        }
    }
}

if (Q.bruning_time) {
    if (Q.dnvp_ideology == "Moderate" && (Q.in_center_right_coalition || Q.in_right_coalition || Q.spd_toleration_right)) {
        Q.workers_dnvp += 2;
        Q.new_middle_dnvp += 4;
        Q.old_middle_dnvp += 4;
        Q.rural_dnvp += 4;
        Q.workers_dnf -= 2;
        Q.new_middle_dnf -= 4;
        Q.old_middle_dnf -= 4;
        Q.rural_dnf -= 4;
    } else if (Q.dnvp_ideology == "Radical") {
        Q.workers_kvp += 3;
        Q.new_middle_kvp += 5;
        Q.old_middle_kvp += 5;
        Q.rural_kvp += 5;
        Q.workers_dnvp -= 3;
        Q.new_middle_dnvp -= 5;
        Q.old_middle_dnvp -= 5;
        Q.rural_dnvp -= 5;
        if (!Q.kvp_formed) {
            Q.workers_other += 3;
            Q.new_middle_other += 5;
            Q.old_middle_other += 5;
            Q.rural_other += 5;
            Q.catholics_other += 3;
        }
    }
    if (!Q.stegerwald_path) {
        Q.workers_z += 3;
        Q.new_middle_z += 3;
        Q.old_middle_z += 3;
        Q.rural_z += 3;
        Q.catholics_z += 3;
    } else if (Q.stegerwald_path) {
        Q.workers_z += 5;
        Q.new_middle_z += 5;
        Q.old_middle_z += 5;
        Q.rural_z += 5;
        Q.unemployed_z += 3;
        Q.catholics_z += 5;
    }
    Q.new_middle_ddp += 3;
    Q.old_middle_ddp += 3;
    Q.new_middle_dvp += 4;
    Q.old_middle_dvp += 4;
    Q.rural_dvp += 3;
    
    Q.new_middle_lvp += 6;
    Q.old_middle_lvp += 6;
    Q.rural_lvp += 4;

    Q.workers_nsdap *= 0.9;
    Q.new_middle_nsdap *= 0.9;
    Q.old_middle_nsdap *= 0.9;
    Q.rural_nsdap *= 0.9;
    Q.unemployed_nsdap *= 0.9;
    Q.catholics_nsdap *= 0.9;
}

Q.bruning_coalition_dissent -= 3;
Q.dnvp_angry -= 4;
!}
