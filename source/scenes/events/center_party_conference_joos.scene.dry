Q.z_relation -= 10;

if ((Q.spd_in_foreign_time >= 24 && (!Q.reichskonkordat_progress && Q.in_weimar_coalition && Q.foreign_minister_party == "SPD")) && (Q.spd_prussia_time >= 30 && !Q.prussian_concordat_progress)) {
