    cardEl.appendChild(image);  
    var contentDiv = document.querySelector("#page #mid_panel #content");
    contentDiv.appendChild(cardEl);
!}

= <span style="color: #6A1E1E;">**DSU**</span>の政策

<span style="color: #7A3C00;">ナチ党</span>は入閣を果たし、独自の政策路線を推し進めようとしている。

- @interior
- @works
- @works_alt

@interior
title: <span style="color: #7A3C00;">ナチ党</span>が国旗団と<span style="color: #700000;">**RFB**</span>を弾圧！
subtitle: 内務省のヴィルヘルム・フリックによる命令。
on-arrival: {!
Q.schleicher_spd_r -= 1;
Q.schleicher_spd_support -= 2;
Q.rb_militancy *= 0.95;
Q.rb_strength *= 0.95;
Q.rfb_militancy *= 0.9;
Q.rfb_strength *= 0.9;
Q.sa_strength += 25;
Q.sa_militancy += 0.03;
Q.prussian_police_loyalty -= 0.1;
Q.interior_police_loyalty -= 0.2;

Q.workers_spd -= 2;
Q.workers_kpd -= 2;
Q.workers_nsdap += 2;

Q.unemployed_spd -= 3;
Q.unemployed_kpd -= 3;
Q.unemployed_nsdap += 3;

if (Q.prussia_leader === "Strasser") {
  Q.prussian_police_loyalty -= 0.1;
}

if (Q.prussian_police_loyalty < 0) {
  Q.prussian_police_loyalty = 0;
}
if (Q.interior_police_loyalty < 0) {
  Q.interior_police_loyalty = 0;
}

Q.dsu_policy += 1;
!}
view-if: dsu_policy != 2
go-to: interior_1 if not dsu_policy; interior_2 if dsu_policy
face-image: img/portraits/frick.jpg

@interior_1

内務省を掌握した<span style="color: #7A3C00;">ナチ党</span>は、連邦警察を管轄下に置いた。[? if prussia_leader != "Strasser": プロイセン内務省を支配していないため影響範囲は限られるが、連邦警察をすでに<span style="color: #7A3C00;">ナチ党</span>へ忠誠を誓う組織へ変え始めている。?][? if prussia_leader == "Strasser": しかし真の獲物はプロイセン内務省であり、その警察は今や完全に彼らの指揮に服し、<span style="color: #000000;">共和</span><span style="color: #DD0000;">主義</span><span style="color: #FFCC00;">者</span>の官吏が大規模に追放されている。?]幸い、シュライヒャーは国軍ですでに実施しているのと同じ制限を維持し、<span style="color: #7A3C00;">ナチ党</span>員の警察加入を禁じている。

近頃、警察は国旗団と<span style="color: #700000;">**RFB**</span>の闘士だけを標的とする一方、我々の抗議から<span style="color: #7A3C00;">極</span><span style="color: #3E88B3;">右</span>のデモを公然と保護している。指揮系統の一元化が必要だとしてシュライヒャーを説得し、国軍民兵の指揮権まで内務省へ移管させた。

@interior_2

<span style="color: #7A3C00;">ナチ党</span>は「暴力を扇動した」というでっち上げを口実に、合法的な<span style="color: #c00000;">左翼</span>活動まで弾圧し続けている。フリックは民主主義者をはじめとする勢力を弾圧し、シュライヒャーの汚れ仕事を代行しているようだ。その間もシュライヒャーは多くの労働者から高く評価されている。

@works
title: 「MEFO手形」
subtitle: 経済省のヒャルマル・シャハトによる命令。
view-if: dsu_policy == 2 and not mefo_bills_alt
on-arrival: {!
Q.schleicher_spd_r -= 1;
Q.schleicher_spd_support -= 2;

Q.schleicher_economy_time += 24;

Q.unemployed -= 1;
Q.inflation += 0.5;
Q.economic_growth += 0.5;
Q.schleicher_approval += 2;

Q.reichswehr_militancy += 2;

Q.mefo_bills = 1;
Q.dsu_policy += 1;
!}
face-image: img/portraits/SchachtHjalmar.jpg

ヒャルマル・シャハトはケインズ主義者ではないが、大規模な公共事業と国家資金による計画こそ、ドイツが不況から脱し、国際舞台で大国の地位を取り戻す道だと理解している。<span style="color: #002654;">フランス</span>と<span style="color: #C8102E;">イギリス</span>が自国の経済問題に忙殺される今こそ、大規模な工業化と再軍備計画を実施する好機だと考えている。

シュライヒャーの公共事業計画を拡大し、低賃金労働者を使った全国的な新高速道路網「アウトバーン」の建設が始まった。再軍備を隠蔽する革新的な新手法も考案された。「MEFO手形」と呼ばれる、ダミー会社を通じて約束手形を発行し、政府の公式予算に支出を計上せず秘密裏に兵器生産へ資金を供給する仕組みである。ただしシャハトは、ドイツ経済の再生を再軍備より優先すべきだと主張している。

- @reichsbank

@reichsbank
title: ライヒスバンクの判断は？
subtitle: ライヒスバンク総裁――[? if luther_reichsbank: ハンス・ルター?][? if not luther_reichsbank: フリードリヒ・ドライゼ?]
go-to: reichsbank_luther if luther_reichsbank; reichsbank_dreyse if not luther_reichsbank


@reichsbank_luther
face-image: img/portraits/luther.jpg

厳格な財政保守主義と執拗な反インフレ姿勢で知られるライヒスバンクは、シュライヒャーの当初の公共事業令をすでに15％削減していた。さらに大規模な政府支出の知らせに反対したのも驚くことではない。

しかし、ハイパーインフレーションを終息させた功績を持つ、尊敬された銀行家で前ライヒスバンク総裁のヒャルマル・シャハトが計画を支持したことで、実業界は大いに落ち着いた。政府の圧力を受け、ライヒスバンクは最終的に計画支持を強いられる。

@reichsbank_dreyse
face-image: img/portraits/dreyse.jpg

厳格な財政保守主義と執拗な反インフレ姿勢で知られるライヒスバンクは、シュライヒャーの当初の公共事業令をすでに15％削減していた。さらに大規模な政府支出の知らせに反対したのも驚くことではない。

しかし、ハイパーインフレーションを終息させた功績を持つ、尊敬された銀行家で前ライヒスバンク総裁のヒャルマル・シャハトが計画を支持したことで、実業界は大いに落ち着いた。政府の圧力を受け、ライヒスバンクは最終的に計画支持を強いられる。

@works_alt
title: 「MEFO手形」
subtitle: 経済省のヒャルマル・シャハトによる命令。
view-if: dsu_policy == 2 and mefo_bills_alt
on-arrival: {!
Q.schleicher_spd_r -= 2;
Q.schleicher_spd_support -= 3;
Q.schleicher_spd_influence -= 1;

Q.schleicher_economy_time += 24;

Q.unemployed -= 0.8;
Q.inflation += 0.4;
Q.economic_growth += 0.4;

Q.schleicher_approval += 1;

Q.reichswehr_militancy += 1.5;

Q.mefo_bills = 1;
Q.dsu_policy += 1;
!}
face-image: img/portraits/SchachtHjalmar.jpg

公共事業計画はヒャルマル・シャハトの経済相就任以前に拡大されていたが、彼は今やそれを基礎に、シュライヒャーの野心により近い大規模工業化・再軍備計画へ変えようとしている。それによって初めて、ドイツは列強に対抗できるというのだ。

再軍備を隠蔽する革新的な新手法も考案された。「MEFO手形」と呼ばれる、ダミー会社を通じて約束手形を発行し、政府の公式帳簿に支出を計上せず秘密裏に兵器生産へ資金を供給する仕組みである。それでもシャハトは、少なくとも当面はドイツ経済の再生を再軍備より優先すべきだと主張している。
