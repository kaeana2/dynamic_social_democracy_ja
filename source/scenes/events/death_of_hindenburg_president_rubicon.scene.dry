title: ヒンデンブルクの死
subtitle: 大統領が死去した……
new-page: true
view-if: year = 1934 and month >= 8 and president = "Hindenburg" and dnef_formed
on-arrival: {!
for (var c of Q.classes) {
    var class_votes = 0;
    for (var party of Q.parties) {
        if (Q[c+'_'+party] < 0) {
            Q[c+'_'+party] = 0;
        }
        class_votes += Q[c+'_'+party];
    }
    for (var party of Q.parties) {
        Q[c + '_' + party + '_normalized'] = 100*Q[c+'_'+party]/class_votes;
        Q[c + '_' + party + '_display'] = Math.round(100*Q[c+'_'+party]/class_votes);
    }
}
// calculate support for each of the parties
var total_support = 0; 
for (var party of Q.parties) {
    var party_support = 0;
    for (var c of Q.classes) {
        if (Q.old_demographics) { 
            party_support += Q[c]*Q[c+'_'+party];
        } else  { 
            party_support += Q[c]*Q[c+'_'+party+'_normalized'];
        } 
    }
    Q[party + '_support'] = party_support;
    total_support += party_support; 
    if (party == "nsdap" && Q.nsdap_split) {
        Q.nsdap_hitler_support = Q.rural_nsdap_normalized*Q.rural;
        Q.nsdap_hitler_support += Q.old_middle_nsdap_normalized*Q.old_middle;
        Q.nsdap_hitler_support += Q.catholics_nsdap_normalized*Q.catholics;

        if (Q.dsu_exist && !Q.nvf_exist) {
            Q.dsu_support = Q.workers_nsdap*Q.workers*((120 - Q.sa_force) / 100);
            Q.dsu_support += Q.unemployed_nsdap*Q.unemployed*((80 - Q.sa_force) / 100);
            Q.dsu_support += Q.new_middle_nsdap*Q.new_middle;
        } else if (!Q.dsu_exist && Q.nvf_exist) {
            Q.nvf_support = Q.unemployed_nsdap*Q.unemployed*((120 - Q.sa_force) / 100);
            Q.nvf_support += Q.workers_nsdap*Q.workers*((Q.sa_force - 80) / 100);
            Q.nvf_support += Q.new_middle_nsdap*Q.new_middle;
        } else if (Q.dsu_exist && Q.nvf_exist) {
            Q.dsu_support = Q.workers_nsdap*Q.workers*((120 - Q.sa_force) / 100);
            Q.dsu_support += Q.unemployed_nsdap*Q.unemployed*((80 - Q.sa_force) / 100);
            Q.dsu_support += Q.new_middle_nsdap*Q.new_middle;

            Q.nvf_support = Q.unemployed_nsdap*Q.unemployed*((120 - Q.sa_force) / 100);
            Q.nvf_support += Q.workers_nsdap*Q.workers*((Q.sa_force - 80) / 100);
        } else {
            Q.nsdap_hitler_support += Q.workers_nsdap*Q.workers;
            Q.nsdap_hitler_support += Q.unemployed_nsdap*Q.unemployed;
            Q.nsdap_hitler_support += Q.new_middle_nsdap*Q.new_middle;
        }
    }
}
// 2. normalize support (fraction)
for (var party of Q.parties) {
    Q[party+'_normalized'] = Q[party + '_support']/total_support;
    if (party == "nsdap" && Q.nsdap_split) {
        Q.nsdap_hitler_normalized = Q.nsdap_hitler_support / total_support;
        Q.dsu_normalized = Q.dsu_support / total_support;
        Q.nvf_normalized = Q.nvf_support / total_support;
        Q.nsdap_hitler_votes = Math.round(Q.nsdap_hitler_normalized*1000) / 10;
        Q.dsu_votes = Math.round(Q.dsu_normalized*1000) / 10;
        Q.nvf_votes = Math.round(Q.nvf_normalized*1000) / 10;
    }
    Q[party+'_votes'] = Math.round(Q[party+'_normalized']*1000)/ 10;
}

Q.round = 0;
Q.hindenburg_dead = 1;
Q.president = "Bumke (acting)";
if (Q.judicial_reform >= 4) Q.president = "Großmann (acting)"

Q.Heuss_votes_pre = 0;

Q.dnef_candidate = "Hammerstein";
Q.spd_candidate = "Schumacher";
Q.kpd_candidate = Q.spd_candidate;
Q.z_candidate = "Adenauer";
if (Q.z_leader == "Bracht") Q.z_candidate = Q.dnef_candidate;
Q.ddp_candidate = "Heuss";
Q.lvp_candidate = "Heuss";
Q.dvp_candidate = "Heuss";
if (Q.dstp_dnef) Q.ddp_candidate = Q.dnef_candidate;
if (Q.lvp_dnef) Q.lvp_candidate = Q.dnef_candidate;
if (Q.dvp_dnef) Q.dvp_candidate = Q.dnef_candidate;
Q.heuss_run = 1;
if (Q.ddp_candidate == "Heuss") Q.Heuss_votes_pre += Q.ddp_votes;
if (Q.lvp_candidate == "Heuss") Q.Heuss_votes_pre += Q.lvp_votes;
if (Q.dvp_candidate == "Heuss") Q.Heuss_votes_pre += Q.dvp_votes;
if (Q.Heuss_votes_pre < 8) {
    if (Q.z_candidate != Q.dnef_candidate) Q.ddp_candidate = Q.z_candidate;
    if (Q.z_candidate != Q.dnef_candidate) Q.lvp_candidate = Q.z_candidate;
    if (Q.z_candidate != Q.dnef_candidate) Q.dvp_candidate = Q.z_candidate;
    if (Q.z_candidate == Q.dnef_candidate) Q.ddp_candidate = Q.dnef_candidate;
    if (Q.z_candidate == Q.dnef_candidate) Q.lvp_candidate = Q.dnef_candidate;
    if (Q.z_candidate == Q.dnef_candidate) Q.dvp_candidate = Q.dnef_candidate;
    if (Q.dstp_dnef) Q.ddp_candidate = Q.dnef_candidate;
    if (Q.lvp_dnef) Q.lvp_candidate = Q.dnef_candidate;
    if (Q.dvp_dnef) Q.dvp_candidate = Q.dnef_candidate;
    Q.heuss_run = 0;
}
Q.nsdap_candidate = "Göring";
Q.nsdap_hitler_candidate = "Göring";
if (Q.dsu_leader != "Otto Strasser") Q.dsu_candidate = "Frick";
if (Q.dsu_leader == "Otto Strasser") Q.dsu_candidate = "Strasser";
Q.nvf_candidate = "Boycott";
if (Q.nvf_dnef) Q.nvf_candidate = "Hammerstein";
Q.dnvp_candidate = "Hammerstein";
Q.other_candidate = "Hammerstein";
Q.is_unity_candidate = 0;
Q.sapd_candidate = Q.kpd_candidate;
Q.kvp_candidate = Q.dnvp_candidate;
Q.dnf_candidate = Q.dnvp_candidate;
!}
max-visits: 1
on-display: {!  
    var cardEl = document.createElement('div');  
    cardEl.className = "face-figure2";  

    var image = new Image();  
    image.className = "face-img";  
    image.src = "img/Hindenburg_head.jpg";  

    cardEl.appendChild(image);  
    var contentDiv = document.querySelector("#page #mid_panel #content");
    contentDiv.appendChild(cardEl);
!}
tags: event

= ヒンデンブルクの死

パウル・フォン・ヒンデンブルク大統領が86歳で死去した。一つの歴史的時代が幕を閉じる。未来がどうなるかはまだ分からない。

戦争の英雄であり大統領であった人物の死に国中が悲嘆に暮れた。ただし、服喪は主として政治的右派に限られる。シュライヒャーも長くはないと見られ、ドイツの二人の強権者の時代は終わりに近づいている。次なる<span style="color: #000000;">ワイ</span><span style="color: #DD0000;">マー</span><span style="color: #FFCC00;">ル</span>共和国の章を誰が記すのか――今後もそう呼べるならば――国は決めなければならない。

新たな大統領選挙は可能な限り早く実施される。<span style="color: #BFC8CC;">**DNEF**</span>は統一候補を立てる見込みで、その勝利は当面の権力掌握を完全なものにする。何としても阻止しなければならない。それまで最高裁判所長官[? if judicial_reform < 4 : エルヴィン・ブムケ?][? if judicial_reform >= 4 : ヘルマン・グロースマン?]が大統領代行を務める。

- @candidates: 現時点の候補者は誰か？

@candidates

<span style="color: #BFC8CC;">**DNEF**</span>は、国軍将軍でシュライヒャーの長年の友人、現陸軍統帥部長クルト・フォン・ハンマーシュタイン＝エクヴォルトを指名した。彼は自らを政党ではなく国家への奉仕者と考え、ここ数か月はシュライヒャーと労働組合の連絡役を務め、国軍拡張の監督も担った。思想的信条はほとんど知られておらず、シュライヒャー同様に柔軟である。

- @candidates_nazis

@candidates_nazis
title: <span style="color: #7A3C00;">ナチ党</span>最後の歓声か？

ヒトラーが政界から消えたため、<span style="color: #7A3C00;">ナチ党</span>はヘルマン・ゲーリングを候補に立てる。

<span style="color: #6A1E1E;">**DSU**</span>は[? if dsu_candidate == "Strasser": 党首オットー・シュトラッサーを独自候補として擁立する。?][? if dsu_candidate == "Frick": ヴィルヘルム・フリックを独自候補として擁立する。?]

[? if nvf_candidate == dnef_candidate: <span style="color: #142e20;">**NVF**</span>の残党はなお<span style="color: #BFC8CC;">**DNEF**</span>傘下にあるため、[+ dnef_candidate +]を支持する。?][? if nvf_candidate != dnef_candidate: <span style="color: #142e20;">**NVF**</span>の残党は選挙を全面的にボイコットし、武装蜂起の「好機」を待つという妄想的方針を続ける。?]

<span style="color: #7A3C00;">ナチ運動</span>が分裂したままでは、いずれの候補にも勝機は全くない。

- @candidates_nats

@candidates_nats
title: 次は<span style="color: #3E88B3;">民族主義者</span>である。

<span style="color: #3E88B3;">民族主義者</span>は[+ dnef_candidate +]支持で結束し、各分派とブルジョワ小政党も加わった。フーゲンベルクは驚くべきことになお大統領選出馬を考えていたが、強い調子の脅迫を受けて沈黙した。

- @candidates_dems

@candidates_dems
title: <span style="color: #700000;">**共産主義者**</span>は？　<span style="color: #000000;">ワイ</span><span style="color: #DD0000;">マー</span><span style="color: #FFCC00;">ル</span>諸党は？　誰を支持するのか？

シュライヒャー在任中に激しく弾圧された<span style="color: #700000;">**共産主義者**</span>は、もはや重要な政治勢力ではない。[? if kpd_banned: 党そのものまで禁止され、独自候補を支持できない。ボイコットも無意味となり、我々の擁立候補を支持するしかない。?][? if not kpd_banned: 数か月前のシュライヒャー弾圧から救った我々の役割に感謝し、我々の擁立候補を全面的に支持する。?]

[? if z_candidate == "Adenauer": <span style="color: #000000;">中央党</span>は[+ dnef_candidate +]支持に納得しきれず、コンラート・アデナウアーを独自候補として立てた。共和国成立以来のケルン市長でプロイセン州議会議員でもある彼は、プロテスタントへ支持を広げるため<span style="color: #000000;">中央党</span>が「塔を出る」ことを唱え、シュテーガーヴァルト本人が最初に推薦した。党内右派に属しながらも<span style="color: #000000;">ワイ</span><span style="color: #DD0000;">マー</span><span style="color: #FFCC00;">ル</span>共和国を断固支持し、シュライヒャーの威嚇に反対している。?]

[? if heuss_run: <span style="color: #FFCC00;">自由主義者</span>は、ジャーナリストで<span style="color: #000000;">ワイ</span><span style="color: #DD0000;">マー</span><span style="color: #FFCC00;">ル</span>共和国の公然たる支持者、党内の断固たる反シュライヒャー派であるテオドール・ホイスを擁立した。この立場により、ドイツ中間層の親シュライヒャー勢力と対立している。大きな支持は見込めないが、ホイスは[+ dnef_candidate +]に対抗する「<span style="color: #000000;">ワイ</span><span style="color: #DD0000;">マー</span><span style="color: #FFCC00;">ル</span>」統一候補を自任している。?][? if not heuss_run and ddp_candidate == z_candidate and z_candidate != dnef_candidate: 選挙で壊滅した<span style="color: #FFCC00;">自由主義者</span>には独自候補を立てる資源も気力もなく、シュライヒャーに代わるブルジョワ候補として[+ z_candidate +]を支持した。だが結束は弱い。歴史的に民族主義的なドイツ自由主義運動には国民的連帯を説く彼の主張がなお響き、親シュライヒャー派が独自行動を続けている。?][? if not heuss_run and ddp_candidate == dnef_candidate: 選挙で壊滅した<span style="color: #FFCC00;">自由主義者</span>には独自候補を立てる資源も気力もなく、親シュライヒャー派と党員に強く響いた宣伝の影響を受けて[+ dnef_candidate +]支持へ回った。党内の多くは、シュライヒャーとその後継者を支持することが国民的義務であり、対外的な大国の地位回復と国内での譲歩獲得へ至る唯一の道だと考えている。?]

- @candidates_spd

@candidates_spd
title: 最後に、我々はどうする？
go-to: candidate_menu

<span style="color: #c00000;">**SPD**</span>は<span style="color: #000000;">ワイ</span><span style="color: #DD0000;">マー</span><span style="color: #FFCC00;">ル</span>連合の統一候補を支持することも、独自候補を立てることもできる。ただし統一戦線が成立するかは、かつての連立相手との関係と、彼らがシュライヒャーの影響下に入ったかどうかに左右される。

オットー・ブラウンは疲れ切っている。過去2回の大統領選に出馬して敗れ、もはや出馬を望まない。妻の病状も重く、そのそばにいたいと願っている。何より、現在の情勢を深く悲観している。

クルト・シューマッハーは野心的な党の新星で、喜んで出馬するだろう。大戦の英雄だが、比較的若いことが問題になるかもしれない。

@candidate_menu

- @hammerstein_r1: <span style="color: #BFC8CC;">**DNEF**</span>の[+ dnef_candidate +]を支持する。
- @adenauer_r1: [? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]のコンラート・アデナウアーを支持する。
- @heuss_r1: [? if not lvp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>?][? if lvp_formed: <span style="color: #FFCC00;">**LVP**</span>?]のテオドール・ホイスを支持する。
- @schumacher_r1: クルト・シューマッハーを擁立する。
- @abstain: 何もしない。

@abstain
view-if: resources < 2
on-arrival: spd_candidate = "Boycott"; kpd_candidate = "Boycott"; sapd_candidate = "Boycott"
go-to: r1_menu

何とも締まらない結末である。

- @round_1: 投票を開始する。

@hammerstein_r1
unavailable-subtitle: 我々は民主政党である。
choose-if: schleicher_spd_influence >= 8
on-arrival: spd_candidate = dnef_candidate; kpd_candidate = "Boycott"; sapd_candidate = "Boycott"
go-to: r1_menu

それなりの理由があることを願う。

- @round_1: 投票を開始する。

@adenauer_r1
view-if: z_candidate == "Adenauer"
on-arrival: spd_candidate = "Adenauer"; kpd_candidate = "Boycott"; sapd_candidate = "Boycott"; z_relation += 5; center_bvp_votes = 1 if z_relation < 50; is_unity_candidate = 1
go-to: r1_menu

我々は[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]のコンラート・アデナウアーを支持した。シュライヒャーに対抗する<span style="color: #000000;">ワイ</span><span style="color: #DD0000;">マー</span><span style="color: #FFCC00;">ル</span>・ブロックを形成できるかもしれない。

[? if z_relation < 50 : 我々がアデナウアーを支持したことで、<span style="color: #A2D8E0;">バイエルン人民党</span>の最保守派の一部は[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]と袂を分かち、[+ dnef_candidate +]支持へ移った。1925年大統領選の再現にならなければよいが。?]

@heuss_r1
view-if: heuss_run
on-arrival: spd_candidate = "Heuss"; kpd_candidate = "Boycott"; sapd_candidate = "Boycott"; ddp_relation += 8; lvp_relation += 5; dvp_candidate = dnef_candidate if dvp_relation < 60 and dvp_candidate == spd_candidate and dvp_exist and not lvp_formed; is_unity_candidate = 1
go-to: r1_menu

我々は[? if not lvp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>?][? if lvp_formed:
<span style="color: #FFCC00;">**LVP**</span>?]のジャーナリスト、テオドール・ホイスを支持した。シュライヒャーに対抗する<span style="color: #000000;">ワイ</span><span style="color: #DD0000;">マー</span><span style="color: #FFCC00;">ル</span>・ブロックを形成できるかもしれない。

[? if dvp_relation < 60 and dvp_candidate == spd_candidate and dvp_exist and not lvp_formed: 我々がホイスを支持したことで、彼を支持していた<span style="color: #C0A054;">**DVP**</span>諸派は離反し、まだであれば[+ dnef_candidate +]支持へ移った。?]

@schumacher_r1
subtitle: 資源 -2。
unavailable-subtitle: [? if resources < 2 : 資源 -2 ― 資源が足りない。?]
choose-if: resources >= 2
on-arrival: spd_candidate = "Schumacher"; resources -= 2; is_unity_candidate = 0
go-to: r1_menu

我々の大統領候補としてクルト・シューマッハーを擁立した。しかし大きく右傾化した党も多い<span style="color: #000000;">ワイ</span><span style="color: #DD0000;">マー</span><span style="color: #FFCC00;">ル</span>諸党に、<span style="color: #c00000;">社会主義者</span>への公然たる支持を取りつけるのは容易ではない。

@r1_menu
view-if: round = 0

- @convince_z_unity
- @convince_z_spd
- @convince_lvp_spd
- @convince_lvp_unity
- @convince_ddp_spd
- @convince_ddp_unity
- @convince_dvp_unity
- @round_1: 投票を開始する。


# convincing Z to support a unity candidate
@convince_z_unity
title: [? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]に[+ spd_candidate +]支持を求める。
view-if: spd_candidate = "Heuss" and z_candidate != spd_candidate
on-arrival: {!
Q.z_support_braun = 0;
if (Q.z_relation >= 60 || (Q.z_relation > 50 && Q.z_ideology == "Left")) {
    Q.z_support_braun = 1;
} else if (Q.z_relation < 35) {
    Q.z_support_braun = 0;
} else {
    Q.z_support_braun = 2;
}
if (Q.z_candidate == Q.dnef_candidate) Q.z_support_braun = 0;
!}
max-visits: 1
go-to: z_failed if z_support_braun = 0 or (z_support_braun == 2 and historical_mode); z_success if z_support_braun = 1; z_partial if z_support_braun = 2 and not historical_mode

[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]に、[+ spd_candidate +]をシュライヒャーに対抗する統一候補として支持するよう訴えた。<span style="color: #000000;">ワイ</span><span style="color: #DD0000;">マー</span><span style="color: #FFCC00;">ル</span>連合が団結すれば<span style="color: #BFC8CC;">**DNEF**</span>を破れると主張した。[? if z_relation >= 50 : さらに、1918年以来の両党の協力の歴史を思い起こさせた。?]

@convince_z_spd
title: [? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]に[+ spd_candidate +]支持を求める。
choose-if: spd_votes >= z_votes
unavailable-subtitle: [? if spd_votes < z_votes: [? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]は我々より支持が多いと分かっており、我々の候補を支持する理由を見いだしていない。?]
view-if: spd_candidate == "Schumacher" and z_candidate != spd_candidate
on-arrival: {!
Q.z_support_braun = 0;
if (Q.z_relation >= 75 || (Q.z_relation > 65 && Q.z_ideology == "Left")) {
    Q.z_support_braun = 1;
} else if (Q.z_relation < 55) {
    Q.z_support_braun = 0;
} else {
    Q.z_support_braun = 2;
}
if (Q.z_candidate == Q.dnef_candidate) Q.z_support_braun = 0;
!}
max-visits: 1
go-to: z_failed if z_support_braun = 0 or (z_support_braun == 2 and historical_mode); z_success if z_support_braun = 1; z_partial if z_support_braun = 2 and not historical_mode

