@round_1
go-to: election_algorithm
set-jump: post_election


@post_election
on-arrival: {!
var candidate_descs = {
  Strasser: "<span style='color: #6A1E1E; font-weight: bold;'>DSU</span>のオットー・シュトラッサー",
  Frick: "<span style='color: #6A1E1E; font-weight: bold;'>DSU</span>のヴィルヘルム・フリック",
  Goring: "<span style='color: #7A3C00; font-weight: bold;'>NSDAP</span>のヘルマン・ゲーリング",
  Hammerstein: "<span style='color: #BFC8CC; font-weight: bold;'>DNEF</span>のクルト・フォン・ハンマーシュタイン＝エクヴォルト",
  Adenauer: "<span style='color: #000000; font-weight: bold;'>中央党</span>のコンラート・アデナウアー",
  Heuss: "<span style='color: #D3C24D; font-weight: bold;'>DDP</span>のテオドール・ホイス",
  Schumacher: "<span style='color: #c00000; font-weight: bold;'>SPD</span>のクルト・シューマッハー"
};

if (Q.dstp_formed) {
    candidate_descs.Heuss = "<span style='color: #D3C24D; font-weight: bold;'>DStP</span>のテオドール・ホイス";
}
if (Q.lvp_formed) {
    candidate_descs.Heuss = "<span style='color: #FFCC00; font-weight: bold;'>LVP</span>のテオドール・ホイス";
}
if (Q.z_party_name == "CVP") {
    candidate_descs.Adenauer = "<span style='color: #000000; font-weight: bold;'>CVP</span>のコンラート・アデナウアー";
}
for (var k in candidate_descs) {
    Q[k + '_running'] = 0;
}
var candidate_votes = {};
Q.parties_election = Q.parties;
if (Q.dsu_exist) {
    Q.parties_election.push('nsdap_hitler');
    Q.parties_election.push('dsu');
    Q.nsdap_normalized = 0;
}
if (Q.nvf_exist) {
    Q.parties_election.push('nvf');
    Q.nsdap_normalized -= Q.nvf_normalized;
    Q.nsdap_normalized = 0;
}
if (Q.center_bvp_votes) {
    Q.bvp_normalized = Q.bvp_votes / 100;
    Q.z_normalized -= Q.bvp_normalized;
    Q.parties_election.push('bvp')
    Q.bvp_candidate = Q.dnef_candidate;
}
for (var party of Q.parties_election) {
    var supported_candidate = Q[party + '_candidate'];
    supported_candidate = supported_candidate.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    Q[supported_candidate + '_running'] = 1;
    if (supported_candidate in candidate_votes) {
        candidate_votes[supported_candidate] += Q[party + '_normalized'];
    } else {
        candidate_votes[supported_candidate] = Q[party + '_normalized'];
    }
}
var total_votes = 0;
Q.winner = "";  
Q.winner_votes = 0;
Q.has_majority = 0;
for (var k in candidate_votes) {
    total_votes += candidate_votes[k];
    if (candidate_votes[k] > Q.winner_votes) {
        Q.winner = k;
        Q.winner_votes = candidate_votes[k];
    }
    if (candidate_votes[k] >= 0.5) {
        Q.has_majority = 1;
    }
}
for (var k in candidate_votes) {
    Q[k + '_votes'] = Math.round(1000*candidate_votes[k]/total_votes)/10;
    Q[k + '_votes_disp'] = Q[k + '_votes'].toFixed(1);
}
Q.winner_votes = Math.round(1000*Q.winner_votes/total_votes)/10;
Q.winner_votes_disp = Q.winner_votes.toFixed(1);
Q.winner_desc = candidate_descs[Q.winner];

Q.round += 1

if (Q.spd_candidate == "Boycott" || Q.sapd_candidate == "Boycott" || Q.kpd_candidate == "Boycott") {
    Q.boycott_votes = 0;
    if (Q.kpd_candidate == "Boycott") Q.boycott_votes += Q.kpd_votes;
    if (Q.sapd_candidate == "Boycott") Q.boycott_votes += Q.sapd_votes;
    if (Q.spd_candidate == "Boycott") Q.boycott_votes += Q.spd_votes;
}
!}
go-to: r2_start if round = 1 and not has_majority; election_end if round > 1; r1_winner if has_majority

選挙結果：

[? if Goring_running : <span style="color: #7A3C00;">**Göring**</span> - [+ Goring_votes_disp +]% ?]

[? if Strasser_running : <span style="color: #6A1E1E;">**Strasser**</span> - [+ Strasser_votes_disp +]% ?]

[? if Frick_running : <span style="color: #6A1E1E;">**Frick**</span> - [+ Frick_votes_disp +]% ?]

[? if Hammerstein_running : <span style="color: #BFC8CC;">**Hammerstein**</span> - [+ Hammerstein_votes_disp +]% ?]

[? if Adenauer_running : <span style="color: #000000;">**Adenauer**</span> - [+ Adenauer_votes_disp +]% ?]

[? if Heuss_running : [? if not lvp_formed: <span style="color: #D3C24D;">**Heuss**</span>?][? if lvp_formed: <span style="color: #FFCC00;">**Heuss**</span>?] - [+ Heuss_votes_disp +]% ?]

[? if Schumacher_running : <span style="color: #c00000;">**Schumacher**</span> - [+ Schumacher_votes_disp +]% ?]

[? if spd_candidate == "Boycott" or sapd_candidate == "Boycott" or kpd_candidate == "Boycott" : 無効票 ― [+ boycott_votes +]% ?]

@r2_start
on-arrival: {!
Q.adenauer_drops_out = 0;
Q.heuss_drops_out = 0;
if (Q.z_candidate == "Adenauer" && (Q.ddp_candidate == "Heuss" || Q.dvp_candidate == "Heuss" || Q.lvp_candidate == "Heuss") && Q.z_candidate != Q.spd_candidate && (Q.ddp_candidate != Q.spd_candidate || Q.dvp_candidate != Q.spd_candidate || Q.lvp_candidate != Q.spd_candidate)) {
    if (Q.Adenauer_votes > Q.Heuss_votes) {
        Q.heuss_drops_out = 1;
        if (Q.ddp_candidate != Q.spd_candidate && Q.ddp_candidate != Q.dnef_candidate) {
            Q.ddp_candidate = "Adenauer";
        }
        if (Q.dvp_candidate != Q.spd_candidate && Q.dvp_candidate != Q.dnef_candidate) {
            Q.dvp_candidate = "Adenauer";
        }
        if (Q.lvp_candidate != Q.spd_candidate && Q.lvp_candidate != Q.dnef_candidate) {
            Q.lvp_candidate = "Adenauer";
        }
    } else {
        Q.adenauer_drops_out = 1;
        Q.z_candidate = "Heuss";
    }
}
!}
go-to: r2_menu

首位は[+ winner_desc +]である。第1回投票では過半数を得た候補がいない。第2回投票では最多票を得た候補が当選する。

<span style="color: #7A3C00;">ナチ党</span>とその分派は分裂したまま、消えない怨恨に囚われている。そのため[+ dsu_candidate +]と[+ nsdap_candidate +]は別々に出馬を続ける。相互の敵意を棚上げできず、体制との闘争より内輪争いに時間を費やす運動は、事実上死んだも同然である。

[? if heuss_drops_out : 自由主義候補テオドール・ホイスは、[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]のコンラート・アデナウアーを支持して撤退した。これにより穏健<i>ブルジョワ・ブロック</i>の票がまとまり、[+ dnef_candidate +]に善戦する見込みである。?]
[? if adenauer_drops_out : [? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]候補コンラート・アデナウアーは、自由主義候補テオドール・ホイスを支持して撤退した。これにより穏健<i>ブルジョワ・ブロック</i>の票がまとまり、[+ dnef_candidate +]に善戦する見込みである。?]

我々はどうするべきか？

