unavailable-subtitle: [? if resources < 2 : 資源 -2 ― 資源が足りない。?][? if (z_relation < 55 and z_ideology == "Right") or (z_relation < 35 and z_ideology == "Left") : <span style="color: #000000;">中央党</span>との関係を改善する必要がある。?][? if ddp_relation < 35 and not lvp_formed : <span style="color: #D3C24D;">[+ ddp_name +]</span>との関係を改善する必要がある。?][? if lvp_relation < 45 and lvp_formed : <span style="color: #FFCC00;">LVP</span>との関係を改善する必要がある。?]
choose-if: resources >= 2 and ((z_relation >= 55 and z_ideology == "Right") or (z_relation >= 45 and z_ideology = "Left")) and ((ddp_relation >= 35 and not lvp_formed) or lvp_relation >= 45 and lvp_formed)
