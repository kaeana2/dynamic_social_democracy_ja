[? if dvp_candidate = spd_candidate: 良好な関係に加え、我々の候補が<span style="color: #c00000;">**SPD**</span>所属ではない統一候補であるため、<span style="color: #C0A054;">**DVP**</span>は説得され[+ spd_candidate +]支持を受け入れた。?]



@round_1
go-to: election_algorithm
set-jump: post_election


@post_election
on-arrival: {!
var candidate_descs = {
Hitler: "<span style='color: #7A3C00; font-weight: bold;'>NSDAP</span>のアドルフ・ヒトラー",
Goring: "<span style='color: #7A3C00; font-weight: bold;'>NSDAP</span>のヘルマン・ゲーリング",
Seldte: "<span style='color: #3E88B3; font-weight: bold;'>鉄兜団</span>／<span style='color: #3E88B3; font-weight: bold;'>DNVP</span>のフランツ・ゼルテ",
Hergt: "<span style='color: #3E88B3; font-weight: bold;'>DNVP</span>のオスカー・ヘルクト",
Eckener: "無所属の<span style='color: #000000;'>共</span><span style='color: #DD0000;'>和主義</span><span style='color: #FFCC00;'>候補</span>フーゴー・エッケナー",
Adenauer: "<span style='color: #000000;'>中央党</span>のコンラート・アデナウアー",
Bruning: "<span style='color: #000000;'>中央党</span>のハインリヒ・ブリューニング",
Lettow_Vorbeck: "<span style='color: #000000; font-weight: bold;'>CVP</span>のレットウ＝フォルベック",
Gessler: "元<span style='color: #D3C24D; font-weight: bold;'>DDP</span>の無所属、オットー・ゲスラー",
Heuss: "<span style='color: #D3C24D; font-weight: bold;'>DDP</span>のテオドール・ホイス",
Thalmann: "<span style='color: #700000; font-weight: bold;'>KPD</span>のエルンスト・テールマン",
Munzenberg: "<span style='color: #700000; font-weight: bold;'>KPD</span>のヴィリー・ミュンツェンベルク",
Braun: "<span style='color: #c00000; font-weight: bold;'>SPD</span>のオットー・ブラウン",
Schumacher: "<span style='color: #c00000; font-weight: bold;'>SPD</span>のクルト・シューマッハー",
Juchacz: "<span style='color: #c00000; font-weight: bold;'>SPD</span>のマリー・ユハチ",
Einstein: "Albert Einstein, scientist",
Mann: "Heinrich Mann, writer",
Ossietzky: "Carl von Ossietzky, journalist"
}
if (Q.z_party_name == "CVP") {
    candidate_descs.Adenauer = "<span style='color: #000000; font-weight: bold;'>CVP</span>のコンラート・アデナウアー";
    candidate_descs.Bruning = "<span style='color: #000000; font-weight: bold;'>CVP</span>のハインリヒ・ブリューニング";
}
if (Q.lvp_formed) {
    candidate_descs.Heuss = "<span style='color: #FFCC00; font-weight: bold;'>LVP</span>のテオドール・ホイス";
}

if (typeof Q.last_round_candidates === 'undefined') {
    Q.last_round_candidates = [];
}

var candidate_votes = {};
var current_round_candidates = [];

for (var k in candidate_descs) {
    Q[k + '_running'] = 0;
}
for (var i = 0; i < Q.parties.length; i++) {
    var party = Q.parties[i];
    var supported_candidate = Q[party + '_candidate'];
    //console.log(party, supported_candidate);
    supported_candidate = supported_candidate.normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    if (supported_candidate == "Lettow-Vorbeck") supported_candidate = "Lettow_Vorbeck";
    Q[supported_candidate + '_running'] = 1;
    if (!current_round_candidates.includes(supported_candidate)) {
        current_round_candidates.push(supported_candidate);
    }
    if (supported_candidate in candidate_votes) {
        candidate_votes[supported_candidate] += Q[party+'_normalized'];
    } else {
        candidate_votes[supported_candidate] = Q[party+'_normalized'];
    }
}
var total_votes = 0;
Q.winner = "";
Q.winner_votes = 0;
Q.has_majority = 0;

if (Q.Center_bonus && Q.center_candidate_1934 in candidate_votes) {
    Q[Q.center_candidate_1934 + '_bonus'] = Q.Center_bonus;
}

if (Q.Liberal_bonus && Q.lib_candidate_1934 in candidate_votes) {
    Q[Q.lib_candidate_1934 + '_bonus'] = Q.Liberal_bonus;
}

if (Q.Reactionary_bonus && Q.reactionary_candidate_1934 in candidate_votes) {
    Q[Q.reactionary_candidate_1934 + '_bonus'] = Q.Reactionary_bonus;
}

for (var k in candidate_votes) {
    if (Q[k + '_bonus']) {
        candidate_votes[k] += Q[k + '_bonus']/100;
    }
    total_votes += candidate_votes[k];
    if (candidate_votes[k] > Q.winner_votes) {
        Q.winner = k;
        Q.winner_votes = candidate_votes[k];
    }
    if (candidate_votes[k] >= 0.5) {
        Q.has_majority = 1;
    }
} 

for (var k in candidate_votes) {
    Q[k + '_votes'] = Math.round(1000*candidate_votes[k]/total_votes)/10;
    Q[k + '_votes_disp'] = Q[k + '_votes'].toFixed(1);
}

for (var lastCandidate of Q.last_round_candidates) {
    if (!current_round_candidates.includes(lastCandidate)) {
        delete Q[lastCandidate + '_votes'];
        delete Q[lastCandidate + '_votes_disp'];
    }
}

Q.last_round_candidates = current_round_candidates;

Q.winner_votes = Math.round(1000*Q.winner_votes/total_votes)/10;
Q.winner_votes_disp = Q.winner_votes.toFixed(1);
Q.winner_desc = candidate_descs[Q.winner];

if (Q.Braun_votes || Q.Schumacher_votes || Q.Juchacz_votes) {
    Q.spd_running = 1;
    if (Q.Braun_votes_disp) Q.Socialist_votes_disp = Q.Braun_votes_disp;
    if (Q.Schumacher_votes_disp) Q.Socialist_votes_disp = Q.Schumacher_votes_disp;
    if (Q.Juchacz_votes_disp) Q.Socialist_votes_disp = Q.Juchacz_votes_disp;
} else {
    Q.spd_running = 0;
}


if (Q.Gessler_votes || Q.Heuss_votes) {
    Q.lib_running = 1;
    if (Q.Gessler_votes_disp) {
        Q.Liberal_votes = Q.Gessler_votes;
        Q.Liberal_votes_disp = Q.Gessler_votes_disp;
    }
    if (Q.Heuss_votes_disp) {
        Q.Liberal_votes = Q.Heuss_votes;
        Q.Liberal_votes_disp = Q.Heuss_votes_disp;
    }
} else {
    Q.lib_running = 0;
}

if (Q.Adenauer_votes || Q.Bruning_votes) {
    Q.center_running = 1;
    if (Q.Adenauer_votes_disp) {
        Q.Center_votes = Q.Adenauer_votes;
        Q.Center_votes_disp = Q.Adenauer_votes_disp;
    }
    if (Q.Bruning_votes_disp) {
        Q.Center_votes = Q.Bruning_votes;
        Q.Center_votes_disp = Q.Bruning_votes_disp;
    }
} else {
    Q.center_running = 0;
}

if (Q.Hergt_votes || Q.Seldte_votes || Q.Lettow_Vorbeck_votes) {
    Q.reactionary_running = 1;
    if (Q.Hergt_votes_disp) {
        Q.Reactionary_votes = Q.Hergt_votes;
        Q.Reactionary_votes_disp = Q.Hergt_votes_disp;
    }
    if (Q.Seldte_votes_disp) {
        Q.Reactionary_votes = Q.Seldte_votes;
        Q.Reactionary_votes_disp = Q.Seldte_votes_disp;
    }
    if (Q.Lettow_Vorbeck_votes) {
        Q.Reactionary_votes = Q.Lettow_Vorbeck_votes;
        Q.Reactionary_votes_disp = Q.Lettow_Vorbeck_votes;
    }
} else {
    Q.reactionary_running = 0;
}

if (Q.Hugenberg_votes) {
    Q.hamster_running = 1;
} else {
    Q.hamster_running = 0;
}

Q.round += 1
!}
go-to: r2_start if round = 1 and not has_majority; election_end if round > 1; r1_winner if has_majority

選挙結果：

[? if Hitler_running : <span style="color: #7A3C00;">**Hitler**</span> - [+ Hitler_votes_disp +]% ?]
[? if Goring_running : <span style="color: #7A3C00;">**Göring**</span> - [+ Goring_votes_disp +]% ?]

[? if hamster_running : <span style="color: #003755;">**Hugenberg**</span> - [+ Hugenberg_votes_disp +]% ?]

[? if reactionary_running and not cvp_formed : <span style="color: #3E88B3;">**[+ reactionary_candidate_1934 +]**</span> - [+ Reactionary_votes_disp +]% ?]
[? if reactionary_running and cvp_formed : <span style="color: #000000;">**[+ reactionary_candidate_1934 +]**</span> - [+ Reactionary_votes_disp +]% ?]

[? if Thalmann_running : <span style="color: #700000;">**Thälmann**</span> - [+ Thalmann_votes_disp +]% ?]
[? if Munzenberg_running : <span style="color: #9B0000;">**Münzenberg**</span> - [+ Munzenberg_votes_disp +]% ?]

[? if center_running : <span style="color: #000000;">**[+ center_candidate_1934 +]**</span> - [+ Center_votes_disp +]% ?]

[? if lib_running : [? if not lvp_formed: <span style="color: #D3C24D;">**[+ lib_candidate_1934 +]**</span>?][? if lvp_formed: <span style="color: #FFCC00;">**[+ lib_candidate_1934 +]**</span>?] - [+ Liberal_votes_disp +]% ?]

[? if Eckener_running : <span style="color: #000000;">**Ec**</span><span style="color: #DD0000;">**ken**</span><span style="color: #FFCC00;">**er**</span> - [+ Eckener_votes_disp +]% ?]

[? if spd_running : <span style="color: #c00000;">**[+ spd_candidate +]**</span> - [+ Socialist_votes_disp +]% ?]
# cultural candidates
[? if Einstein_running : <span style="color: #CFC88F;">**Einstein**</span> - [+ Einstein_votes_disp +]% ?]
[? if Ossietzky_running : <span style="color: #E0A0A0;">**Ossietzky**</span> - [+ Ossietzky_votes_disp +]% ?]
[? if Mann_running : <span style="color: #E0A0A0;">**Mann**</span> - [+ Mann_votes_disp +]% ?]

@r2_start
on-arrival: {!
// 1. coordination between the right/far-right
if (!Q.cvp_formed) {
    if (Q.Hitler_votes && Q.Reactionary_votes) {
        if (Q.Hitler_votes > Q.Reactionary_votes) {
            Q.dnvp_candidate = "Hitler";
            Q.other_candidate = "Hitler";
            if (Q.kvp_candidate == Q.reactionary_candidate_1934) Q.kvp_candidate = "Hitler";
            Q.dnf_candidate = "Hitler";
            Q.Hitler_bonus = (Q.Hitler_bonus || 0) - 0.25*Q.other_votes;
            if (Q.center_running) {
                Q.Center_bonus = (Q.Center_bonus || 0) + 0.25*Q.other_votes;
            } else if (Q.lib_running) {
                Q.Liberal_bonus = (Q.Liberal_bonus || 0) + 0.25*Q.other_votes;
            }
        } else {
            Q.nsdap_candidate = Q.reactionary_candidate_1934;
            Q.dnf_candidate = Q.reactionary_candidate_1934;
        }
    } else if (Q.Goring_votes && Q.Reactionary_votes) {
        if (Q.Goring_votes > Q.Reactionary_votes) {
            Q.dnvp_candidate = "Göring";
            if (Q.kvp_candidate == Q.reactionary_candidate_1934) Q.other_candidate = "Göring";
            Q.dnf_candidate = "Göring";
            Q.Goring_bonus = (Q.Goring_bonus || 0) - 0.25*Q.other_votes;
            if (Q.center_running) {
                Q.Center_bonus = (Q.Center_bonus || 0) + 0.25*Q.other_votes;
            } else if (Q.lib_running) {
                Q.Liberal_bonus = (Q.Liberal_bonus || 0) + 0.25*Q.other_votes;
            }
        } else {
            Q.nsdap_candidate = Q.reactionary_candidate_1934;
            Q.dnf_candidate = Q.reactionary_candidate_1934;
        }
    }
}
// 2. If Adenauer & Gessler are both running and neither are part of the SPD coalition, the smaller of these drops out.
Q.center_drops_out = 0;
Q.lib_drops_out = 0;
if (!Q.cvp_formed) {
    if (Q.z_candidate == Q.center_candidate_1934 && (Q.ddp_candidate == Q.lib_candidate_1934 && !Q.lvp_formed || Q.dvp_candidate == Q.lib_candidate_1934 && !Q.lvp_formed && Q.dvp_exist || Q.lvp_candidate == Q.lib_candidate_1934 && Q.lvp_formed) && Q.z_candidate != Q.spd_candidate && (Q.ddp_candidate != Q.spd_candidate && !Q.lvp_formed || Q.dvp_candidate != Q.spd_candidate &&   !Q.lvp_formed && Q.dvp_exist || Q.lvp_candidate != Q.spd_candidate && Q.lvp_exist)) {
        if (Q.Center_votes > Q.Liberal_votes) {
            Q.lib_drops_out = 1;
            if (Q.ddp_candidate != Q.spd_candidate) {
                Q.ddp_candidate = Q.center_candidate_1934;
            }
            if (Q.dvp_candidate != Q.spd_candidate) {
                Q.dvp_candidate = Q.center_candidate_1934;
            }
            if (Q.lvp_candidate != Q.spd_candidate) {
                Q.lvp_candidate = Q.center_candidate_1934;
            }
            Q.Center_bonus = (Q.Center_bonus || 0) + 0.25*Q.other_votes;
        } else {
            Q.center_drops_out = 1;
            Q.z_candidate = Q.lib_candidate_1934;
            Q.Liberal_bonus = 0.25*Q.other_votes;
        }
        if (Q.nsdap_candidate == Q.reactionary_candidate_1934) {
            Q.Reactionary_bonus = (Q.Reactionary_bonus || 0) - 0.25*Q.other_votes;
        } else if (Q.nsdap_candidate == "Hitler" || Q.nsdap_candidate == "Göring") {
            Q.Hitler_bonus = (Q.Hitler_bonus || 0) - 0.25*Q.other_votes;
        }
    }
}
// DVP drops out to favor the center candidate
if (Q.dvp_candidate != Q.spd_candidate && Q.dvp_candidate != Q.ddp_candidate && Q.dvp_candidate != Q.z_candidate) {
}
!}
go-to: r2_menu

首位は[+ winner_desc +]である。第1回投票では過半数を得た候補がいない。第2回投票では最多票を得た候補が当選する。

[? if dnvp_candidate = "Hitler" : <span style="color: #3E88B3;">**DNVP**</span>と<span style="color: #7A3C00;">**NSDAP**</span>は選挙運動を一本化し、<span style="color: #3E88B3;">**DNVP**</span>は第2回投票でヒトラーを支持する。一部の右翼有権者はこの協力を不快に思い、棄権するかもしれない。?]
[? if dnvp_candidate = "Göring" : <span style="color: #3E88B3;">**DNVP**</span>と<span style="color: #7A3C00;">**NSDAP**</span>は選挙運動を一本化し、<span style="color: #3E88B3;">**DNVP**</span>は第2回投票でゲーリングを支持する。?]
[? if nsdap_candidate = reactionary_candidate_1934 : <span style="color: #3E88B3;">**DNVP**</span>と<span style="color: #7A3C00;">**NSDAP**</span>は選挙運動を一本化し、<span style="color: #7A3C00;">**NSDAP**</span>は第2回投票で[+ reactionary_candidate_1934 +]を支持する。?]

[? if lib_drops_out : 自由主義候補[+ lib_candidate_1934_disp +]は、[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]の[+ center_candidate_1934_disp +]を支持して撤退した。これにより穏健ブルジョワ・ブロックの票がまとまり、右翼小政党からも一部の票を引きつける。?]
[? if center_drops_out : [? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]候補[+ center_candidate_1934_disp +]は、[? if not lvp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>[? if dvp_exist:-<span style="color: #C0A054;">**DVP**</span>?]?][? if lvp_formed: <span style="color: #FFCC00;">**LVP**</span>?]候補[+ lib_candidate_1934_disp +]を支持して撤退した。これにより穏健ブルジョワ・ブロックの票がまとまり、右翼小政党からも一部の票を引きつける。?]

我々はどうするべきか？

@r2_menu

# convince DDP/DVP/Z/KPD to endorse our candidate
# change the endorsement, if they aren't endorsing our candidate
# campaign

- @r2_endorse_thalmann
- @r2_endorse_munzenberg
- @r2_endorse_adenauer
- @r2_endorse_gessler
- @r2_endorse_eckener
- @r2_campaigning: 他党に支持候補を変えさせられるか？
- @r2_vote: 投票を開始する。

@r2_endorse_thalmann
title: 支持を<span style="color: #700000;">**KPD**</span>のテールマンへ切り替える。
subtitle: 党の支持を損なう。
view-if: spd_candidate != "Thälmann" and kpd_candidate = "Thälmann"
choose-if: kpd_relation >= 50 and left_strength > reformist_strength
unavailable-subtitle: [? if kpd_relation < 50 : <span style="color: #700000;">共産主義者</span>との関係が十分に良くないため、我々の支持さえ受け入れようとしない。?] [? if reformist_strength >= left_strength : 改革派は、この奇妙な協力を党が支持しないよう押しとどめられる。?]
on-arrival: reformist_dissent += 15; center_dissent += 10; labor_dissent += 5; neorevisionist_dissent += 10; catholics_spd -= 5; workers_spd -= 3; kpd_relation += 10; communist_coalition += 2; z_relation -= 15; dvp_relation -= 15; lvp_relation -= 15; ddp_relation -= 12
on-departure: z_candidate = center_candidate_1934 if z_candidate = "Braun" or z_candidate = "Schumacher" or z_candidate = "Juchacz"; ddp_candidate = z_candidate if ddp_candidate = "Braun" or ddp_candidate = "Schumacher" or ddp_candidate = "Juchacz"; dvp_candidate = z_candidate if dvp_candidate = "Braun" or dvp_candidate = "Schumacher" or dvp_candidate = "Juchacz"; spd_candidate = "Thälmann"; lvp_candidate = z_candidate if lvp_candidate = "Braun" or lvp_candidate = "Schumacher" or lvp_candidate = "Juchacz"; spd_candidate = "Thälmann"
max-visits: 1

支持を<span style="color: #700000;">**KPD**</span>のエルンスト・テールマンへ切り替えた。[? if z_candidate = spd_candidate : かつての盟友である[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]は、これを裏切りと見なす。?][? if z_candidate = "Braun" or z_candidate = "Schumacher" or z_candidate = "Juchacz": 同党は再び[+ center_candidate_1934_disp +]を支持する。?][? if (ddp_candidate = "Braun" or ddp_candidate = "Schumacher" or ddp_candidate = "Juchacz") and not lvp_formed: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>は[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]候補へ支持を切り替える。?][? if (dvp_candidate = "Braun" or dvp_candidate = "Schumacher" or dvp_candidate = "Juchacz") and not lvp_formed and dvp_exist: <span style="color: #C0A054;">**DVP**</span>も[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]候補を支持する。?][? if (lvp_candidate = "Braun" or lvp_candidate = "Schumacher" or lvp_candidate = "Juchacz") and lvp_formed: <span style="color: #FFCC00;">**LVP**</span>も[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]候補を支持する。?]

- @r2_vote: 投票を開始する。

