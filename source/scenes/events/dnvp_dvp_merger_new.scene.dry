on-arrival: {!
    Q.dhv_fkp = 0;
    Q.fkp_leader = 0;
    Q.fkp_ideology = 0;
    Q.natcons_fkp = 0;
    Q.stressmanites_fkp = 0;
    Q.agrarians_fkp = 0;
    Q.industrialists_fkp = 0;
    Q.pp_conservatives_fkp = 0;
    if (Q.kvp_formed == 0) {
        Q.dhv_fkp = (Q.workers_dvp_normalized + Q.workers_dnvp_normalized + (Q.new_middle_dnvp_normalized*0.5) + (Q.new_middle_dvp_normalized*0.5)*0.6);
        Q.natcons_fkp = Q.old_middle_dnvp_normalized*1.5;
        Q.pp_conservatives_fkp = (Q.new_middle_dnvp_normalized*1.5) + (Q.old_middle_dnvp_normalized*1.5);
        Q.stressmanites_fkp = Q.new_middle_dvp_normalized*0.5;
        Q.industrialists_fkp = Q.old_middle_dvp_normalized;
        Q.agrarians_fkp = Q.rural_dnvp_normalized*0.7;
    }
    if (Q.kvp_formed == 1) {
        Q.dhv_fkp = (Q.workers_dvp_normalized + Q.workers_kvp_normalized + (Q.new_middle_kvp_normalized*0.5) + (Q.new_middle_dvp_normalized*0.5)*0.6);
        Q.natcons_fkp = Q.old_middle_kvp_normalized*1.5;
        Q.pp_conservatives_fkp = (Q.new_middle_kvp_normalized*1.5) + (Q.old_middle_kvp_normalized*0.5);
        Q.stressmanites_fkp = Q.new_middle_dvp_normalized*0.5;
        Q.industrialists_fkp = Q.old_middle_dvp_normalized;
        Q.agrarians_fkp = Q.rural_kvp_normalized*0.7;
    }
    if (Q.dnvp_leader == "Schiele") {
        Q.agrarians_fkp = Q.agrarians_fkp*2;
    }
    if (Q.dnvp_leader == "Westarp") {
        Q.natcons_fkp = Q.natcons_fkp*2;
    }
    if (Q.dnvp_leader == "Hergt") {
        Q.natcons_fkp = Q.natcons_fkp*1.5;
        Q.pp_conservatives_fkp = Q.natcons_fkp*1.5;
    }
    if (Q.dnvp_leader == "Treviranus") {
        Q.natcons_fkp = Q.natcons_fkp*0.7;
        Q.pp_conservatives_fkp = Q.natcons_fkp*2;
    }
    if (Q.dnvp_leader == "Treviranus") {
        Q.natcons_fkp = Q.natcons_fkp*0.7;
        Q.pp_conservatives_fkp = Q.pp_conservatives_fkp*2;
    }
    if (Q.kvp_formed == 1) {
        Q.pp_conservatives_fkp = Q.pp_conservatives_fkp*2;
        Q.agrarians_fkp = Q.agrarians_fkp*0.8;
        Q.natcons_fkp = Q.natcons_fkp*0.8;
    }
    if (Q.dvp_reform == 1) {
        Q.dhv_fkp = Q.dhv_fkp*1.4;
    }
    if (Q.dvp_reform == 2) {
        Q.dhv_fkp = Q.dhv_fkp*1.5;
    }
    if (Q.dvp_leader == "Hugo" || Q.dvp_leader == "Dingeldey") {
        Q.industrialists_fkp = Q.industrialists_fkp*1.5;
    }
    if (Q.pro_republic >= 60) {
        Q.pp_conservatives_fkp = Q.pp_conservatives_fkp*1.5;
        Q.stressmanites_fkp = Q.stressmanites_fkp*1.5;
    } else {
        Q.natcons_fkp = Q.natcons_fkp*1.5;
        Q.agrarians_fkp = Q.agrarians_fkp*1.5;
    }
    Q.raumer_points_fkp = Q.industrialists_fkp + Q.stressmanites_fkp*0.5;
    Q.glatzel_points_fkp = Q.dhv_fkp + Q.stressmanites_fkp*0.5;
    Q.westarp_points_fkp = Q.agrarians_fkp*0.6 + Q.natcons_fkp*0.4;
    Q.hergt_points_fkp = Q.agrarians_fkp*0.4 + Q.natcons_fkp*0.6;
    Q.treviranus_points_fkp = Q.pp_conservatives_fkp;
    Q.winner_fkp = "Hergt";
    if (Q.glatzel_points_fkp > Q.raumer_points_fkp && Q.pro_republic > 65) {
        Q.glatzel_points_fkp += Q.raumer_points_fkp;
        Q.raumer_points_fkp = 0;
    } else {
         Q.treviranus_points_fkp += Q.glatzel_points_fkp;
         Q.glatzel_points_fkp == 0;
    }
    if (Q.glatzel_points_fkp + Q.treviranus_points_fkp + Q.raumer_points_fkp > (Q.hergt_points_fkp + Q.westarp_points_fkp)/2) {
        if (Q.pro_republic > 55) {
            Q.hergt_points_fkp += Q.westarp_points_fkp;
            Q.westarp_points_fkp == 0;
        } else {
            Q.westarp_points_fkp += Q.hergt_points_fkp;
            Q.hergt_points_fkp == 0;
        }
    }
    if (Q.raumer_points + Q.treviranus_points_fkp + Q.glatzel_points_fkp > Q.hergt_points_fkp + Q.westarp_points_fkp) {
        if (Q.dvp_leader == "Glatzel" && Q.raumer_points + Q.glatzel_points_fkp + (Q.treviranus_points_fkp*0.4) > Q.hergt_points_fkp + Q.westarp_points_fkp) {
            Q.winner_fkp = "Glatzel";
        } else {
            if (Q.raumer_points_fkp + Q.glatzel_points_fkp > Q.treviranus_points_fkp) {
                Q.winner_fkp = "Raumer";
            } else {
                Q.winner_fkp = "Treviranus";
            }
        }
    } else {
        if ((Q.raumer_points + Q.treviranus_points_fkp + Q.glatzel_points_fkp)*1.1 >= Q.hergt_points_fkp + Q.westarp_points_fkp || Q.hergt_points_fkp > Q.westarp_points_fkp) {
            Q.winner_fkp = "Hergt";
        } else {
            Q.winner_fkp = "Westarp";
        }
    }
!}
go-to: calculations

@calculations
new-page: true

= <span style="color: #00C0FF;">**FKP**</span>党首選挙

<span style="color: #C0A054;">**DVP**</span>と[? if dnvp_ideology == "Moderate":<span style="color: #3E88B3;">**DNVP**</span> ?][? if kvp_formed:<span style="color: #0087DC;">**KVP**</span>?]が合併した今、新生<span style="color: #00C0FF;">**FKP**</span>は新たな時代の指導者を決めねばならない。実業界、国家主義者、労組活動家など、異なる派閥が早くも党内の影響力を争っている。<span style="color: #00C0FF;">**FKP**</span>結党大会での党首選挙は、党内の勢力均衡と今後の方向性を決めるものとなる。路線がまだ定まらないだけに、その結果は<span style="color: #00C0FF;">**FKP**</span>が共和制を容認するのか、それとも一層国家主義的な道を進むのかを左右するかもしれない。

主要派閥：

<span style="color: #3E88B3;">国家保守派</span>（[? if dnvp_ideology == "Moderate":<span style="color: #3E88B3;">**DNVP**</span> ?][? if kvp_formed:<span style="color: #0087DC;">**KVP**</span>?]）[+ natcons_fkp +]

<span style="color: #385A38;">農業派</span>（[? if dnvp_ideology == "Moderate":<span style="color: #3E88B3;">**DNVP**</span> ?][? if kvp_formed:<span style="color: #0087DC;">**KVP**</span>?]）[+ agrarians_fkp +]

<span style="color: #8C7A3C;">実業界</span>（<span style="color: #C0A054;">**DVP**</span>）[+ industrialists_fkp +]

<hr id="read-marker">

<span style="color: #D8B868;">右派労組</span>（<span style="color: #C0A054;">**DVP**</span>と[? if dnvp_ideology == "Moderate":<span style="color: #3E88B3;">**DNVP**</span> ?][? if kvp_formed:<span style="color: #0087DC;">**KVP**</span>?]）[+ dhv_fkp +]

<span style="color: #D8B868;">シュトレーゼマン派</span>（<span style="color: #C0A054;">**DVP**</span>）[+ stressmanites_fkp +]

<span style="color: #0087DC;">人民保守派</span>（[? if dnvp_ideology == "Moderate":<span style="color: #3E88B3;">**DNVP**</span> ?][? if kvp_formed:<span style="color: #0087DC;">**KVP**</span>?]）[+ ppconservatives_fkp +]

- @glatzel: フランク・グラッツェル。
- @treviranus: ゴットフリート・トレヴィラヌス。
- @raumer: ハンス・フォン・ラウマー。
- @hergt: オスカー・ヘルクト。
- @westarp: クーノ・フォン・ヴェスタルプ。

@glatzel
subtitle: <span style="color: #C0A054;">**DVP**</span>の改革派出身で、右派を一つの勢力にまとめようとしている。
choose-if: winner_fkp = "Glatzel"
on-arrival: fkp_leader = "Glatzel"; fkp_ideology = "Paternalistic Conservatism";
call: dnvp_dvp_formed
face-image: img/portraits/glatzel.jpg

<span style="color: #00C0FF;">**FKP**</span>結党大会の長引く決選投票を制したのは、予想に反してフランク・グラッツェルだった。トレヴィラヌスやフォン・ラウマーら中道派が先に脱落し、ヘルクトやヴェスタルプのような強硬な君主主義者ではなく、グラッツェルの支持に回った。最終投票までに、彼は[? if dnvp_ideology == "Moderate":<span style="color: #3E88B3;">**DNVP**</span> ?][? if kvp_formed:<span style="color: #0087DC;">**KVP**</span>?]の穏健派残留組、ホワイトカラー労組の代議員、残る<span style="color: #C0A054;">**DVP**</span>穏健派を結集させ、党内左派に位置しながらも党首の座を獲得した。

グラッツェルは<span style="color: #c00000;">**SPD**</span>との一定の交渉に前向きであり、我々にとっては考えられる最良の結果だ。しかし農業派と実業界が強い影響力を保つ新生<span style="color: #00C0FF;">**FKP**</span>は、シュトレーゼマン時代の<span style="color: #C0A054;">**DVP**</span>よりはるかに頑固な相手となる。いかなる協力も、以前より制約が大きいだろう。それでも、勝利寸前だった非妥協的な強硬派に比べれば、グラッツェルの勝利には安堵できる。

@raumer
subtitle: <span style="color: #C0A054;">**DVP**</span>の有力な実業家多数に支持されるフォン・ラウマーは、ブルジョワ勢力の強化を目指している。
choose-if: winner_fkp = "Raumer"
on-arrival: fkp_leader = "von-Raumer"; fkp_ideology = "Liberal Conservatism";
call: dnvp_dvp_formed
face-image: img/portraits/von_raumer.jpg

<span style="color: #00C0FF;">**FKP**</span>結党大会で候補を絞り込む投票が数回行われた末、ハンス・フォン・ラウマーが親企業派をまとめて党首の座を獲得した。穏健派のフランク・グラッツェルが最初に脱落し、最後から二回目の投票ではゴットフリート・トレヴィラヌスが辞退して、強硬な君主主義者ではなくフォン・ラウマーを支持した。長年彼と結んできた実業家と大企業の代議員がこぞって集まり、旧<span style="color: #C0A054;">**DVP**</span>議員や一部の労組活動家も加わったことで、最終投票ではクーノ・フォン・ヴェスタルプに決定的な差をつけた。

我々にとって興味深い展開だ。フォン・ラウマーは<span style="color: #00C0FF;">**FKP**</span>の実業界と強く結びついている一方、過去の政権では大連立を一貫して支持してきた。ルドルフ・ヒルファディングとも良好な協力関係にある。しかし、今後とも政権内で我々の政策を制限しようとするだろう。さらに実業界の支持者の多くは我々との連立そのものを阻もうとするため、協力はシュトレーゼマン時代の<span style="color: #C0A054;">**DVP**</span>より困難なままだ。

@treviranus
subtitle: [? if dnvp_ideology == "Moderate":<span style="color: #3E88B3;">**DNVP**</span> ?][? if kvp_formed:<span style="color: #0087DC;">**KVP**</span>?]に属する熱心な改革派、トレヴィラヌスが名乗りを上げた。
choose-if: winner_fkp = "Treviranus"
on-arrival: fkp_leader = "Treviranus"; fkp_ideology = "Liberal Conservatism";
call: dnvp_dvp_formed
face-image: img/portraits/Treviranus.jpg

<span style="color: #00C0FF;">**FKP**</span>結党大会での長引く数次の投票の末、ゴットフリート・トレヴィラヌスが党首に選ばれた。<span style="color: #3E88B3;">**DNVP**</span>の穏健な異論派、農業会議所の代議員、少数の現実的な旧<span style="color: #C0A054;">**DVP**</span>党員を結集し、初回から好成績を収めた。穏健派を代表するフランク・グラッツェルが最初に脱落した。続いてハンス・フォン・ラウマー周辺の産業界の保守派が、強硬な君主主義者を支持するのを嫌い、最後から二回目の投票までに一斉にトレヴィラヌスへ移った。これにより、クーノ・フォン・ヴェスタルプを退けて党首となる道が開けた。

我が党の多くは、諦めまじりながらトレヴィラヌスを受け入れる意向を示している。国家主義的な言辞や緊縮的な経済政策には依然として強い不信を抱くものの、党内の公然たる君主主義者よりは<span style="color: #000000;">ヴァイ</span><span style="color: #DD0000;">マ</span><span style="color: #FFCC00;">ル</span>体制への敵意が弱いと認めている。国内で台頭する[? if dnvp_ideology == "Radical": <span style="color: #3E88B3;">極</span>?][? if dnvp_ideology == "Moderate": <span style="color: #003755;">極</span>?]<span style="color: #3E88B3;">右</span>への防壁となることを期待したい。

@hergt
subtitle: [? if dnvp_ideology == "Radical": <span style="color: #3E88B3;">**DNVP**</span>?][? if dnvp_ideology == "Moderate": <span style="color: #003755;">**DNF**</span>?]の旧指導層に属し、農村部と保守勢力の支持を受けている。
choose-if: winner_fkp = "Hergt"
on-arrival: fkp_leader = "Hergt"; fkp_ideology = "Liberal Conservatism"; 
call: dnvp_dvp_formed
face-image: img/portraits/OskarHergt.jpg

<span style="color: #00C0FF;">**FKP**</span>結党大会で候補を絞り込む投票が数回行われた末、オスカー・ヘルクトが君主主義的な保守派をまとめて党首に選ばれた。穏健派のフランク・グラッツェルが最初に、続いてハンス・フォン・ラウマーが脱落すると、ラウマーを支持する実業界はトレヴィラヌスとヘルクトに分かれた。最後から二回目の投票ではクーノ・フォン・ヴェスタルプが辞退し、ゴットフリート・トレヴィラヌス率いる中道派ではなくヘルクトに代議員の支持を回した。農業保守派、教会系の代議員、そして相当数の<span style="color: #3E88B3;">**DNVP**</span>保守派の支持により、最終投票でトレヴィラヌスを上回った。

ヘルクトの勝利で<span style="color: #00C0FF;">**FKP**</span>との関係は悪化した。根深い君主主義と民主的手続きへの敵意から、彼はすでに鉄兜団との非公式接触など、極右との協力拡大を模索している。実質的な立法協力はほぼ不可能に見え、今後の連立形成はますます難しくなる。

@westarp
subtitle: [? if dnvp_ideology == "Radical": <span style="color: #3E88B3;">**DNVP**</span>?][? if dnvp_ideology == "Moderate": <span style="color: #003755;">**DNF**</span>?]の急進右派であり、党を強硬路線へ転換しようとしている。
choose-if: winner_fkp = "Westarp"
on-arrival: fkp_leader = "Westarp"; fkp_ideology = "National Conservatism";
call: dnvp_dvp_formed
face-image: img/portraits/Kuno_von_Westarp.jpg

<span style="color: #00C0FF;">**FKP**</span>結党大会で候補を絞り込む投票が数回行われた末、クーノ・フォン・ヴェスタルプが農村派と民族主義派を結集して党首に選ばれた。穏健派のフランク・グラッツェルが最初に脱落した。その後、ハンス・フォン・ラウマー周辺の穏健保守派と旧<span style="color: #C0A054;">**DVP**</span>系の票はトレヴィラヌスとヘルクトに分かれ、一方ヴェスタルプは農業・伝統主義勢力の支持を固めた。最後から二回目の投票ではオスカー・ヘルクトが辞退し、ゴットフリート・トレヴィラヌス率いる中道派ではなくヴェスタルプに代議員の支持を回した。

ヴェスタルプの台頭により、右派から民主的な政党は事実上なくなった。露骨な反ユダヤ主義と準軍事組織への共感は、過激な排斥と街頭暴力への危険な転換を示している。右派が共和制への拒絶を強める中、共和国の安定化はますます困難となる。
