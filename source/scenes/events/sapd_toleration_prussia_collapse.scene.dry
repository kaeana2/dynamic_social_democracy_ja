unavailable-subtitle: <span style="color: #c00000;">SPD</span> + <span style="color: #000000;">[+ z_party_name +]</span> + [? if not lvp_formed: <span style="color: #D3C24D;">[+ ddp_name +]</span>?][? if lvp_formed:<span style="color: #FFCC00;">LVP</span>?][? if sapd_formed and kpd_relation >= 30 and sapd_weimar_prussia :&nbsp;+ <span style="color: #9B0000;">SAPD</span>の寛容さ?] ([+ weimar_coalition_prussia +]%) [? if far_right_coalition_prussia >= 50: - <span style="color: #7A3C00;">極右</span>-<span style="color: #3E88B3;">右派</span>は政府を樹立できる。 ?] [? if not ((z_relation >= 30 and z_ideology == "Right") or (z_relation >= 25 and z_leader == "Joos") or (z_relation >= 20 and z_leader == "Kaiser")): - 我々は[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP": <span style="color: #000000;">**CVP**</span>?]との適切な関係を持たない。 ?] [? if not (ddp_relation >= 30 and ddp_ideology == "Right") and not (ddp_relation >= 25 and ddp_ideology == "Moderate") and not (ddp_relation >= 20 and ddp_ideology == "Left") and not lvp_formed: - 我々は<span style="color: #D3C24D;">[+ ddp_name +]</span>との適切な関係を持たない。 ?] [? if not ((lvp_relation >= 40 and lvp_ideology == "Right") or (lvp_relation >= 35 and lvp_ideology == "Moderate") or (lvp_relation >= 30 and lvp_ideology == "Left")) and lvp_formed: - 我々は<span style="color: #FFCC00;">LVP</span>との適切な関係を持たない。 ?]
view-if: weimar_coalition_prussia >= 50 and not cvp_formed
choose-if: weimar_coalition_prussia >= 50 and (((z_relation >= 30 and z_ideology == "Right") or (z_relation >= 25 and z_leader == "Joos") or (z_relation >= 20 and z_leader == "Kaiser")) and ((((ddp_relation >= 30 and ddp_ideology == "Right") or (ddp_relation >= 25 and ddp_ideology == "Moderate") or (ddp_relation >= 20 and ddp_ideology == "Left")) and not lvp_formed) or (((lvp_relation >= 40 and lvp_ideology == "Right") or (lvp_relation >= 35 and lvp_ideology == "Moderate") or (lvp_relation >= 30 and lvp_ideology == "Left")) and lvp_formed)))
on-arrival: in_weimar_coalition_prussia = 1; was_in_weimar_coalition_prussia = 1; liberal_cooperation -= 1 if liberal_parliament == 1; prussia_leader = "Braun"; prussia_leader = "Stegerwald" if (braun_resign and z_leader != "Stegerwald"); prussia_leader = "Brüning" if (braun_resign and z_leader == "Stegerwald"); pro_republic += 3 if year >= 1929; ddp_relation += 5; z_relation += 5; lvp_relation += 5; reformist_dissent -= 10; spd_prussia = 1
go-to: prussia_minister_president if prussia_leader == "Braun"

我々は「<span style="color: #000000;">ヴァ</span><span style="color: #DD0000;">イマ</span><span style="color: #FFCC00;">ル</span>連立」を樹立するだけの議席を得た。これは<span style="color: #c00000;">**SPD**</span>、[? if z_party_name != "CVP": <span style="color: #000000;">中央党</span>?][? if z_party_name == "CVP":、<span style="color: #000000;">**CVP**</span>?]、[? if ddp_name == "DDP" and not lvp_formed: <span style="color: #D3C24D;">**民主党**</span>?][? if ddp_name == "DStP" and not lvp_formed: <span style="color: #D3C24D;">**国家党**</span>?][? if lvp_formed: <span style="color: #FFCC00;">**自由人民党**</span>?] [? if not lvp_formed:（<span style="color: #D3C24D;">**[+ ddp_name +]**</span>）?][? if lvp_formed:（<span style="color: #FFCC00;">**LVP**</span>）?]による、1919年以来の与党連合である。[? if liberal_parliament == 1: <span style="color: #D3C24D;">**[+ ddp_name +]**</span>の独自行動により、自由主義議員団には緊張が生じている。?]

[? if prussia_leader != "Braun": [+ prussia_leader +] がプロイセンの州首相に選出された。 ?]

