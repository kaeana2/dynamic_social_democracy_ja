unavailable-subtitle: [? if advisor_action_timer > 0 : 次の顧問行動まであと[+ advisor_action_timer +]か月。 ?][? if not spd_in_government : <span style="color: #c00000;">SPD</span>は現在政権に参加していない。 ?][? if chancellor_party != "SPD": <span style="color: #c00000;">SPD</span>が首相職を掌握していなければならない。 ?][? if prussia_leader != "Braun" and prussia_leader != "Rosenfeld": <span style="color: #c00000;">SPD</span>がプロイセン州首相職を掌握していなければならない。 ?][? if curriculum_timer > 0 : 教育課程を再び改定するには早すぎる。 ?]
on-arrival: advisor_action_timer = 6; last_advisor_action = 1
go-to: education_science.curriculum


