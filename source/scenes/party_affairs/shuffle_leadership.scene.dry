title: 指導部を再編
new-page: true
is-card: true
tags: party_affairs
view-if: shuffle_leadership_timer = 0 and difficulty >= 0 and not started
on-arrival: month_activities += 1; shuffle_leadership_timer = 10;
card-image: img/vorwarts_2.jpg
go-to: rm_main

- @rm_main: 顧問を外す
- @add_advisors: 顧問を加える
- @remove_none: 顧問を変更しない。
- @easy_discard


###################### removing leaders

@rm_main
title: 顧問を外す。
tags: center_advisor, left_advisor, reformist_advisor, labor_advisor, neorev_advisor, nonfactional_advisor 
on-arrival: {!
Q.last_time_check = Q.time;
if (Q.time > Q.last_time_check) {
    Q.advisor_1 = [];

    for (let key in Q) {
        if (key.endsWith('_advisor') && Q[key] === 1) {
            Q.advisor_1.push(key.replace('_advisor', ''));
        }
    }
}
console.log(Q.advisor_1)
!}
frequency: 1
go-to: rm_main_menu

<span style="color: #c00000;">**SPD**</span>は多様で<span class="tooltip-text" title="良質なMOD">動的</span>な政党だが、内部対立によって各派閥の不満は時間とともに増加する。[? if nsdap_votes >= 20: ただし共和国に対する<span style="color: #7A3C00;">**NSDAP**</span>の脅威により、党内の言い争いの多くは沈静化している。 ?]

顧問を任命すると所属派閥の忠誠と影響力が高まる一方、取り残された派閥の不満が増加する。

{!<span class="tooltip-text" title="左派は急進的・変革的政策とKPDとの協力を重視する。">左派</span>!} 勢力：[+ left_strength : strength +]、不満：[+ left_dissent : dissent +]

{!<span class="tooltip-text" title="中間派は改革と革命の間に位置する中間派マルクス主義者の派閥である。">中間派</span>!} 勢力：[+ center_strength : strength +]、不満：[+ center_dissent : dissent +]

{!<span class="tooltip-text" title="労働派は経済改革と組織労働者の利益を目標とする。">労働派</span>!} 勢力：[+ labor_strength : strength +]、不満：[+ labor_dissent : dissent +]

{!<span class="tooltip-text" title="改革派は現実的な政権参加者で、福祉国家の拡充と民主主義の擁護を目指す。">改革派</span>!} 勢力：[+ reformist_strength : strength +]、不満：[+ reformist_dissent : dissent +]

@rm_main_menu

- #remove_advisor
- @add_advisors: 顧問を加える

@remove_none
title: 顧問の変更を終える。
on-arrival: {!
Q.advisor_2 = [];

for (let key in Q) {
    if (key.endsWith('_advisor') && Q[key] === 1) {
        Q.advisor_2.push(key.replace('_advisor', ''));
    }
}

console.log(Q.advisor_2)

function arraysAreEqual(arr1, arr2) {
    if (arr1.length !== arr2.length) return false;
    for (let i = 0; i < arr1.length; i++) {
        if (arr1[i] !== arr2[i]) return false;
    }
    return true;
}

if (arraysAreEqual(Q.advisor_1, Q.advisor_2)) {
    Q.shuffle_leadership_timer = 0;
} else {
    Q.kleber_der_partei = 0;
}
!}
go-to: root
tags: remove_advisor


@remove_hilferding
title: ヒルファディングを顧問から外す
