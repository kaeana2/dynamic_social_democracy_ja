[? if kvp_formed and not dnvp_dvp_formed: <span class="tooltip-text" title="保守人民党" style="color: #0087DC;">**KVP**</span>: [? if not kvp_dnef: キリスト教保守主義?][? if kvp_dnef: 国家保守主義?] ([+ kvp_leader +])?]

[? if dnvp_dvp_formed: <span class="tooltip-text" title="自由保守党" style="color: #00C0FF;">**FKP**</span>: [+ fkp_ideology +]: ([+ fkp_leader +])?]

[? if not ddp_name: 未初期化 ?][? if ddp_name != 0 and not cvp_formed and not dnvp_dnef and not dnvp_defunct: <span class="tooltip-text" title="ドイツ国家人民党" style="color: #3E88B3;">**DNVP**</span>: [? if dnvp_leader = "Hugenberg" or dnvp_leader = "Triumvirate": 権威主義的保守主義?][? if dnvp_leader = "Westarp" or dnvp_leader = "Hergt" or dnvp_leader == "Lejeune-Jung" or dnvp_leader == "Keudell": 国家保守主義?][? if dnvp_leader = "Lambach": キリスト教的協調組合主義?][? if dnvp_leader = "Treviranus" and not true_christian_democracy: 国家保守主義?][? if dnvp_leader = "Treviranus" and true_christian_democracy: トーリー民主主義?][? if dnvp_leader = "Schiele": 農本保守主義?] ([+ dnvp_leader +])?]

[? if ddp_name != 0 and not cvp_formed and dnvp_dnef: <span class="tooltip-text" title="ドイツ国家人民党" style="color: #3E88B3;">**DNVP**</span>: [? if dnvp_leader == "Lambach": キリスト教的協調組合主義?][? if dnvp_leader == "Treviranus": 国家保守主義?] ([+ dnvp_leader +])?]

[? if dnf_formed : <span class="tooltip-text" title="ドイツ国民戦線" style="color: #003755;">**DNF**</span>: 権威主義的保守主義 (Hugenberg) ?]

[? if dsu_exist: <span class="tooltip-text" title="ドイツ社会同盟" style="color: #6A1E1E;">**DSU**</span>: [? if not dsu_alt: シュトラッサー主義?][? if dsu_alt: 中道ナチズム?] ([+ dsu_leader +])?]

[? if not ddp_name: 未初期化 ?][? if ddp_name != 0: <span class="tooltip-text" title="国家社会主義ドイツ労働者党（ナチ党）" style="color: #7A3C00;">**NSDAP**</span>: 国家社会主義 ([+ nsdap_leader +])?]

[? if nvf_exist: <span class="tooltip-text" title="国民戦線" style="color: #142e20;">**NVF**</span>: 革命的民族主義 (Röhm)?]

= 産業界の支援

[? if dnef_formed: <span class="tooltip-text" title="ドイツ国民統一戦線" style="color: #BFC8CC;">**DNEF**</span>: [? if industrial_dnef_backing == 3: 高い?][? if industrial_dnef_backing == 4: 最高?] ?]

[? if z_party_name == "CVP": <span class="tooltip-text" title="キリスト教人民党" style="color: #000000;">**[+ z_party_name +]**</span>: [? if industrial_z_backing == 3: 高い?][? if industrial_z_backing == 4: 最高?]  ?]

[? if not lvp_formed: [? if ddp_name == "DStP": <span class="tooltip-text" title="ドイツ国家党" style="color: #D3C24D;">**[+ ddp_name +]**</span>?][? if ddp_name == "DDP": <span class="tooltip-text" title="ドイツ民主党" style="color: #D3C24D;">**[+ ddp_name +]**</span>?]: [? if industrial_ddp_backing == 0: なし?][? if industrial_ddp_backing == 1: 低い?][? if industrial_ddp_backing == 2: 中程度?]  ?]

[? if lvp_formed: <span class="tooltip-text" title="自由人民党" style="color: #FFCC00;">**LVP**</span>: [? if industrial_lvp_backing == 2: 中程度?][? if industrial_lvp_backing == 3: 高い?][? if industrial_lvp_backing == 4: 最高?] ?]

[? if not lvp_formed and dvp_exist: <span class="tooltip-text" title="ドイツ人民党" style="color: #C0A054;">**DVP**</span>: [? if industrial_dvp_backing == 1: 低い?][? if industrial_dvp_backing == 2: 中程度?][? if industrial_dvp_backing == 3: 高い?] ?]

[? if not cvp_formed and not dnvp_defunct: <span class="tooltip-text" title="ドイツ国家人民党" style="color: #3E88B3;">**DNVP**</span>: [? if industrial_dnvp_backing == 4: 最高?][? if industrial_dnvp_backing == 3: 高い?][? if industrial_dnvp_backing == 2: 中程度?][? if industrial_dnvp_backing == 1: 低い?][? if industrial_dnvp_backing == 0: [? if dnvp_ideology == "Moderate": なし?][? if dnvp_ideology == "Radical": フーゲンベルクが資金提供?]?]?]

[? if dnvp_ideology == "Moderate": <span class="tooltip-text" title="ドイツ国民戦線" style="color: #003755;">**DNF**</span>: フーゲンベルクが資金提供 ?]

[? if kvp_formed and not dnvp_dvp_formed: <span class="tooltip-text" title="保守人民党" style="color: #0087DC;">**KVP**</span>: 高い ?]

[? if dnvp_dvp_formed: <span class="tooltip-text" title="自由保守党" style="color: #00C0FF;">**FKP**</span>: 高い ?]

[? if dsu_exist: <span class="tooltip-text" title="ドイツ社会同盟" style="color: #6A1E1E;">**DSU**</span>: なし ?]

<span class="tooltip-text" title="国家社会主義ドイツ労働者党（ナチ党）" style="color: #7A3C00;">**NSDAP**</span>: [? if industrial_nsdap_backing == 0: なし?][? if industrial_nsdap_backing == 1: 低い?][? if industrial_nsdap_backing == 2: 中程度?]

[? if nvf_exist: <span class="tooltip-text" title="国民戦線" style="color: #142e20;">**NVF**</span>: なし ?]

= <span style="color: #c00000;">**SPD**</span>の党内派閥

{!<span class="tooltip-text" title="左派は急進的な変革政策とKPDとの協力を志向する。">左派</span>!}の勢力： [+ left_strength : strength +]、不満： [+ left_dissent : dissent +]

{!<span class="tooltip-text" title="中央派は改革と革命の中間に位置するマルクス主義派である。">中央派</span>!}の勢力： [+ center_strength : strength +]、不満： [+ center_dissent : dissent +]

{!<span class="tooltip-text" title="労働組合派は経済改革と組織労働者の利益を目標とする。">労働組合派</span>!}の勢力： [+ labor_strength : strength +]、不満： [+ labor_dissent : dissent +]

{!<span class="tooltip-text" title="改革派は現実的な政権参加、福祉国家の拡充、民主主義の防衛を目指す。">改革派</span>!}の勢力： [+ reformist_strength : strength +]、不満： [+ reformist_dissent : dissent +]

[? if neorevisionism: {!<span class="tooltip-text" title="新修正主義派は共和国防衛と民主主義拡大、新しい宣伝手法、議会外行動を重視する。">新修正主義派</span>!}の勢力： [+ neorevisionist_strength : strength +]、不満： [+ neorevisionist_dissent : dissent +] ?]

@paramilitaries
on-arrival: {!
Q.rb_strength_2 = Q.rb_strength.toFixed(1);
Q.rfb_strength_2 = Q.rfb_strength.toFixed(1);
Q.sh_strength_2 = Q.sh_strength.toFixed(1);
Q.sa_strength_2 = Q.sa_strength.toFixed(1);
!}

= 準軍事組織

<span class="tooltip-text" title="国旗団（黒・赤・金）は民主主義を防衛する大衆組織で、主にSPDと提携している。" style="color: #c00000;">**国旗団**</span>の勢力： [+ rb_strength_2 +]千人

<span style="color: #c00000;">**国旗団**</span>の武装化： [+ rb_militancy : militancy +]

<span class="tooltip-text" title="RFB（赤色戦線戦士同盟）はKPD系の共産主義組織である。" style="color: #8B0000;">**RFB**</span>の勢力： [+ rfb_strength_2 +]千人

<span style="color: #8B0000;">**RFB**</span>の武装化： [+ rfb_militancy : militancy +]

<span class="tooltip-text" title="鉄兜団はDNVP系の、退役軍人による右翼組織である。" style="color:#3E88B3;">**鉄兜団**</span>の勢力： [+ sh_strength_2 +]千人

<span style="color: #3E88B3;">**鉄兜団**</span>の武装化： [+ sh_militancy : militancy +]

<span class="tooltip-text" title="SA（突撃隊）はナチ党の準軍事組織である。" style="color: #7A3C00;">**SA**</span>の勢力： [+ sa_strength_2 +]千人

<span style="color: #7A3C00;">**SA**</span>の武装化： [+ sa_militancy : militancy +]

[? if year >= 1930 and not streetfighting_joever: <h1>勢力分布</h1> ?]

[? if year >= 1930 and not streetfighting_joever: <h4>[? if not kpd_truce: <span style="color: #000000;">民</span><span style="color: #DD0000;">主</span><span style="color: #FFCC00;">派</span>?][? if kpd_truce: 反<span style="color: #7A3C00;">ファシズム</span>派?]の勢力： [+ democracy_force +]%</h4>?]

[? if year >= 1930 and not streetfighting_joever: <span style="color: #c00000;">**国旗団**</span>: [+ rb_force +]%?]

[? if year >= 1930 and not streetfighting_joever and prussia_leader != "Papen" and prussia_leader != "Schleicher" and prussia_leader != "Strasser": <b>プロイセン警察： [+ prussia_force +]%</b>?]

[? if year >= 1930 and not streetfighting_joever and kpd_truce: <span style="color: #8B0000;">**RFB**</span>: [+ rfb_force +]%?]

[? if year >= 1930 and not streetfighting_joever: <h4><span style="color: #7A3C00;">極</span><span style="color: #3E88B3;">右</span>の勢力： [+ far_right_force +]%</h4>?]

[? if year >= 1930 and not streetfighting_joever: <span style="color: #7A3C00;">**SA**</span>: [+ sa_force +]%?]

[? if year >= 1930 and not streetfighting_joever: <span style="color: #3E88B3;">**鉄兜団**</span>: [+ sh_force +]%?]

[? if year >= 1930 and not streetfighting_joever and not kpd_truce: <span style="color: #8B0000;">**RFB**</span>: [+ rfb_force +]%?]

[? if year >= 1930 and not streetfighting_joever and (prussia_leader == "Papen" or prussia_leader == "Schleicher" or prussia_leader == "Strasser") or reichswehr_street: <h4><span style="color: #BFC8CC;">**国家権力**</span>の勢力： [+ state_force +]%</h4>?]

[? if year >= 1930 and not streetfighting_joever and prussia_leader == "Papen" or prussia_leader == "Schleicher" or prussia_leader == "Strasser": <b>プロイセン警察： [+ prussia_force +]%</b>?]

[? if year >= 1930 and not streetfighting_joever and reichswehr_street: <b>国防軍憲兵隊： [+ reichswehr_force +]%</b>?]

[? if year >= 1930 and not streetfighting_joever: 現在、街頭は [? if far_right_paramilitary and rfb_force < far_right_force:[? if far_right_paramilitary_highest: 完全に支配されている： <span style="color: #7A3C00;">極</span><span style="color: #3E88B3;">右</span>?][? if far_right_paramilitary_high: 優勢を占めている： <span style="color: #7A3C00;">極</span><span style="color: #3E88B3;">右</span>?][? if far_right_paramilitary_med: 支配されている： <span style="color: #7A3C00;">極</span><span style="color: #3E88B3;">右</span>?][? if far_right_paramilitary_low: わずかに支配されている： <span style="color: #7A3C00;">極</span><span style="color: #3E88B3;">右</span>?][? if sa_paramilitary:、特に暴力的な <span style="color: #7A3C00;">**SA**</span>?]?][? if rfb_force >= far_right_force and far_right_paramilitary: 支配されている： <span style="color: #700000;">**RFB**</span>?][? if democracy_paramilitary and rfb_force < democracy_force:[? if democracy_paramilitary_highest: 完全に支配されている： <span style="color: #000000;">共</span><span style="color: #DD0000;">和</span><span style="color: #FFCC00;">派</span>?][? if democracy_paramilitary_high: 優勢を占めている： <span style="color: #000000;">共</span><span style="color: #DD0000;">和</span><span style="color: #FFCC00;">派</span>?][? if democracy_paramilitary_med: 支配されている： <span style="color: #000000;">共</span><span style="color: #DD0000;">和</span><span style="color: #FFCC00;">派</span>?][? if democracy_paramilitary_low: わずかに支配されている： <span style="color: #000000;">共</span><span style="color: #DD0000;">和</span><span style="color: #FFCC00;">派</span>?]?][? if rfb_force >= democracy_force and democracy_paramilitary: 支配されている： <span style="color: #700000;">**RFB**</span>?][? if state_paramilitary:[? if state_paramilitary_highest: 完全に支配されている： <span style="color: #BFC8CC;">**国家権力**</span>?][? if state_paramilitary_high: 優勢を占めている： <span style="color: #BFC8CC;">**国家権力**</span>?][? if state_paramilitary_med: 支配されている： <span style="color: #BFC8CC;">**国家権力**</span>?][? if state_paramilitary_low: わずかに支配されている： <span style="color: #BFC8CC;">**国家権力**</span>?]?].?]


